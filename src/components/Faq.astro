---
/**
 * FAQ als <details>, ohne JavaScript, mit Haarlinien statt Box. Die passende FAQPage-JSON-LD baut die Seite selbst
 * über faqJsonLd() aus src/data/faq.ts.
 */
export interface FaqItem { q: string; a: string }
interface Props { items: FaqItem[]; id?: string; title?: string }
const { items, id = 'faq', title = 'Häufige Fragen' } = Astro.props;
---
<section id={id} aria-labelledby={`${id}-h`} class="scroll-mt-20">
  <h2 id={`${id}-h`} class="h2">{title}</h2>
  <div class="mt-6 border-t border-line">
    {items.map((item) => (
      <details class="group border-b border-line">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[1.0625rem] leading-snug font-medium text-ink sm:text-lg [&::-webkit-details-marker]:hidden" style="font-stretch:108%">
          {item.q}
          <svg class="h-[18px] w-[18px] shrink-0 text-ink transition-transform duration-300 group-open:rotate-45" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 2v14M2 9h14" stroke="currentColor" stroke-width="1.5"/></svg>
        </summary>
        <div class="prose-site -mt-1 pb-5 text-[1rem]" set:html={item.a} />
      </details>
    ))}
  </div>
</section>

---
/**
 * Ziel der Weiterleitung von api/ernaehrungsplan.js. noindex, nicht in der Sitemap (Filter „/danke/“ in astro.config.mjs).
 * Zeigt bewusst keinen Link auf den Plan: Der Link kommt nach der Bestätigung per Mail (Kopplung an den Newsletter,
 * docs/ERNAEHRUNGSPLAN.md). Fehlerfälle über ?fehler=eingabe|technik.
 */
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
---
<Base title="Fast geschafft: Bestätige deine Adresse" description="Dein Ernährungsplan kommt per Mail, sobald du die Anmeldung bestätigt hast." path="/ernaehrungsplan/danke/" noindex>
  <section class="container-narrow py-16 sm:py-24">
    <div data-ok>
      <p class="eyebrow">Fast geschafft</p>
      <h1 class="h1 mt-3">Bestätige deine Adresse, dann kommt dein Plan.</h1>
      <p class="mt-6 max-w-xl text-lg text-ink-2">Wir haben dir gerade eine Mail geschickt. Sie heißt „Confirmation email“ und ist noch auf Englisch: Klick darin auf <strong class="font-semibold text-ink">„Confirm your email“</strong>. Danach kommt eine zweite Mail mit dem Link zu deinem Plan und dem PDF, meist nach wenigen Minuten, bei Gmail manchmal nach bis zu zehn.</p>
      <ol class="mt-10 max-w-xl border-t border-ink text-ink-2">
        <li class="flex gap-4 border-b border-line py-4"><span class="w-6 shrink-0 font-medium text-ink-3" style="font-stretch:125%">1</span><span>Bestätigungs-Mail öffnen und auf „Confirm your email“ klicken.</span></li>
        <li class="flex gap-4 border-b border-line py-4"><span class="w-6 shrink-0 font-medium text-ink-3" style="font-stretch:125%">2</span><span>Mail „Dein Ernährungsplan für 14 Tage“ abwarten. Darin: der Link zu deiner Planseite und das PDF.</span></li>
        <li class="flex gap-4 border-b border-line py-4"><span class="w-6 shrink-0 font-medium text-ink-3" style="font-stretch:125%">3</span><span>Planseite als Lesezeichen speichern. Dort wechselst du später Ernährungsform, Appetit oder Gewicht und änderst deine Vorlieben, ohne neue Mail.</span></li>
      </ol>
      <div class="mt-10 max-w-xl rounded-xl2 bg-paper-2 p-6 text-sm text-ink-2">
        <p class="font-semibold text-ink">Keine Mail da?</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>Schau im Spam- oder Werbeordner nach. Absender ist Dominik Jäkel von Nach der Spritze.</li>
          <li>Warst du schon für den Newsletter angemeldet, kommt keine Bestätigung, sondern direkt der Plan. Hast du schon einmal einen Plan angefordert, kommt kein zweiter automatisch; nimm dann einfach deine bisherige Planseite und stell dort die neue Variante ein.</li>
          <li>Nach einer halben Stunde immer noch nichts: Schreib an <a href={`mailto:${site.owner.email}`} class="text-moss underline underline-offset-4">{site.owner.email}</a>, dann schicke ich dir den Plan persönlich.</li>
        </ul>
      </div>
    </div>
    <div data-fehler="eingabe" hidden>
      <p class="eyebrow">Da fehlt etwas</p>
      <h1 class="h1 mt-3">Das hat nicht geklappt.</h1>
      <p class="mt-6 max-w-xl text-lg text-ink-2">Bitte prüfe deine E-Mail-Adresse und setze beide Häkchen. Dann noch einmal absenden.</p>
      <p class="mt-8"><a href="/ernaehrungsplan/" class="btn-primary">Zurück zum Ernährungsplan</a></p>
    </div>
    <div data-fehler="technik" hidden>
      <p class="eyebrow">Technischer Fehler</p>
      <h1 class="h1 mt-3">Das hat leider nicht geklappt.</h1>
      <p class="mt-6 max-w-xl text-lg text-ink-2">Bei uns ist etwas schiefgegangen, nicht bei dir. Versuch es später noch einmal oder schreib an <a href={`mailto:${site.owner.email}`} class="text-moss underline underline-offset-4">{site.owner.email}</a>, dann schicke ich dir den Plan persönlich.</p>
      <p class="mt-8"><a href="/ernaehrungsplan/" class="btn-primary">Zurück zum Ernährungsplan</a></p>
    </div>
    <div class="mt-14 max-w-xl text-ink-2">
      <p class="font-semibold text-ink">Bis dahin</p>
      <ul class="mt-3 border-t border-line">
        <li class="border-b border-line py-3"><a href="/wissen/ernaehrung-nach-abnehmspritze/" class="text-moss underline underline-offset-4">Die fünf Regeln für die Ernährung nach der Spritze</a></li>
        <li class="border-b border-line py-3"><a href="/werkzeuge/proteinrechner/" class="text-moss underline underline-offset-4">Dein genaues Proteinziel</a></li>
        <li class="border-b border-line py-3"><a href="/checkliste/" class="text-moss underline underline-offset-4">Die Checkliste für die ersten 8 Wochen</a></li>
      </ul>
    </div>
    <p class="mt-10 max-w-xl text-sm font-medium text-ink">{site.doctorSentence}</p>
  </section>
  <script is:inline>
    (() => {
      const f = new URLSearchParams(location.search).get('fehler');
      const box = f && document.querySelector(`[data-fehler="${f === 'technik' ? 'technik' : 'eingabe'}"]`);
      if (!box) return;
      document.querySelector('[data-ok]').hidden = true;
      box.hidden = false;
    })();
  </script>
</Base>

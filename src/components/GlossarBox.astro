---
/**
 * „Begriffe in diesem Artikel“: erkennt Glossar-Begriffe automatisch im Artikeltext und verlinkt sie.
 * Interne Verlinkung ohne Handarbeit; neue Glossar-Einträge erscheinen sofort in allen passenden Artikeln.
 * Design „Kalk“: Haarlinien statt Box.
 */
import { getCollection } from 'astro:content';
import { findTerms, byTerm } from '../lib/glossar';
interface Props { text: string; exclude?: string; limit?: number; class?: string }
const { text, exclude, limit = 6, class: cls = '' } = Astro.props;
const all = await getCollection('glossar', (g) => !g.data.draft);
const hits = findTerms(text, all, exclude).sort(byTerm).slice(0, limit);
---
{hits.length > 0 && (
  <aside class={`gb ${cls}`} aria-labelledby="glossar-box-h">
    <p id="glossar-box-h" class="gb-t">Begriffe in diesem Artikel</p>
    <dl class="gb-liste">
      {hits.map((g) => (
        <div class="gb-e">
          <dt><a href={`/glossar/${g.id}/`}>{g.data.term}</a></dt>
          <dd>{g.data.short}</dd>
        </div>
      ))}
    </dl>
    <p class="gb-alle"><a href="/glossar/">Alle Begriffe im Glossar</a></p>
  </aside>
)}

<style>
  .gb {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-ink);
  }
  .gb-t {
    font-size: 1.125rem;
    line-height: 1.3;
    font-weight: 540;
    font-stretch: 112%;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .gb-liste {
    display: grid;
    gap: 0 1.75rem;
    margin-top: 0.75rem;
  }
  @media (min-width: 640px) {
    .gb-liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .gb-e {
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-line);
  }
  .gb-e dt a {
    font-weight: 540;
    color: var(--color-ink);
    text-decoration: none;
  }
  .gb-e dt a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .gb-e dd {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink-2);
  }
  .gb-alle {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
  }
  .gb-alle a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 4px;
  }
  .gb-alle a:hover {
    text-decoration-color: var(--color-ink);
  }
</style>

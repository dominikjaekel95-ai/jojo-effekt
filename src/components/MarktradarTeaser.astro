---
/**
 * Startseiten-Abschnitt „Marktradar“: die drei wichtigsten Einträge, nur der `teaser`-Text (ohne Markennamen).
 * Keine Affiliate-Links, keine Produktnennung: reine Orientierung, Link auf die Radar-Seite.
 */
import { radarTeaser, radarTypeLabel, radarLastmod } from '../data/markt';
const items = radarTeaser(3);
const stand = new Date(radarLastmod()).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
const fmt = (d: string) => new Date(d).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<section class="mr" aria-labelledby="radar-teaser-h">
  <div class="container-wide">
    <div class="mr-head">
      <h2 id="radar-teaser-h" class="mr-h">Marktradar</h2>
      <p class="mr-stand">Stand {stand}. Zulassungen, Preise, Kassenregeln, Lieferbarkeit.</p>
    </div>
    <ul class="mr-list">
      {items.map((e) => (
        <li>
          <p class="mr-meta num">{radarTypeLabel[e.type]} · {fmt(e.date)}</p>
          <p class="mr-t"><a href={`/marktradar/#${e.id}`}>{e.teaser}</a></p>
        </li>
      ))}
    </ul>
    <p class="mr-more"><a href="/marktradar/">Alle Entwicklungen im Marktradar</a></p>
  </div>
</section>

<style>
  .mr {
    padding: clamp(4rem, 9vh, 6.5rem) 0;
  }
  .mr-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
  .mr-h {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.1;
  }
  .mr-stand {
    font-size: 0.9375rem;
    color: var(--color-ink-3);
  }
  .mr-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-line);
  }
  .mr-list li {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .mr-meta {
    font-size: 0.875rem;
    color: var(--color-ink-3);
  }
  .mr-t {
    margin-top: 0.35rem;
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--color-ink);
  }
  .mr-t a {
    color: inherit;
    text-decoration: none;
  }
  .mr-t a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .mr-more {
    margin-top: 1.5rem;
    font-size: 0.9375rem;
  }
  .mr-more a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 4px;
  }
  @media (min-width: 900px) {
    .mr-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0 3rem;
      border-top: 0;
    }
    .mr-list li {
      border-top: 1px solid var(--color-line);
      border-bottom: 0;
    }
  }
</style>

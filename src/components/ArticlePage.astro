---
/**
 * Artikelseite unter /wissen/<slug>/. Gerendert aus src/pages/wissen/[slug].astro. Verlinkung nach oben (Brotkrumen
 * zum Thema), zur Seite (related, „Mehr zum Thema“) und nach unten (Glossar-Box) ist hier fest eingebaut.
 * Design „Kalk“, ruhige Fassung (PR #45, B10): eine mittige Lesespalte von 42rem (etwa 72 Zeichen), Fließtext 18 px,
 * sechs Schriftgrößen (Tokens --fs-1 bis --fs-6 in global.css), drei Textfarben (ink, ink-2, ink-3), Abstände im
 * 8-px-Raster: Absatz 16, vor H2 64, nach H2 16, um Bausteine (Grafik, Modul, „Kurz gesagt“) 64. Weißraum statt
 * Trennlinien; Linien nur in Tabellen, FAQ und Inhaltsverzeichnis. Das Inhaltsverzeichnis ist überall aufklappbar
 * („Inhalt · n Abschnitte“, zu) unter dem Lesekopf. Interaktive Elemente (Platzhalter <div data-interaktiv="…"> im
 * Markdown) ersetzt src/lib/interaktiv beim Rendern.
 */
import type { CollectionEntry } from 'astro:content';
import { faqJsonLd } from '../data/faq';
import Base from '../layouts/Base.astro';
import Faq from './Faq.astro';
import Footnotes from './Footnotes.astro';
import AuthorBox from './AuthorBox.astro';
import ProductTeaser from './ProductTeaser.astro';
import AffiliateLinks from './AffiliateLinks.astro';
import GrafikEinbinden from './GrafikEinbinden.astro';
import GlossarBox from './GlossarBox.astro';
import ChecklistBox from './ChecklistBox.astro';
import type { AffiliateKey } from '../data/affiliate';
import { getCollection, render } from 'astro:content';
import { site } from '../data/site';
import { themaByCategory, gehoertZu } from '../data/themen';
import { mitGrafikDaten } from '../lib/grafik-daten';
import { mitInteraktiv } from '../lib/interaktiv';
import Interaktiv from './interaktiv/Interaktiv.astro';

interface Props { entry: CollectionEntry<'wissen'> }
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
/* Datentabelle unter jeder Grafik (GEO): das gerenderte HTML wird ergänzt, sonst bleibt <Content /> der Weg */
const html = entry.rendered?.html ? mitInteraktiv(mitGrafikDaten(entry.rendered.html), entry.data.sources, entry.id) : undefined;
/* Inhaltsverzeichnis aus den H2: aufklappbar unter dem Lesekopf, standardmäßig zu (das Feld toc im Frontmatter wirkt nicht mehr) */
const inhalt = headings.filter((h) => h.depth === 2);
const all = await getCollection('wissen', (a) => !a.data.draft);
const related = entry.data.related
  .map((id) => all.find((a) => a.id === id))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));
const thema = themaByCategory(entry.data.category);
if (!thema) throw new Error(`Artikel ${entry.id}: category "${entry.data.category}" gehört zu keinem Thema in src/data/themen.json`);
const mehr = all
  .filter((a) => a.id !== entry.id && gehoertZu(thema, a.id, a.data.category) && !related.some((r) => r.id === a.id))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const path = `/wissen/${entry.id}/`;
const url = `${site.url}${path}`;
const faqText = entry.data.faq.map((f) => `${f.q} ${f.a.replace(/<[^>]+>/g, ' ')}`).join(' ');
const words = `${entry.body ?? ''} ${faqText}`.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 180));
/* GEO-Plan 2.6: Aktualisierungsdatum oben sichtbar, identisch mit dateModified im Schema */
const fmtDatum = (d: Date) => d.toLocaleDateString('de-DE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Berlin' });
const stand = entry.data.updatedDate ?? entry.data.pubDate;

/* Vorschaubild als ImageObject mit Lizenz und Bildunterschrift: So erkennt Google die Grafik als lizenzierbares Bild
 * (Bildersuche, AI Overviews); Titel, Alt-Text und Untertitel kommen aus dem Register src/data/grafiken.ts. */
import { grafiken } from '../data/grafiken';
const grafik = entry.data.image ? grafiken.find((g) => `/grafiken/${g.id}.png` === entry.data.image) : undefined;
const imageObject = entry.data.image
  ? {
      '@type': 'ImageObject',
      '@id': `${site.url}${entry.data.image}#image`,
      url: `${site.url}${entry.data.image}`,
      contentUrl: `${site.url}${entry.data.image}`,
      ...(grafik
        ? {
            name: grafik.title,
            caption: grafik.alt,
            description: grafik.subtitle,
            width: 1800,
            height: 1013,
            encodingFormat: 'image/png',
            license: 'https://creativecommons.org/licenses/by/4.0/deed.de',
            acquireLicensePage: `${site.url}/grafiken/#nutzung`,
            creditText: 'nachderspritze.de',
            copyrightNotice: `${site.name}, CC BY 4.0`,
            creator: { '@id': `${site.url}/#organization` },
          }
        : {}),
    }
  : undefined;

const jsonLd = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: entry.data.title,
    description: entry.data.description,
    inLanguage: 'de-DE',
    url,
    mainEntityOfPage: url,
    datePublished: entry.data.pubDate.toISOString(),
    dateModified: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
    author: { '@type': 'Person', name: site.owner.name, url: `${site.url}/ueber/` },
    ...(site.reviewer ? { reviewedBy: { '@type': 'Person', name: site.reviewer.name, jobTitle: site.reviewer.title } } : {}),
    publisher: { '@id': `${site.url}/#organization` },
    isPartOf: { '@id': `${site.url}/wissen/${thema.slug}/#collection` },
    keywords: entry.data.keywords.join(', '),
    ...(imageObject ? { image: imageObject } : {}),
    wordCount: words,
    about: { '@type': 'Thing', name: 'GLP-1-Rezeptoragonisten absetzen' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Wissen', item: `${site.url}/wissen/` },
      { '@type': 'ListItem', position: 3, name: thema.name, item: `${site.url}/wissen/${thema.slug}/` },
      { '@type': 'ListItem', position: 4, name: entry.data.title, item: url },
    ],
  },
  // FAQPage-Schema aus den Artikel-FAQ: KI-Suchen lesen Frage und Antwort strukturiert; HTML wird zu Text reduziert
  ...(entry.data.faq.length > 0 ? [faqJsonLd(entry.data.faq)] : []),
];
---
<Base
  title={entry.data.metaTitle ?? entry.data.title} description={entry.data.description} path={path} ogType="article"
  ogImage={entry.data.image}
  jsonLd={jsonLd} publishedTime={entry.data.pubDate.toISOString()} modifiedTime={(entry.data.updatedDate ?? entry.data.pubDate).toISOString()}
>
  <Interaktiv />
  <article class="art container-wide">
    <header class="art-kopf">
      <nav aria-label="Brotkrumen" class="art-pfad">
        <a href="/wissen/">Wissen</a><span aria-hidden="true">/</span><a href={`/wissen/${thema.slug}/`}>{thema.name}</a>
      </nav>
      <h1 class="art-h1">{entry.data.title}</h1>
      <p class="art-lead">{entry.data.description}</p>
      <p class="art-meta">
        <span>{site.owner.name}</span><span aria-hidden="true" class="art-sep">·</span><span>{readingMinutes} Min. Lesezeit</span><span aria-hidden="true" class="art-sep">·</span><span>Aktualisiert am <time datetime={stand.toISOString().slice(0, 10)}>{fmtDatum(stand)}</time></span>
      </p>
      <p class="art-arzt">{site.doctorSentence}</p>
    </header>

    <div class="art-text">
      {inhalt.length >= 3 && (
        <details class="art-toc">
          <summary><span>Inhalt</span><span class="art-toc-n">{inhalt.length} Abschnitte</span></summary>
          <nav aria-label="Inhalt">
            <ol>
              {inhalt.map((h) => (<li><a href={`#${h.slug}`}>{h.text}</a></li>))}
            </ol>
          </nav>
        </details>
      )}

      <div class="prose-site art-prose">
        {html !== undefined ? <Fragment set:html={html} /> : <Content />}
        <GrafikEinbinden />
      </div>

      <GlossarBox text={`${entry.body ?? ''} ${faqText}`} class="art-block" />

      <ChecklistBox position={`artikel-${entry.id}`} class="art-block" />

      <ProductTeaser position={`artikel-${entry.id}`} />

      {entry.data.affiliate.length > 0 && (
        <AffiliateLinks
          class="my-10"
          products={entry.data.affiliate as AffiliateKey[]}
          title={entry.data.affiliateTitle ?? 'Beispiele für Produkte'}
          intro={entry.data.affiliateIntro ?? 'Beispiele, keine Empfehlung einer Marke.'}
          position={`artikel-${entry.id}`}
        />
      )}

      {entry.data.faq.length > 0 && <div class="art-faq"><Faq items={entry.data.faq} id="artikel-faq" title="Häufige Fragen" /></div>}

      <AuthorBox pubDate={entry.data.pubDate} updatedDate={entry.data.updatedDate} />

      <Footnotes ids={entry.data.sources} />

      {related.length > 0 && (
        <section class="art-weiter" aria-labelledby="related-h">
          <h2 id="related-h" class="art-h2">Weiterlesen</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={`/wissen/${r.id}/`}>
                  <span class="art-weiter-k">{r.data.category}</span>
                  <span class="art-weiter-t">{r.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="art-thema" aria-labelledby="thema-h">
        <h2 id="thema-h" class="art-h2">Mehr zum Thema {thema.name}</h2>
        {mehr.length > 0 && (
          <ul>
            {mehr.map((m) => (<li><a href={`/wissen/${m.id}/`}>{m.data.title}</a></li>))}
          </ul>
        )}
        <p><a href={`/wissen/${thema.slug}/`} class="art-thema-l">Themenseite: {thema.title}</a></p>
      </section>
    </div>
  </article>
</Base>

<style>
  /* Eine mittige Lesespalte, 42rem; alle Abstände aus dem 8-px-Raster */
  .art {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }
  .art > * {
    max-width: 42rem;
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .art {
      padding-top: 4rem;
    }
  }

  /* Lesekopf */
  .art-pfad {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--fs-1);
    color: var(--color-ink-3);
  }
  .art-pfad a {
    color: inherit;
    text-decoration: none;
  }
  .art-pfad a:hover {
    color: var(--color-ink);
  }
  .art-h1 {
    margin-top: 1rem;
    font-size: var(--fs-6);
    line-height: 1.06;
    font-stretch: 118%;
    font-weight: 520;
    letter-spacing: -0.022em;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .art-lead {
    margin-top: 1.5rem;
    font-size: var(--fs-4);
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .art-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5rem;
    margin-top: 1.5rem;
    font-size: var(--fs-1);
    line-height: 1.5;
    color: var(--color-ink-3);
  }
  .art-meta span:first-child {
    color: var(--color-ink-2);
  }
  .art-arzt {
    margin-top: 0.5rem;
    font-size: var(--fs-1);
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  /* Inhaltsverzeichnis: aufklappbar unter dem Lesekopf, standardmäßig zu */
  .art-toc {
    margin-top: 2rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }
  .art-toc summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 48px;
    cursor: pointer;
    list-style: none;
    font-size: var(--fs-2);
    font-weight: 540;
    font-stretch: 110%;
    color: var(--color-ink);
  }
  .art-toc summary::-webkit-details-marker {
    display: none;
  }
  .art-toc-n {
    font-size: var(--fs-1);
    font-weight: 450;
    font-stretch: 100%;
    color: var(--color-ink-3);
  }
  .art-toc-n::after {
    content: '+';
    display: inline-block;
    margin-left: 0.5rem;
    transition: transform 0.25s var(--ease);
  }
  .art-toc[open] .art-toc-n::after {
    transform: rotate(45deg);
  }
  .art-toc ol {
    padding: 0 0 1rem;
    counter-reset: t;
  }
  .art-toc li {
    counter-increment: t;
  }
  .art-toc a {
    display: flex;
    gap: 0.75rem;
    padding: 0.25rem 0;
    font-size: var(--fs-2);
    line-height: 1.5;
    color: var(--color-ink-2);
    text-decoration: none;
  }
  .art-toc a:hover {
    color: var(--color-ink);
  }
  .art-toc a::before {
    content: counter(t);
    min-width: 1.25rem;
    color: var(--color-ink-3);
  }

  /* Fließtext: 18 px, Zeilenhöhe 1,65; Absatz 16, vor H2 64, nach H2 16 */
  .art-prose {
    margin-top: 3rem;
    font-size: var(--fs-3);
    line-height: 1.65;
  }
  .art-prose > :global(:first-child) {
    margin-top: 0;
  }
  .art-prose :global(h2) {
    margin-top: 4rem;
    margin-bottom: 1rem;
    font-size: var(--fs-5);
    line-height: 1.15;
  }
  .art-prose :global(h3) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: var(--fs-4);
    line-height: 1.25;
  }
  .art-prose :global(h2 + h3) {
    margin-top: 1.5rem;
  }
  .art-prose :global(:is(p, ul, ol)) {
    margin-block: 1rem;
  }
  .art-prose :global(li + li) {
    margin-top: 0.5rem;
  }
  /* Links in Tinte, Unterstrich grün: drei Textfarben im Artikel */
  .art-prose :global(a) {
    color: var(--color-ink);
    text-decoration-color: color-mix(in srgb, var(--color-moss) 55%, transparent);
    text-decoration-thickness: 1px;
  }
  .art-prose :global(a:hover) {
    text-decoration-color: var(--color-ink);
  }
  .art-prose :global(sup a) {
    color: var(--color-ink-3);
    text-decoration: none;
  }
  /* Tabellen: Linien bleiben, Schrift 16 */
  .art-prose > :global(table) {
    margin-block: 2rem;
    font-size: var(--fs-2);
  }
  .art-prose :global(hr) {
    margin-block: 4rem;
    border: 0;
  }
  /* Bausteine: Grafik, Modul, „Kurz gesagt“; 64 davor und danach, keine Trennlinien */
  .art-prose :global(figure),
  .art-prose :global(.ia),
  .art-prose :global(blockquote) {
    margin-block: 4rem;
  }
  .art-prose :global(figure img) {
    display: block;
  }
  .art-prose :global(figure > figcaption) {
    margin-top: 1rem;
    font-size: var(--fs-1);
    line-height: 1.5;
    color: var(--color-ink-3);
  }
  .art-prose :global(figure > .grafik-daten) {
    margin-top: 0.5rem;
  }
  .art-prose :global(blockquote) {
    padding: 1.5rem;
    border: 0;
    border-radius: 16px;
    background: var(--color-paper-2);
    font-size: var(--fs-3);
    line-height: 1.6;
    font-stretch: 100%;
    color: var(--color-ink);
  }
  @media (min-width: 640px) {
    .art-prose :global(blockquote) {
      padding: 1.5rem 2rem;
    }
  }

  /* Nach dem Text: Bausteine mit Weißraum statt Linien, Abstand 64 */
  .art-text > :global(:not(.art-toc, .art-prose)) {
    margin-top: 4rem;
  }
  .art-text :global(:is(.art-h2, .pt-h, #quellen-h, [id^='aff-'])) {
    font-size: var(--fs-4);
    line-height: 1.25;
    font-weight: 530;
    font-stretch: 112%;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .art-text :global(.eyebrow) {
    font-size: var(--fs-1);
  }
  /* Hinweis auf das Programm: ohne Linien, Abstand wie alle Bausteine */
  .art-text :global(.pt) {
    padding: 0;
    border: 0;
  }
  .art-text :global(:is(.pt-t, .pt-l)) {
    font-size: var(--fs-2);
  }
  .art-faq :global(.h2) {
    font-size: var(--fs-5);
    line-height: 1.15;
  }
  .art-faq :global(summary) {
    font-size: var(--fs-3);
  }
  .art-faq :global(.prose-site) {
    font-size: var(--fs-2);
  }
  /* Quellen: ohne Linie, Links in Tinte */
  .art-text :global(#quellen) {
    border-top: 0;
    padding-top: 0;
  }
  .art-text :global(#quellen ol) {
    margin-top: 1rem;
  }
  .art-text :global(#quellen a) {
    color: var(--color-ink-2);
    text-decoration-color: var(--color-line);
  }
  /* Werbung (AffiliateLinks): Rahmen bleibt als Kennzeichnung, Schrift auf der Skala */
  .art-text :global([aria-labelledby^='aff-'] a) {
    font-size: var(--fs-2);
    color: var(--color-ink);
    text-decoration-color: color-mix(in srgb, var(--color-moss) 55%, transparent);
  }
  .art-text :global([aria-labelledby^='aff-'] .text-xs) {
    font-size: var(--fs-1);
  }

  .art-weiter ul {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 640px) {
    .art-weiter ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .art-weiter a {
    display: block;
    text-decoration: none;
  }
  .art-weiter-k {
    display: block;
    font-size: var(--fs-1);
    color: var(--color-ink-3);
  }
  .art-weiter-t {
    display: block;
    margin-top: 0.5rem;
    font-size: var(--fs-3);
    line-height: 1.35;
    font-weight: 520;
    font-stretch: 108%;
    color: var(--color-ink);
  }
  .art-weiter a:hover .art-weiter-t {
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 4px;
  }
  .art-thema ul {
    margin-top: 1rem;
  }
  .art-thema li a {
    display: block;
    padding: 0.5rem 0;
    font-size: var(--fs-2);
    line-height: 1.5;
    color: var(--color-ink-2);
    text-decoration: none;
  }
  .art-thema li a:hover {
    color: var(--color-ink);
  }
  .art-thema p {
    margin-top: 1rem;
  }
  .art-thema-l {
    font-size: var(--fs-2);
    font-weight: 540;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 4px;
  }
  .art-thema-l:hover {
    text-decoration-color: var(--color-ink);
  }
</style>

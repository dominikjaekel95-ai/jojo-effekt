---
/** Hinweis auf die Checkliste „Die ersten 8 Wochen nach der letzten Dosis“ in Artikeln. Kein Produkt, kein Claim. */
interface Props { position: string; class?: string }
const { position, class: cls = '' } = Astro.props;
---
<aside class={`border-t border-line pt-5 ${cls}`} aria-label="Checkliste">
  <p class="eyebrow">Checkliste, kostenlos</p>
  <p class="mt-1 text-lg leading-snug text-ink" style="font-stretch:112%;font-weight:520">Die ersten 8 Wochen nach der letzten Dosis</p>
  <p class="mt-1 text-sm text-ink-2">Woche für Woche, was in Studien den Unterschied macht: Messwerte, Protein, Training, Schlaf. Als Seite und als PDF.</p>
  <p class="mt-3"><a href="/checkliste/" class={`btn-secondary !min-h-10 !px-4 !py-2 text-sm plausible-event-name=Checkliste+Klick plausible-event-position=${position}`}>Zur Checkliste</a></p>
</aside>

---
/**
 * Studien-Tracker /wissen/studien/: eine Zeile pro Studie (src/data/studien.ts), Dataset-JSON-LD, CSV unter
 * /wissen/studien.csv. Gestaltung „Kalk“ seit 06.10.2026: Tabellen mit Haarlinien, mobil gestapelt, Hinweis auf das
 * Programm (ProductTeaser) statt „Zum 12-Wochen-Set“.
 */
import Base from '../../layouts/Base.astro';
import SeitenKopf from '../../components/SeitenKopf.astro';
import ProductTeaser from '../../components/ProductTeaser.astro';
import Footnotes from '../../components/Footnotes.astro';
import { studien, studienUpdated, studienLog } from '../../data/studien';
import { sources } from '../../data/sources';
import { site } from '../../data/site';

const gruppen = ['Absetzen', 'Mechanismus', 'Versorgung', 'Zulassung'] as const;
const beschreibung: Record<(typeof gruppen)[number], string> = {
  Absetzen: 'Was nach dem Ende der Therapie mit dem Gewicht passiert – die Studien mit Absetz-Phase.',
  Mechanismus: 'Warum das Gewicht zurückkommt und was dagegen wirkt: Muskeln, Hormone, Stoffwechsel, Training.',
  Versorgung: 'Wie viele Menschen tatsächlich absetzen.',
  Zulassung: 'Wie viel Gewicht unter der Therapie verloren wird – der Ausgangspunkt für alles danach.',
};
const fnIds = studien.map((s) => s.sourceId);
const fn = (id: string) => fnIds.indexOf(id) + 1;
const updated = new Date(studienUpdated).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });

const title = 'Studien zum Absetzen der Abnehmspritze: alle Ergebnisse in einer Tabelle';
const metaTitle = 'Studien zum Absetzen der Abnehmspritze: Tracker mit Kernzahlen';
const description =
  'Alle Studien zu Gewicht nach dem Absetzen von Semaglutid, Tirzepatid und Liraglutid: STEP 1 Extension, STEP 4, SURMOUNT-4, S-LiTE, Meta-Analysen. Kernzahl, Bedeutung, Link. Monatlich aktualisiert.';
const jsonLd = [
  {
    '@type': 'Dataset',
    name: 'Studien-Tracker: Gewicht nach dem Absetzen von GLP-1-Rezeptoragonisten',
    description,
    url: `${site.url}/wissen/studien/`,
    dateModified: studienUpdated,
    inLanguage: 'de-DE',
    creator: { '@id': `${site.url}/#organization` },
    license: 'https://creativecommons.org/licenses/by/4.0/',
    citation: studien.map((s) => sources[s.sourceId]?.full),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Wissen', item: `${site.url}/wissen/` },
      { '@type': 'ListItem', position: 3, name: 'Studien-Tracker', item: `${site.url}/wissen/studien/` },
    ],
  },
];
---
<Base title={metaTitle} description={description} path="/wissen/studien/" jsonLd={jsonLd} ogType="article" modifiedTime={studienUpdated} ogImage="/og-studien.png">
  <SeitenKopf crumbs={[{ href: '/', label: 'Start' }, { href: '/wissen/', label: 'Wissen' }, { label: 'Studien-Tracker' }]} meta={`Studien-Tracker, Stand ${updated}`} title={title} size="m">
    <p>{studien.length} Studien, je eine Kernzahl, je ein Link zum Original. Wir ergänzen die Tabelle, sobald neue Absetz-Daten erscheinen, und vermerken das Datum oben. Fehlt eine Studie? Schreib an <a href={`mailto:${site.owner.email}`}>{site.owner.email}</a>.</p>
  </SeitenKopf>

  <article class="container-wide k-end">
    <p class="st-press" data-rv>
      <strong>Für Presse und Fachpublikum:</strong> Die Tabelle ist frei nutzbar mit Quellenangabe (CC BY 4.0). <a href="/wissen/studien.csv" class="k-a" download>Als CSV herunterladen</a> · <a href="#neu" class="k-a">Was neu ist</a>
    </p>

    <nav class="k-jump st-jump" aria-label="Gruppen">
      {gruppen.map((g) => (
        <a href={`#${g.toLowerCase()}`}>{g} <span class="n">{studien.filter((s) => s.gruppe === g).length}</span></a>
      ))}
    </nav>

    {gruppen.map((g) => (
      <section id={g.toLowerCase()} class="k-sec scroll-mt-24" aria-labelledby={`h-${g}`}>
        <div class="st-head" data-rv>
          <h2 id={`h-${g}`} class="k-h2">{g}</h2>
          <p class="k-intro">{beschreibung[g]}</p>
        </div>
        <div class="mt-8" data-rv>
          <table class="k-table k-stack st-table">
            <thead>
              <tr>
                <th scope="col">Studie</th>
                <th scope="col">Wirkstoff</th>
                <th scope="col">Design · n</th>
                <th scope="col">Kernzahl</th>
                <th scope="col">Was das heißt</th>
              </tr>
            </thead>
            <tbody>
              {studien.filter((s) => s.gruppe === g).map((s) => (
                <tr>
                  <th scope="row">
                    <span class="st-name">{s.name}</span>
                    <span class="k-sub">{s.jahr} · <a href={`#fn-${s.sourceId}`} class="st-fn">[{fn(s.sourceId)}]</a>
                      {sources[s.sourceId]?.url && (<> · <a href={sources[s.sourceId].url} rel="noopener nofollow" target="_blank" class="st-fn">Original</a></>)}
                    </span>
                  </th>
                  <td data-label="Wirkstoff">{s.wirkstoff}</td>
                  <td data-label="Design · n">{s.design}<span class="k-sub">n = {s.n}</span></td>
                  <td data-label="Kernzahl" class="st-kz">{s.kernzahl}</td>
                  <td data-label="Was das heißt">{s.bedeutung}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    <div class="st-narrow">
      <section id="neu" class="k-sec scroll-mt-24" aria-labelledby="neu-h">
        <h2 id="neu-h" class="k-h2" data-rv>Was neu ist</h2>
        <ul class="st-log">
          {studienLog.map((e, i) => (
            <li data-rv style={`--i:${i}`}>
              <time datetime={e.date}>{new Date(e.date).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric' })}</time>
              <span>{e.text}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="k-sec" aria-labelledby="offen-h">
        <h2 id="offen-h" class="k-h2" data-rv>Was die Studien noch nicht beantworten</h2>
        <ul class="st-open">
          <li data-rv><strong>Ausschleichen.</strong> Ob ein schrittweises Reduzieren der Dosis den Wiederanstieg abmildert, ist nicht durch randomisierte Studien belegt. Die Zulassungsstudien haben abrupt abgesetzt.</li>
          <li data-rv style="--i:1"><strong>Protein und Kreatin speziell nach GLP-1.</strong> Die Evidenz für Protein und Krafttraining stammt aus Studien zu Kalorienreduktion allgemein, nicht aus GLP-1-Kohorten. Für Kreatin nach GLP-1-Therapie gibt es keine eigenen Daten.</li>
          <li data-rv style="--i:2"><strong>Langzeitverlauf über 1 Jahr hinaus.</strong> Die Nachbeobachtungen enden meist nach 52 Wochen.</li>
          <li data-rv style="--i:3"><strong>Wer hält, wer nicht.</strong> Prädiktoren für erfolgreichen Gewichtserhalt nach dem Absetzen sind kaum untersucht; die Streuung in den Studien ist groß.</li>
        </ul>
      </section>

      <section class="k-sec st-use" aria-labelledby="nutzung-h" data-rv>
        <h2 id="nutzung-h" class="k-h3">Nutzung und Zitat</h2>
        <p>
          Die Tabelle darf mit Quellenangabe frei verwendet werden (CC BY 4.0). Zitiervorschlag: Nach der Spritze, Studien-Tracker
          „Gewicht nach dem Absetzen der Abnehmspritze“, Stand {updated}, {site.url}/wissen/studien/. Die Kernzahlen sind aus den
          Originalarbeiten übernommen; bei Abweichungen gilt das Original.
        </p>
      </section>

      <div class="st-cta">
        <a href="/wissen/jojo-effekt-abnehmspritze/" class="k-a">Was die Zahlen für dich bedeuten: Jojo-Effekt nach der Abnehmspritze</a>
      </div>

      <ProductTeaser position="studien" />

      <Footnotes ids={fnIds} />
    </div>
  </article>
</Base>

<style>
  .st-press {
    max-width: 48em;
    margin-top: clamp(2rem, 5vh, 3rem);
    color: var(--color-ink-2);
    font-size: 0.975rem;
  }
  .st-press strong {
    color: var(--color-ink);
    font-weight: 560;
  }
  .st-head {
    display: grid;
    gap: 0.5rem 3rem;
  }
  .st-head .k-intro {
    margin-top: 0;
  }
  @media (min-width: 900px) {
    .st-head {
      grid-template-columns: minmax(0, 0.5fr) minmax(0, 1fr);
      align-items: end;
    }
  }
  .st-name {
    font-stretch: 112%;
    font-weight: 540;
  }
  .st-fn {
    color: var(--color-moss);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-moss) 40%, transparent);
    text-underline-offset: 3px;
  }
  .st-kz {
    color: var(--color-ink) !important;
    font-weight: 520;
  }
  @media (min-width: 700px) {
    .st-table th:first-child {
      width: 16%;
    }
    .st-table td:nth-child(2) {
      width: 13%;
    }
    .st-table td:nth-child(3) {
      width: 17%;
    }
    .st-table td:nth-child(4) {
      width: 22%;
    }
  }
  /* Tablet: sechs Spalten passen nicht, deshalb wie auf dem Handy gestapelt (Regeln wie .k-stack in seiten.css) */
  @media (min-width: 700px) and (max-width: 1023px) {
    .st-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .st-table,
    .st-table tbody,
    .st-table tr,
    .st-table td,
    .st-table tbody th {
      display: block;
      width: 100% !important;
    }
    .st-table tr {
      padding: 1rem 0;
      border-bottom: 1px solid var(--color-line);
    }
    .st-table tbody tr:first-child {
      border-top: 1px solid var(--color-ink);
    }
    .st-table td,
    .st-table tbody th {
      padding: 0.2rem 0;
      border: 0;
    }
    .st-table td[data-label]::before {
      content: attr(data-label);
      display: block;
      font-size: 0.8125rem;
      color: var(--color-ink-3);
    }
  }
  .st-narrow {
    max-width: 45rem;
  }
  .st-log {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-ink);
  }
  .st-log li {
    display: grid;
    gap: 0.25rem 1.5rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.975rem;
    color: var(--color-ink-2);
  }
  .st-log time {
    font-weight: 540;
    color: var(--color-ink);
  }
  @media (min-width: 640px) {
    .st-log li {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }
  .st-open {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-ink);
  }
  .st-open li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink-2);
    line-height: 1.6;
  }
  .st-open strong {
    display: block;
    margin-bottom: 0.25rem;
    font-stretch: 112%;
    font-weight: 540;
    color: var(--color-ink);
  }
  .st-use {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-ink);
    color: var(--color-ink-2);
    font-size: 0.975rem;
  }
  .st-use p {
    margin-top: 0.6rem;
    overflow-wrap: anywhere;
  }
  .st-cta {
    margin-top: 2.5rem;
  }
</style>

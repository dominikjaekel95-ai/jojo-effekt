---
/** Hinweis auf die Checkliste „Die ersten 8 Wochen nach der letzten Dosis“ in Artikeln. Kein Produkt, kein Claim. */
interface Props { position: string; class?: string }
const { position, class: cls = '' } = Astro.props;
---
<aside class={`rounded-xl2 border border-amber/50 bg-amber-light/40 p-5 ${cls}`} aria-label="Checkliste">
  <p class="eyebrow text-amber-dark">Checkliste</p>
  <p class="mt-2 text-lg font-bold leading-snug text-ink">Die ersten 8 Wochen nach der letzten Dosis</p>
  <p class="mt-1 text-sm text-ink-2">Woche für Woche, was in Studien den Unterschied macht: Messwerte, Protein, Training, Schlaf. Als Seite und als PDF.</p>
  <p class="mt-3"><a href="/checkliste/" class={`inline-block rounded-lg bg-ink px-4 py-2 text-sm font-semibold text-white no-underline hover:bg-moss plausible-event-name=Checkliste+Klick plausible-event-position=${position}`}>Zur Checkliste</a></p>
</aside>

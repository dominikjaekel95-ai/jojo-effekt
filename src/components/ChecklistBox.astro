---
/** Hinweis auf die Checkliste „Die ersten 8 Wochen nach der letzten Dosis“ in Artikeln. Kein Produkt, kein Claim. */
interface Props { position: string; class?: string }
const { position, class: cls = '' } = Astro.props;
---
<aside class={`cb ${cls}`} aria-label="Checkliste">
  <p class="cb-k">Checkliste, kostenlos</p>
  <p class="cb-t">Die ersten 8 Wochen nach der letzten Dosis</p>
  <p class="cb-d">Woche für Woche, was in Studien den Unterschied macht: Messwerte, Protein, Training, Schlaf. Als Seite und als PDF.</p>
  <p class="cb-a"><a href="/checkliste/" class={`btn-secondary !min-h-10 !px-4 !py-2 text-sm plausible-event-name=Checkliste+Klick plausible-event-position=${position}`}>Zur Checkliste</a></p>
</aside>

<style>
  /* Design „Kalk“, ruhige Fassung: ohne Linie, Schrift auf der Skala der Wissensseiten (--fs-*) */
  .cb-k {
    font-size: var(--fs-1);
    color: var(--color-ink-3);
  }
  .cb-t {
    margin-top: 0.5rem;
    font-size: var(--fs-4);
    line-height: 1.25;
    font-weight: 530;
    font-stretch: 112%;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .cb-d {
    margin-top: 0.5rem;
    font-size: var(--fs-2);
    line-height: 1.55;
    color: var(--color-ink-2);
  }
  .cb-a {
    margin-top: 1rem;
  }
</style>

---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import AffiliateLinks from '../components/AffiliateLinks.astro';
import ShareButtons from '../components/ShareButtons.astro';
---
<Base title="Danke – du stehst auf der Liste" description="Vorbestellung eingetragen. Kein Geld, keine Verpflichtung. Wir melden uns, sobald die erste Charge in Produktion geht." path="/danke/" noindex>
  <section class="container-narrow py-20 text-center">
    <p class="eyebrow">Danke</p>
    <h1 class="h1 mt-3">Du stehst auf der Liste.</h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-ink-2">
      Ehrlich gesagt: Es gibt das Set noch nicht. Wir produzieren die erste Charge, sobald {site.preorderGoal} Menschen sagen,
      dass sie es wollen. Du hast nichts bezahlt und bist zu nichts verpflichtet. Sobald es losgeht, bekommst du als Erste
      eine E-Mail mit Preis und Bestellmöglichkeit – und entscheidest dann.
    </p>
    <div class="mx-auto mt-8 max-w-xl rounded-xl2 border border-line bg-white p-6 text-left text-sm text-ink-2">
      <p class="font-semibold text-ink">Was jetzt passiert</p>
      <ol class="mt-2 list-decimal space-y-1 pl-5">
        <li>Wir melden uns per E-Mail, sobald die erste Charge steht – frühestens, wenn {site.preorderGoal} Vorbestellungen zusammen sind.</li>
        {site.newsletter.provider ? (
          <li>Neuigkeiten zum Set. Den Newsletter ({site.newsletter.cadence}) bekommst du nur, wenn du ihn im Formular angekreuzt hast; abmelden geht in jeder Mail. Keine Weitergabe.</li>
        ) : (
          <li>Nur Neuigkeiten zum Set. Kein Newsletter, keine Weitergabe.</li>
        )}
        <li>Du kannst dich jederzeit per E-Mail austragen lassen.</li>
      </ol>
    </div>
    <div class="mx-auto mt-8 max-w-xl rounded-xl2 border border-moss/30 bg-moss-light/40 p-6 text-left">
      <p class="eyebrow">Kennst du jemanden, der gerade absetzt?</p>
      <p class="mt-2 text-sm text-ink-2">Die erste Charge kommt, sobald {site.preorderGoal} Menschen sie wollen. Jede Empfehlung bringt sie näher. Der Text ist vorgeschrieben, du kannst ihn ändern.</p>
      <ShareButtons position="danke" class="mt-4" />
    </div>
    <p class="mt-8 text-ink-2">Bis dahin: <a href="/wissen/" class="font-semibold text-moss underline underline-offset-4">Was nach der Abnehmspritze passiert – mit Quellen</a> · <a href="/checkliste/" class="font-semibold text-moss underline underline-offset-4">Checkliste für die ersten 8 Wochen</a></p>
    <AffiliateLinks
      class="mx-auto mt-8 max-w-xl"
      products={['wheyNeutral', 'creatineNe', 'psyllium']}
      title="Bis das Set da ist: Die Bausteine gibt es einzeln"
      intro="Das Set gibt es noch nicht. Protein, Kreatin und Ballaststoffe gibt es aber heute schon – drei Beispiele, keine Empfehlung einer Marke."
      position="danke"
    />
    <p class="mt-6 text-sm font-medium text-ink">{site.doctorSentence}</p>
  </section>
</Base>

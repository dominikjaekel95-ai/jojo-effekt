---
/**
 * Themenseite (Hub) unter /wissen/<slug>/: Einordnung mit Quellen, „Welche Frage, welcher Artikel“, alle Artikel des
 * Themas, Glossar-Begriffe, Werkzeuge, weitere Themen. Gerendert aus src/pages/wissen/[slug].astro für jeden Eintrag in
 * src/data/themen.json. Zielt auf den Überbegriff; die Artikel decken die Long-Tail-Anfragen.
 * Gestaltung „Kalk“ seit 06.10.2026: Einstieg als dunkler Block, Fragen, Artikel, Begriffe und Werkzeuge als ruhige Zeilen,
 * Einblenden beim Scrollen; am Ende der Hinweis auf das 12-Wochen-Programm (ProductTeaser) statt des Sets.
 */
import Base from '../layouts/Base.astro';
import SeitenKopf from './SeitenKopf.astro';
import Pfeil from './Pfeil.astro';
import ProductTeaser from './ProductTeaser.astro';
import Footnotes from './Footnotes.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { themen, gehoertZu, type Thema } from '../data/themen';

interface Props { thema: Thema }
const { thema } = Astro.props;

const alle = (await getCollection('wissen', (a) => !a.data.draft)).sort((a, b) => a.data.order - b.data.order);
const artikel = alle.filter((a) => gehoertZu(thema, a.id, a.data.category));
if (artikel.length === 0) throw new Error(`Thema ${thema.slug}: kein Artikel mit category "${thema.category}"`);
const byId = new Map(alle.map((a) => [a.id, a] as const));
const einstieg = thema.einstieg ? byId.get(thema.einstieg) : undefined;
if (thema.einstieg && !einstieg) throw new Error(`Thema ${thema.slug}: Einstieg "${thema.einstieg}" ist kein veröffentlichter Artikel`);
const fragen = thema.fragen.map((f) => {
  if ('slug' in f) {
    const a = byId.get(f.slug);
    if (!a) throw new Error(`Thema ${thema.slug}: Frage verweist auf unbekannten Artikel "${f.slug}"`);
    return { q: f.q, href: `/wissen/${a.id}/`, label: a.data.title };
  }
  return { q: f.q, href: f.href, label: f.label };
});
const glossar = (await getCollection('glossar', (g) => !g.data.draft && thema.glossar.includes(g.id))).sort(
  (a, b) => thema.glossar.indexOf(a.id) - thema.glossar.indexOf(b.id),
);
const andere = themen.filter((t) => t.slug !== thema.slug);
const path = `/wissen/${thema.slug}/`;
const url = `${site.url}${path}`;
const lastmod = artikel.map((a) => (a.data.updatedDate ?? a.data.pubDate).toISOString()).sort().at(-1) ?? new Date(thema.pubDate).toISOString();

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#collection`,
    name: thema.title,
    description: thema.description,
    url,
    inLanguage: 'de-DE',
    dateModified: lastmod,
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@type': 'Thing', name: thema.name },
    hasPart: artikel.map((a) => ({ '@type': 'Article', headline: a.data.title, url: `${site.url}/wissen/${a.id}/` })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Wissen', item: `${site.url}/wissen/` },
      { '@type': 'ListItem', position: 3, name: thema.name, item: url },
    ],
  },
];
---
<Base title={thema.metaTitle} description={thema.description} path={path} jsonLd={jsonLd} modifiedTime={lastmod}>
  <SeitenKopf crumbs={[{ href: '/', label: 'Start' }, { href: '/wissen/', label: 'Wissen' }, { label: thema.name }]} meta={`Thema, ${artikel.length} Artikel`} title={thema.title} size="m">
    {thema.intro.map((p) => <p set:html={p} />)}
  </SeitenKopf>

  <div class="container-wide k-end">
    {einstieg && (
      <a href={`/wissen/${einstieg.id}/`} class="band hb-ein" data-rv>
        <span class="hb-ein-k">Einstieg</span>
        <span class="hb-ein-t">{einstieg.data.title}</span>
        <span class="hb-ein-d">{einstieg.data.description}</span>
        <span class="btn-primary hb-ein-b">Lesen</span>
      </a>
    )}

    <section class="k-sec" aria-labelledby="fragen-h">
      <h2 id="fragen-h" class="k-h2" data-rv>Welche Frage, welcher Artikel</h2>
      <ul class="hb-fragen">
        {fragen.map((f, i) => (
          <li data-rv style={`--i:${i % 4}`}>
            <p class="hb-q">{f.q}</p>
            <p class="hb-a"><a href={f.href} class="k-a">{f.label}</a></p>
          </li>
        ))}
      </ul>
    </section>

    <section class="k-sec" aria-labelledby="artikel-h">
      <h2 id="artikel-h" class="k-h2" data-rv>Alle Artikel zum Thema</h2>
      <ul class="k-rows hb-arts">
        {artikel.map((a, i) => (
          <li data-rv style={`--i:${i % 4}`}>
            <a href={`/wissen/${a.id}/`} class="k-row">
              {a.data.category !== thema.category && <span class="k-row-k">{a.data.category}</span>}
              <span class="k-row-t">{a.data.title}</span>
              <span class="k-row-d">{a.data.description}</span>
              <Pfeil />
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div class="hb-two">
      {glossar.length > 0 && (
        <section class="k-sec" aria-labelledby="glossar-h">
          <h2 id="glossar-h" class="k-h3" data-rv>Begriffe zum Thema</h2>
          <ul class="k-rows hb-gl">
            {glossar.map((g, i) => (
              <li data-rv style={`--i:${i % 4}`}><a href={`/glossar/${g.id}/`} class="k-row"><span class="k-row-t">{g.data.term}</span><span class="k-row-d">{g.data.short}</span><Pfeil /></a></li>
            ))}
          </ul>
          <p class="hb-more"><a href="/glossar/" class="k-q">Alle Begriffe im Glossar</a></p>
        </section>
      )}

      {thema.tools.length > 0 && (
        <section class="k-sec" aria-labelledby="tools-h">
          <h2 id="tools-h" class="k-h3" data-rv>Werkzeuge</h2>
          <ul class="k-rows hb-gl">
            {thema.tools.map((t, i) => (
              <li data-rv style={`--i:${i}`}><a href={t.href} class="k-row"><span class="k-row-t">{t.label}</span><span class="k-row-d">{t.note}</span><Pfeil /></a></li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <section class="k-sec-s hb-andere" aria-labelledby="themen-h">
      <h2 id="themen-h" class="hb-andere-h">Weitere Themen</h2>
      <ul class="k-inline">
        {andere.map((t) => (<li><a href={`/wissen/${t.slug}/`} class="k-q">{t.name}</a></li>))}
        <li><a href="/wissen/" class="k-q">Alle Artikel</a></li>
      </ul>
    </section>

    <div class="hb-narrow">
      <ProductTeaser position={`thema-${thema.slug}`} />
      {thema.sources.length > 0 && <Footnotes ids={thema.sources} />}
    </div>
  </div>
</Base>

<style>
  /* Einstieg: dunkler Block, gelber Knopf */
  .hb-ein {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vh, 3.5rem);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: 20px;
    text-decoration: none;
    max-width: 62rem;
  }
  .hb-ein-k {
    font-size: 0.9375rem;
    color: var(--dark-muted);
  }
  .hb-ein-t {
    font-stretch: 118%;
    font-weight: 520;
    letter-spacing: -0.018em;
    font-size: clamp(1.5rem, 3vw, 2.375rem);
    line-height: 1.1;
    color: var(--dark-fg);
    max-width: 22em;
  }
  .hb-ein-d {
    color: var(--dark-muted);
    max-width: 40em;
    line-height: 1.55;
  }
  .hb-ein-b {
    justify-self: start;
    margin-top: 0.75rem;
  }
  .hb-ein:hover .hb-ein-b {
    background: #f0da70;
    border-color: #f0da70;
  }
  /* Fragen: Frage links, Artikel rechts */
  .hb-fragen {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-ink);
  }
  .hb-fragen li {
    display: grid;
    gap: 0.35rem 3rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .hb-q {
    font-stretch: 112%;
    font-weight: 520;
    font-size: 1.125rem;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .hb-a {
    font-size: 0.975rem;
    line-height: 1.5;
  }
  @media (min-width: 900px) {
    .hb-fragen li {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .hb-arts {
    margin-top: 2rem;
  }
  .hb-gl {
    margin-top: 1.25rem;
  }
  .hb-gl .k-row-t {
    font-size: 1.125rem;
  }
  .hb-more {
    margin-top: 1rem;
    font-size: 0.9375rem;
  }
  @media (min-width: 900px) {
    .hb-two {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 0 4rem;
      align-items: start;
    }
  }
  .hb-andere {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.9375rem;
  }
  .hb-andere-h {
    margin-bottom: 0.6rem;
    font-size: 0.9375rem;
    font-stretch: 100%;
    font-weight: 450;
    letter-spacing: 0;
    color: var(--color-ink-3);
  }
  .hb-narrow {
    max-width: 45rem;
  }
</style>

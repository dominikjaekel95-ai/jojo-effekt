---
/**
 * Themenseite (Hub) unter /wissen/<slug>/: Einordnung mit Quellen, „Welche Frage, welcher Artikel“, alle Artikel des
 * Themas, Glossar-Begriffe, Werkzeuge, weitere Themen. Gerendert aus src/pages/wissen/[slug].astro für jeden Eintrag in
 * src/data/themen.json. Zielt auf den Überbegriff; die Artikel decken die Long-Tail-Anfragen.
 */
import Base from '../layouts/Base.astro';
import Footnotes from './Footnotes.astro';
import Cta from './Cta.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { themen, gehoertZu, type Thema } from '../data/themen';

interface Props { thema: Thema }
const { thema } = Astro.props;

const alle = (await getCollection('wissen', (a) => !a.data.draft)).sort((a, b) => a.data.order - b.data.order);
const artikel = alle.filter((a) => gehoertZu(thema, a.id, a.data.category));
if (artikel.length === 0) throw new Error(`Thema ${thema.slug}: kein Artikel mit category "${thema.category}"`);
const byId = new Map(alle.map((a) => [a.id, a] as const));
const einstieg = thema.einstieg ? byId.get(thema.einstieg) : undefined;
if (thema.einstieg && !einstieg) throw new Error(`Thema ${thema.slug}: Einstieg "${thema.einstieg}" ist kein veröffentlichter Artikel`);
const fragen = thema.fragen.map((f) => {
  if ('slug' in f) {
    const a = byId.get(f.slug);
    if (!a) throw new Error(`Thema ${thema.slug}: Frage verweist auf unbekannten Artikel "${f.slug}"`);
    return { q: f.q, href: `/wissen/${a.id}/`, label: a.data.title };
  }
  return { q: f.q, href: f.href, label: f.label };
});
const glossar = (await getCollection('glossar', (g) => !g.data.draft && thema.glossar.includes(g.id))).sort(
  (a, b) => thema.glossar.indexOf(a.id) - thema.glossar.indexOf(b.id),
);
const andere = themen.filter((t) => t.slug !== thema.slug);
const path = `/wissen/${thema.slug}/`;
const url = `${site.url}${path}`;
const lastmod = artikel.map((a) => (a.data.updatedDate ?? a.data.pubDate).toISOString()).sort().at(-1) ?? new Date(thema.pubDate).toISOString();

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#collection`,
    name: thema.title,
    description: thema.description,
    url,
    inLanguage: 'de-DE',
    dateModified: lastmod,
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@type': 'Thing', name: thema.name },
    hasPart: artikel.map((a) => ({ '@type': 'Article', headline: a.data.title, url: `${site.url}/wissen/${a.id}/` })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Wissen', item: `${site.url}/wissen/` },
      { '@type': 'ListItem', position: 3, name: thema.name, item: url },
    ],
  },
];
const chip = 'inline-block rounded-lg border border-line bg-white px-3 py-1.5 text-sm font-semibold text-ink no-underline hover:border-moss hover:text-moss';
---
<Base title={thema.metaTitle} description={thema.description} path={path} jsonLd={jsonLd} modifiedTime={lastmod}>
  <section class="container-wide py-12">
    <nav aria-label="Brotkrumen" class="text-sm text-ink-3"><a href="/" class="hover:text-moss">Start</a> › <a href="/wissen/" class="hover:text-moss">Wissen</a> › {thema.name}</nav>
    <p class="eyebrow mt-6">Thema · {artikel.length} Artikel</p>
    <h1 class="h1 mt-3 !text-[2.1rem] sm:!text-[2.8rem]">{thema.title}</h1>
    <div class="prose-site mt-6 max-w-3xl">
      {thema.intro.map((p) => <p set:html={p} />)}
    </div>
    <p class="mt-4 max-w-3xl rounded-lg border border-line bg-white px-4 py-3 text-sm font-medium text-ink">{site.doctorSentence}</p>

    {einstieg && (
      <a href={`/wissen/${einstieg.id}/`} class="card mt-8 block border-moss/30 bg-moss-light/40 no-underline hover:border-moss">
        <p class="eyebrow">Einstieg</p>
        <h2 class="mt-2 text-2xl leading-snug text-ink">{einstieg.data.title}</h2>
        <p class="mt-2 text-ink-2">{einstieg.data.description}</p>
        <p class="mt-4 text-sm font-semibold text-moss">Lesen →</p>
      </a>
    )}

    <section class="mt-10" aria-labelledby="fragen-h">
      <h2 id="fragen-h" class="text-xl font-bold text-ink">Welche Frage, welcher Artikel</h2>
      <ul class="mt-4 divide-y divide-line rounded-xl2 border border-line bg-white">
        {fragen.map((f) => (
          <li class="px-5 py-3">
            <p class="font-semibold text-ink">{f.q}</p>
            <p class="mt-1 text-sm"><a href={f.href} class="text-moss underline underline-offset-4">{f.label}</a></p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-10" aria-labelledby="artikel-h">
      <h2 id="artikel-h" class="text-xl font-bold text-ink">Alle Artikel zum Thema</h2>
      <div class="mt-4 grid gap-6 md:grid-cols-2">
        {artikel.map((a) => (
          <a href={`/wissen/${a.id}/`} class="card group block no-underline hover:border-moss">
            <p class="text-sm font-medium text-ink-3">{a.data.category}</p>
            <h3 class="mt-2 text-xl leading-snug text-ink group-hover:text-moss">{a.data.title}</h3>
            <p class="mt-2 text-sm text-ink-2">{a.data.description}</p>
            <p class="mt-4 text-sm font-semibold text-moss">Lesen →</p>
          </a>
        ))}
      </div>
    </section>

    {glossar.length > 0 && (
      <section class="mt-10" aria-labelledby="glossar-h">
        <h2 id="glossar-h" class="text-xl font-bold text-ink">Begriffe zum Thema</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {glossar.map((g) => (
            <li>
              <a href={`/glossar/${g.id}/`} class="block h-full rounded-lg border border-line bg-white px-4 py-3 no-underline hover:border-moss">
                <p class="font-semibold text-ink">{g.data.term}</p>
                <p class="mt-1 text-sm text-ink-2">{g.data.short}</p>
              </a>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-sm"><a href="/glossar/" class="font-semibold text-moss underline underline-offset-4">Alle Begriffe im Glossar</a></p>
      </section>
    )}

    {thema.tools.length > 0 && (
      <section class="mt-10" aria-labelledby="tools-h">
        <h2 id="tools-h" class="text-xl font-bold text-ink">Werkzeuge</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {thema.tools.map((t) => (
            <li>
              <a href={t.href} class="block h-full rounded-lg border border-amber/50 bg-amber-light/40 px-4 py-3 no-underline hover:border-amber">
                <p class="font-semibold text-ink">{t.label}</p>
                <p class="mt-1 text-sm text-ink-2">{t.note}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="mt-10" aria-labelledby="themen-h">
      <h2 id="themen-h" class="eyebrow">Weitere Themen</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {andere.map((t) => (<li><a href={`/wissen/${t.slug}/`} class={chip}>{t.name}</a></li>))}
        <li><a href="/wissen/" class={chip}>Alle Artikel</a></li>
      </ul>
    </section>

    <div class="mt-12 rounded-xl2 border border-line bg-white p-6">
      <p class="max-w-2xl text-sm text-ink-2">Wir entwickeln ein 12-Wochen-Set für die Zeit nach der Abnehmspritze: Protein, Ballaststoffe, Kreatin und ein Programm. Es ist ein Lebensmittel mit Programm, kein Medikament, und es verhindert den Jojo-Effekt nicht.</p>
      <div class="mt-4"><Cta position={`thema-${thema.slug}`} label="Zum 12-Wochen-Set" secondary /></div>
    </div>

    {thema.sources.length > 0 && <Footnotes ids={thema.sources} />}
  </section>
</Base>

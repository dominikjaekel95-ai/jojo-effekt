---
/** Autoren-/Prüfbox für E-E-A-T. Platzhalter für Michis Name/Qualifikation in src/data/site.ts. */
import { site } from '../data/site';
interface Props { pubDate: Date; updatedDate?: Date }
const { pubDate, updatedDate } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
---
<aside class="mt-10 rounded-xl2 border border-line bg-paper-2 p-5 text-sm text-ink-2" aria-label="Autor und fachliche Prüfung">
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <p class="eyebrow">Autor</p>
      <p class="mt-1 font-semibold text-ink">{site.owner.name}</p>
      <p>Gründer von {site.name}, {site.owner.city}. Recherchiert und schreibt die Artikel auf Basis der verlinkten Studien.</p>
    </div>
    <div>
      <p class="eyebrow">Fachliche Prüfung</p>
      <p class="mt-1 font-semibold text-ink">{site.reviewer.name}</p>
      <p>{site.reviewer.title}. Prüft alle Aussagen zu Ernährung, Training und gesundheitsbezogenen Angaben.</p>
    </div>
  </div>
  <p class="mt-4 text-xs text-ink-3">
    Veröffentlicht am {fmt(pubDate)}{updatedDate && <> · Aktualisiert am {fmt(updatedDate)}</>}. Wir aktualisieren Artikel, wenn neue Studien erscheinen.
    Mehr zu unserer Arbeitsweise unter <a href="/ueber/" class="underline">Über uns</a>.
  </p>
</aside>

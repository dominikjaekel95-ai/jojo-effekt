---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Footnotes from '../../components/Footnotes.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../data/site';
import { findTerms, mentionsTerm, byTerm } from '../../lib/glossar';

export const getStaticPaths = (async () => {
  const entries = await getCollection('glossar', (g) => !g.data.draft);
  return entries.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const glossar = await getCollection('glossar', (g) => !g.data.draft);
const wissen = await getCollection('wissen', (a) => !a.data.draft);

// Verwandte Begriffe: explizit gepflegt plus automatisch im Text erkannte
const explicitRelated = entry.data.related.map((id) => glossar.find((g) => g.id === id)).filter((g): g is NonNullable<typeof g> => Boolean(g));
const autoRelated = findTerms(entry.body ?? '', glossar, entry.id).filter((g) => !explicitRelated.includes(g));
const related = [...explicitRelated, ...autoRelated.sort(byTerm)].slice(0, 6);

// Vertiefende Artikel: explizit gepflegt plus Artikel, in denen der Begriff vorkommt
const explicitArticles = entry.data.articles.map((id) => wissen.find((a) => a.id === id)).filter((a): a is NonNullable<typeof a> => Boolean(a));
const autoArticles = wissen.filter((a) => !explicitArticles.includes(a) && mentionsTerm(`${a.body ?? ''} ${a.data.faq.map((f) => f.a).join(' ')}`, entry)).sort((a, b) => a.data.order - b.data.order);
const articles = [...explicitArticles, ...autoArticles].slice(0, 5);

const path = `/glossar/${entry.id}/`;
const url = `${site.url}${path}`;
const modified = entry.data.updatedDate ?? entry.data.pubDate;
const jsonLd = [
  {
    '@type': 'DefinedTerm',
    '@id': `${url}#term`,
    name: entry.data.term,
    description: entry.data.short,
    url,
    inLanguage: 'de-DE',
    inDefinedTermSet: { '@id': `${site.url}/glossar/#set` },
    ...(entry.data.synonyms.length ? { alternateName: entry.data.synonyms } : {}),
  },
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: entry.data.metaTitle ?? entry.data.term,
    description: entry.data.description,
    inLanguage: 'de-DE',
    datePublished: entry.data.pubDate.toISOString(),
    dateModified: modified.toISOString(),
    author: { '@type': 'Person', name: site.owner.name, url: `${site.url}/ueber/` },
    ...(site.reviewer ? { reviewedBy: { '@type': 'Person', name: site.reviewer.name, jobTitle: site.reviewer.title } } : {}),
    publisher: { '@id': `${site.url}/#organization` },
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: { '@id': `${url}#term` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Glossar', item: `${site.url}/glossar/` },
      { '@type': 'ListItem', position: 3, name: entry.data.term, item: url },
    ],
  },
];
---
<Base title={entry.data.metaTitle ?? `${entry.data.term}: Bedeutung nach der Abnehmspritze`} description={entry.data.description} path={path} jsonLd={jsonLd} publishedTime={entry.data.pubDate.toISOString()} modifiedTime={modified.toISOString()}>
  <article class="container-narrow py-12">
    <nav aria-label="Brotkrumen" class="text-sm text-ink-3">
      <a href="/" class="hover:text-moss">Start</a> › <a href="/glossar/" class="hover:text-moss">Glossar</a> › {entry.data.term}
    </nav>
    <p class="eyebrow mt-6">Glossar{entry.data.own && (<> <span class="ml-3 rounded-md bg-amber-light px-2 py-0.5 text-xs font-semibold normal-case tracking-normal text-amber-dark">Begriff von Nach der Spritze</span></>)}</p>
    <h1 class="h1 mt-3 !text-[2.1rem] sm:!text-[2.8rem]">{entry.data.term}</h1>
    {entry.data.synonyms.length > 0 && (<p class="mt-2 text-sm text-ink-3">Auch: {entry.data.synonyms.join(', ')}</p>)}
    <div class="mt-6 rounded-xl2 border-l-[3px] border-amber bg-amber-light/50 px-5 py-4">
      <p class="eyebrow text-amber-dark">Definition</p>
      <p class="mt-2 text-[1.1rem] leading-snug text-ink">{entry.data.short}</p>
    </div>

    <div class="prose-site mt-8">
      <Content />
    </div>

    {articles.length > 0 && (
      <section class="mt-10" aria-labelledby="vertiefung-h">
        <h2 id="vertiefung-h" class="text-base font-semibold text-ink">Vertiefende Artikel</h2>
        <ul class="mt-3 grid gap-3 sm:grid-cols-2">
          {articles.map((a) => (
            <li>
              <a href={`/wissen/${a.id}/`} class="card block h-full no-underline hover:border-moss">
                <p class="text-sm text-ink-3">{a.data.category}</p>
                <p class="mt-1 font-semibold text-ink">{a.data.title}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="mt-10" aria-labelledby="verwandt-h">
        <h2 id="verwandt-h" class="text-base font-semibold text-ink">Verwandte Begriffe</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {related.map((g) => (
            <li><a href={`/glossar/${g.id}/`} class="inline-block rounded-lg border border-line bg-white px-3 py-1.5 text-sm font-semibold text-ink no-underline hover:border-moss hover:text-moss">{g.data.term}</a></li>
          ))}
        </ul>
      </section>
    )}

    <p class="mt-8 rounded-lg border border-line bg-white px-4 py-3 text-sm font-medium text-ink">{site.doctorSentence}</p>

    <AuthorBox pubDate={entry.data.pubDate} updatedDate={entry.data.updatedDate} />

    <Footnotes ids={entry.data.sources} />

    <p class="mt-8 text-sm"><a href="/glossar/" class="font-semibold text-moss underline underline-offset-4">Zurück zum Glossar</a></p>
  </article>
</Base>

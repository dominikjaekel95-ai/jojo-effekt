---
/** Dezente Produkt-Box in Artikeln. Nur zugelassene Angaben, keine Wirkversprechen. */
import { site } from '../data/site';
import Cta from './Cta.astro';
interface Props { position: string }
const { position } = Astro.props;
---
<aside class="my-10 rounded-xl2 border border-moss/30 bg-moss-light/40 p-6" aria-label="Das 12-Wochen-Set">
  <p class="eyebrow">Das 12-Wochen-Set</p>
  <h3 class="mt-2 text-2xl leading-snug text-ink">Protein, Ballaststoffe, Kreatin und zwei Krafteinheiten pro Woche</h3>
  <p class="mt-2 text-sm text-ink-2">
    Für die Zeit nach der Abnehmspritze: 84 Protein-Sticks (≥ 20 g), 84 Ballaststoff-Sticks (5 g), 84 Portionen Kreatin
    (3 g) und ein 12-Wochen-Programm mit Trainingsplänen und wöchentlichem Check-in. {site.price.set} € für 12 Wochen,
    Vorbestellung ohne Zahlung.
  </p>
  <div class="mt-4 flex flex-wrap items-center gap-3">
    <Cta position={position} label="Zum Set und zur Vorbestellung" />
    <span class="text-xs text-ink-3">Kein Medikament. {site.doctorSentence}</span>
  </div>
</aside>

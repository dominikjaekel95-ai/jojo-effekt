    "pdf:checkliste": "npm run build && node scripts/checkliste-pdf.mjs",
    "pdf:ernaehrungsplan": "npm run build && node scripts/ernaehrungsplan-pdf.mjs",
    "test:plan": "node scripts/plan-interaktiv-test.mjs",
    "grafiken": "node scripts/grafiken.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }

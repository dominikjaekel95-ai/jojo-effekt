---
/** Schlichte Produkt-Illustration: drei Sticks und die Programm-Karte. Kein Foto, keine Markennamen. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 520 360" class={cls} role="img" aria-labelledby="set-ill-title" xmlns="http://www.w3.org/2000/svg">
  <title id="set-ill-title">Illustration des 12-Wochen-Sets: Protein-Stick, Ballaststoff-Stick, Kreatin und Programmkarte</title>
  <defs>
    <linearGradient id="g-moss" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#3a7d69"/><stop offset="1" stop-color="#2f6b5a"/></linearGradient>
    <linearGradient id="g-amber" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#e5a743"/><stop offset="1" stop-color="#d9962d"/></linearGradient>
    <linearGradient id="g-clay" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#c6664c"/><stop offset="1" stop-color="#b8563e"/></linearGradient>
    <filter id="soft" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#1c2430" flood-opacity="0.12"/></filter>
  </defs>
  <ellipse cx="260" cy="320" rx="220" ry="22" fill="#e9e2d6"/>
  <!-- Programmkarte -->
  <g transform="translate(300 60) rotate(6)" filter="url(#soft)">
    <rect width="170" height="230" rx="16" fill="#fff" stroke="#e3ddd2"/>
    <rect x="18" y="20" width="70" height="8" rx="4" fill="#2f6b5a"/>
    <rect x="18" y="40" width="120" height="6" rx="3" fill="#e3ddd2"/>
    <rect x="18" y="54" width="100" height="6" rx="3" fill="#e3ddd2"/>
    <g transform="translate(18 80)">
      <rect width="134" height="26" rx="8" fill="#dcebe4"/><rect x="8" y="8" width="60" height="10" rx="5" fill="#2f6b5a"/>
      <rect y="34" width="134" height="26" rx="8" fill="#fbefd9"/><rect x="8" y="42" width="80" height="10" rx="5" fill="#d9962d"/>
      <rect y="68" width="134" height="26" rx="8" fill="#dcebe4"/><rect x="8" y="76" width="50" height="10" rx="5" fill="#2f6b5a"/>
      <rect y="102" width="134" height="26" rx="8" fill="#f2ede4"/><rect x="8" y="110" width="90" height="10" rx="5" fill="#6b7484"/>
    </g>
    <text x="18" y="215" font-family="Inter Variable, system-ui, sans-serif" font-size="12" font-weight="700" fill="#1c2430">12 Wochen</text>
  </g>
  <!-- Sticks -->
  <g filter="url(#soft)">
    <g transform="translate(70 90) rotate(-8)">
      <rect width="64" height="200" rx="12" fill="url(#g-moss)"/>
      <rect x="0" y="0" width="64" height="18" rx="6" fill="#24554a"/>
      <rect x="14" y="70" width="36" height="7" rx="3.5" fill="#fff" opacity="0.9"/>
      <rect x="14" y="84" width="24" height="5" rx="2.5" fill="#fff" opacity="0.6"/>
      <text x="32" y="150" text-anchor="middle" font-family="Inter Variable, system-ui, sans-serif" font-size="11" font-weight="700" fill="#fff">PROTEIN</text>
      <text x="32" y="166" text-anchor="middle" font-family="Inter Variable, system-ui, sans-serif" font-size="9" fill="#fff" opacity="0.85">20 g</text>
    </g>
    <g transform="translate(160 100) rotate(-3)">
      <rect width="64" height="200" rx="12" fill="url(#g-amber)"/>
      <rect x="0" y="0" width="64" height="18" rx="6" fill="#b87a1e"/>
      <rect x="14" y="70" width="36" height="7" rx="3.5" fill="#fff" opacity="0.9"/>
      <rect x="14" y="84" width="24" height="5" rx="2.5" fill="#fff" opacity="0.6"/>
      <text x="32" y="150" text-anchor="middle" font-family="Inter Variable, system-ui, sans-serif" font-size="10" font-weight="700" fill="#fff">BALLAST-</text>
      <text x="32" y="163" text-anchor="middle" font-family="Inter Variable, system-ui, sans-serif" font-size="10" font-weight="700" fill="#fff">STOFFE</text>
      <text x="32" y="178" text-anchor="middle" font-family="Inter Variable, system-ui, sans-serif" font-size="9" fill="#fff" opacity="0.85">5 g</text>
    </g>
    <g transform="translate(250 112) rotate(3)">
      <rect width="64" height="200" rx="12" fill="url(#g-clay)"/>
      <rect x="0" y="0" width="64" height="18" rx="6" fill="#9a4530"/>
      <rect x="14" y="70" width="36" height="7" rx="3.5" fill="#fff" opacity="0.9"/>
      <rect x="14" y="84" width="24" height="5" rx="2.5" fill="#fff" opacity="0.6"/>
      <text x="32" y="150" text-anchor="middle" font-family="Inter Variable, system-ui, sans-serif" font-size="11" font-weight="700" fill="#fff">KREATIN</text>
      <text x="32" y="166" text-anchor="middle" font-family="Inter Variable, system-ui, sans-serif" font-size="9" fill="#fff" opacity="0.85">3 g</text>
    </g>
  </g>
</svg>

---
import type { GetStaticPaths } from 'astro';
/**
 * Glossar-Eintrag /glossar/<slug>/: Definition, Text, vertiefende Artikel, verwandte Begriffe. Gestaltung „Kalk“ seit
 * 06.10.2026 (Definition zwischen Haarlinien, Listen als Zeilen bzw. Textliste statt Chips).
 */
import Base from '../../layouts/Base.astro';
import SeitenKopf from '../../components/SeitenKopf.astro';
import Pfeil from '../../components/Pfeil.astro';
import Footnotes from '../../components/Footnotes.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../data/site';
import { findTerms, mentionsTerm, byTerm } from '../../lib/glossar';

export const getStaticPaths = (async () => {
  const entries = await getCollection('glossar', (g) => !g.data.draft);
  return entries.map((e) => ({ params: { slug: e.id }, props: { entry: e } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const glossar = await getCollection('glossar', (g) => !g.data.draft);
const wissen = await getCollection('wissen', (a) => !a.data.draft);

// Verwandte Begriffe: explizit gepflegt plus automatisch im Text erkannte
const explicitRelated = entry.data.related.map((id) => glossar.find((g) => g.id === id)).filter((g): g is NonNullable<typeof g> => Boolean(g));
const autoRelated = findTerms(entry.body ?? '', glossar, entry.id).filter((g) => !explicitRelated.includes(g));
const related = [...explicitRelated, ...autoRelated.sort(byTerm)].slice(0, 6);

// Vertiefende Artikel: explizit gepflegt plus Artikel, in denen der Begriff vorkommt
const explicitArticles = entry.data.articles.map((id) => wissen.find((a) => a.id === id)).filter((a): a is NonNullable<typeof a> => Boolean(a));
const autoArticles = wissen.filter((a) => !explicitArticles.includes(a) && mentionsTerm(`${a.body ?? ''} ${a.data.faq.map((f) => f.a).join(' ')}`, entry)).sort((a, b) => a.data.order - b.data.order);
const articles = [...explicitArticles, ...autoArticles].slice(0, 5);

const path = `/glossar/${entry.id}/`;
const url = `${site.url}${path}`;
const modified = entry.data.updatedDate ?? entry.data.pubDate;
const jsonLd = [
  {
    '@type': 'DefinedTerm',
    '@id': `${url}#term`,
    name: entry.data.term,
    description: entry.data.short,
    url,
    inLanguage: 'de-DE',
    inDefinedTermSet: { '@id': `${site.url}/glossar/#set` },
    ...(entry.data.synonyms.length ? { alternateName: entry.data.synonyms } : {}),
  },
  {
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: entry.data.metaTitle ?? entry.data.term,
    description: entry.data.description,
    inLanguage: 'de-DE',
    datePublished: entry.data.pubDate.toISOString(),
    dateModified: modified.toISOString(),
    author: { '@type': 'Person', name: site.owner.name, url: `${site.url}/ueber/` },
    ...(site.reviewer ? { reviewedBy: { '@type': 'Person', name: site.reviewer.name, jobTitle: site.reviewer.title } } : {}),
    publisher: { '@id': `${site.url}/#organization` },
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: { '@id': `${url}#term` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Glossar', item: `${site.url}/glossar/` },
      { '@type': 'ListItem', position: 3, name: entry.data.term, item: url },
    ],
  },
];
---
<Base title={entry.data.metaTitle ?? `${entry.data.term}: Bedeutung nach der Abnehmspritze`} description={entry.data.description} path={path} jsonLd={jsonLd} publishedTime={entry.data.pubDate.toISOString()} modifiedTime={modified.toISOString()}>
  <SeitenKopf crumbs={[{ href: '/', label: 'Start' }, { href: '/glossar/', label: 'Glossar' }, { label: entry.data.term }]} meta={entry.data.own ? 'Glossar, Begriff von Nach der Spritze' : 'Glossar'} title={entry.data.term} size="m" width="narrow" doc={false}>
    {entry.data.synonyms.length > 0 && (<p class="gs-syn">Auch: {entry.data.synonyms.join(', ')}</p>)}
  </SeitenKopf>

  <article class="container-narrow k-end">
    <div class="gs-def" data-rv>
      <p class="gs-def-k">Definition</p>
      <p class="gs-def-t">{entry.data.short}</p>
    </div>

    <div class="prose-site mt-8">
      <Content />
    </div>

    {articles.length > 0 && (
      <section class="k-sec-s" aria-labelledby="vertiefung-h">
        <h2 id="vertiefung-h" class="k-h3">Vertiefende Artikel</h2>
        <ul class="k-rows gs-rows">
          {articles.map((a, i) => (
            <li data-rv style={`--i:${i}`}><a href={`/wissen/${a.id}/`} class="k-row"><span class="k-row-k">{a.data.category}</span><span class="k-row-t">{a.data.title}</span><Pfeil /></a></li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section class="gs-rel" aria-labelledby="verwandt-h">
        <h2 id="verwandt-h" class="gs-rel-h">Verwandte Begriffe</h2>
        <ul class="k-inline">
          {related.map((g) => (<li><a href={`/glossar/${g.id}/`} class="k-q">{g.data.term}</a></li>))}
        </ul>
      </section>
    )}

    <p class="k-doc gs-doc">{site.doctorSentence}</p>

    <AuthorBox pubDate={entry.data.pubDate} updatedDate={entry.data.updatedDate} />

    <Footnotes ids={entry.data.sources} />

    <p class="gs-back"><a href="/glossar/" class="k-q">Zurück zum Glossar</a></p>
  </article>
</Base>

<style>
  .gs-syn {
    font-size: 0.975rem;
    color: var(--color-ink-3);
  }
  .gs-def {
    margin-top: clamp(2rem, 5vh, 3rem);
    padding: 1.25rem 0 1.5rem;
    border-top: 1px solid var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }
  .gs-def-k {
    font-size: 0.875rem;
    color: var(--color-ink-3);
  }
  .gs-def-t {
    margin-top: 0.6rem;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    font-stretch: 106%;
    line-height: 1.4;
    color: var(--color-ink);
  }
  .gs-rows .k-row-t {
    font-size: 1.125rem;
  }
  .gs-rel {
    margin-top: 2.5rem;
    font-size: 0.975rem;
  }
  .gs-rel-h {
    margin-bottom: 0.6rem;
    font-size: 0.9375rem;
    font-stretch: 100%;
    font-weight: 450;
    letter-spacing: 0;
    color: var(--color-ink-3);
  }
  .gs-doc {
    margin-top: 2.5rem;
  }
  .gs-back {
    margin-top: 2rem;
    font-size: 0.9375rem;
  }
</style>

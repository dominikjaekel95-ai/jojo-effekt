---
/** Schlichte Produkt-Illustration: drei Sticks und die Programm-Karte. Kein Foto, keine Markennamen. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg viewBox="0 0 520 360" class={cls} role="img" aria-labelledby="set-ill-title" xmlns="http://www.w3.org/2000/svg">
  <title id="set-ill-title">Illustration des 12-Wochen-Sets: Protein-Stick, Ballaststoff-Stick, Kreatin und Programmkarte</title>
  <defs>
    <linearGradient id="g-moss" x1="0" x2="0" y1="0" y2="1"><stop offset="0" style="stop-color:var(--color-moss);stop-opacity:0.85"/><stop offset="1" style="stop-color:var(--color-moss)"/></linearGradient>
    <linearGradient id="g-amber" x1="0" x2="0" y1="0" y2="1"><stop offset="0" style="stop-color:var(--color-amber);stop-opacity:0.85"/><stop offset="1" style="stop-color:var(--color-amber)"/></linearGradient>
    <linearGradient id="g-clay" x1="0" x2="0" y1="0" y2="1"><stop offset="0" style="stop-color:var(--color-clay);stop-opacity:0.85"/><stop offset="1" style="stop-color:var(--color-clay)"/></linearGradient>
    <filter id="soft" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#1c2430" flood-opacity="0.12"/></filter>
  </defs>
  <ellipse cx="260" cy="320" rx="220" ry="22" style="fill:var(--color-paper-2)"/>
  <!-- Programmkarte -->
  <g transform="translate(300 60) rotate(6)" filter="url(#soft)">
    <rect width="170" height="230" rx="16" fill="#fff" style="stroke:var(--color-line)"/>
    <rect x="18" y="20" width="70" height="8" rx="4" style="fill:var(--color-moss)"/>
    <rect x="18" y="40" width="120" height="6" rx="3" style="fill:var(--color-line)"/>
    <rect x="18" y="54" width="100" height="6" rx="3" style="fill:var(--color-line)"/>
    <g transform="translate(18 80)">
      <rect width="134" height="26" rx="8" style="fill:var(--color-moss-light)"/><rect x="8" y="8" width="60" height="10" rx="5" style="fill:var(--color-moss)"/>
      <rect y="34" width="134" height="26" rx="8" style="fill:var(--color-amber-light)"/><rect x="8" y="42" width="80" height="10" rx="5" style="fill:var(--color-amber)"/>
      <rect y="68" width="134" height="26" rx="8" style="fill:var(--color-clay-light)"/><rect x="8" y="76" width="50" height="10" rx="5" style="fill:var(--color-clay)"/>
      <rect y="102" width="134" height="26" rx="8" style="fill:var(--color-paper-2)"/><rect x="8" y="110" width="90" height="10" rx="5" style="fill:var(--color-ink-3)"/>
    </g>
    <text x="18" y="215" font-family="var(--font-head), system-ui, sans-serif" font-size="12" font-weight="700" style="fill:var(--color-ink)">12 Wochen</text>
  </g>
  <!-- Sticks -->
  <g filter="url(#soft)">
    <g transform="translate(70 90) rotate(-8)">
      <rect width="64" height="200" rx="12" fill="url(#g-moss)"/>
      <rect x="0" y="0" width="64" height="18" rx="6" style="fill:var(--color-moss-dark)"/>
      <rect x="14" y="70" width="36" height="7" rx="3.5" fill="#fff" opacity="0.9"/>
      <rect x="14" y="84" width="24" height="5" rx="2.5" fill="#fff" opacity="0.6"/>
      <text x="32" y="150" text-anchor="middle" font-family="var(--font-sans), system-ui, sans-serif" font-size="11" font-weight="700" fill="#fff">PROTEIN</text>
      <text x="32" y="166" text-anchor="middle" font-family="var(--font-sans), system-ui, sans-serif" font-size="9" fill="#fff" opacity="0.85">20 g</text>
    </g>
    <g transform="translate(160 100) rotate(-3)">
      <rect width="64" height="200" rx="12" fill="url(#g-amber)"/>
      <rect x="0" y="0" width="64" height="18" rx="6" style="fill:var(--color-amber-dark)"/>
      <rect x="14" y="70" width="36" height="7" rx="3.5" fill="#fff" opacity="0.9"/>
      <rect x="14" y="84" width="24" height="5" rx="2.5" fill="#fff" opacity="0.6"/>
      <text x="32" y="150" text-anchor="middle" font-family="var(--font-sans), system-ui, sans-serif" font-size="10" font-weight="700" fill="#fff">BALLAST-</text>
      <text x="32" y="163" text-anchor="middle" font-family="var(--font-sans), system-ui, sans-serif" font-size="10" font-weight="700" fill="#fff">STOFFE</text>
      <text x="32" y="178" text-anchor="middle" font-family="var(--font-sans), system-ui, sans-serif" font-size="9" fill="#fff" opacity="0.85">5 g</text>
    </g>
    <g transform="translate(250 112) rotate(3)">
      <rect width="64" height="200" rx="12" fill="url(#g-clay)"/>
      <rect x="0" y="0" width="64" height="18" rx="6" style="fill:var(--color-clay);fill-opacity:0.8"/>
      <rect x="14" y="70" width="36" height="7" rx="3.5" fill="#fff" opacity="0.9"/>
      <rect x="14" y="84" width="24" height="5" rx="2.5" fill="#fff" opacity="0.6"/>
      <text x="32" y="150" text-anchor="middle" font-family="var(--font-sans), system-ui, sans-serif" font-size="11" font-weight="700" fill="#fff">KREATIN</text>
      <text x="32" y="166" text-anchor="middle" font-family="var(--font-sans), system-ui, sans-serif" font-size="9" fill="#fff" opacity="0.85">3 g</text>
    </g>
  </g>
</svg>

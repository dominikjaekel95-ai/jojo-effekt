<script>
  const html = document.documentElement;
  const RM = html.classList.contains('rm');
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  const smooth = (t: number) => {
    t = clamp(t, 0, 1);
    return t * t * (3 - 2 * t);
  };
  const seg = (t: number, a: number, b: number) => smooth((t - a) / (b - a));

  /* ---------------- Absetzkurve ---------------- */
  type El = SVGGraphicsElement & { style: CSSStyleDeclaration };
  interface Kurve {
    svg: SVGSVGElement;
    k: (name: string) => El | null;
    sema1: SVGPathElement;
    sema2: SVGPathElement;
    L1: number;
    L2: number;
    x68: number;
    x0: number;
    x120: number;
  }
  const story = document.querySelector<HTMLElement>('[data-kurve]');
  if (story) {
    const caps = story.querySelectorAll<HTMLElement>('.cap');
    const rail = story.querySelectorAll<HTMLElement>('.rail i');
    const svgs = story.querySelectorAll<SVGSVGElement>('svg[data-kv]');
    const chart = story.querySelector<HTMLElement>('[data-chart]');
    let K: Kurve | null = null;
    let lastT = -1;

    const op = (e: El | null, v: number) => {
      if (e) e.style.opacity = String(v);
    };
    const draw = (p: SVGPathElement, s: number) => {
      p.style.strokeDasharray = '1 1';
      p.style.strokeDashoffset = String(1 - s);
      p.style.opacity = s > 0.002 ? '1' : '0';
    };

    const pick = () => {
      const svg = Array.from(svgs).find((s) => s.getBoundingClientRect().width > 0);
      if (!svg) return;
      const k = (name: string) => svg.querySelector<El>(`[data-k="${name}"]`);
      const sema1 = k('sema1') as unknown as SVGPathElement;
      const sema2 = k('sema2') as unknown as SVGPathElement;
      const doseL = k('doseL') as unknown as SVGLineElement;
      const p0 = sema1.getPointAtLength(0);
      const pEnd = sema2.getPointAtLength(sema2.getTotalLength());
      K = { svg, k, sema1, sema2, L1: sema1.getTotalLength(), L2: sema2.getTotalLength(), x68: doseL.x1.baseVal.value, x0: p0.x, x120: pEnd.x };
      lastT = -1;
      update(true);
    };

    const progress = () => {
      const r = story.getBoundingClientRect();
      const vh = window.innerHeight;
      const e = clamp((vh - r.top) / vh, 0, 1); // Bühne fährt ein: die Kurve beginnt schon hier
      const q = clamp(-r.top / Math.max(1, r.height - vh), 0, 1); // Bühne klebt
      return 0.22 * e + 0.78 * q;
    };

    const update = (force = false) => {
      if (!K || RM) return;
      const t = progress();
      if (!force && Math.abs(t - lastT) < 0.0005) return;
      lastT = t;
      const { k } = K;
      const c = seg(t, 0.81, 0.92);
      const dim = 1 - 0.75 * c;
      const a = seg(t, 0.03, 0.34);
      const b = seg(t, 0.47, 0.68);
      op(k('grid'), 0.25 + 0.75 * seg(t, 0, 0.06));
      draw(K.sema1, a);
      K.sema1.style.opacity = String(a > 0.002 ? dim : 0);
      op(k('semaT'), seg(t, 0.1, 0.16) * dim);
      draw(K.sema2, b);
      K.sema2.style.opacity = String(b > 0.002 ? dim : 0);
      op(k('pla1'), (0.15 + 0.85 * a) * dim);
      op(k('pla2'), b * dim);
      op(k('plLab'), seg(t, 0.62, 0.7) * dim);
      op(k('p1'), seg(t, 0.31, 0.36));
      const ds = seg(t, 0.35, 0.42);
      op(k('dose'), ds);
      const doseL = k('doseL');
      if (doseL) {
        doseL.style.transformOrigin = `${K.x68}px 0px`;
        doseL.style.transform = `scaleY(${ds})`;
      }
      op(k('eight'), seg(t, 0.41, 0.47) * dim);
      op(k('p2'), seg(t, 0.66, 0.71) * dim);
      const brace = k('brace') as unknown as SVGPathElement | null;
      if (brace) {
        brace.style.strokeDasharray = '1 1';
        brace.style.strokeDashoffset = String(1 - seg(t, 0.68, 0.76));
      }
      op(k('braceG'), seg(t, 0.68, 0.72) * dim);
      // Schritt 4: der Verlust wird zum Balken und teilt sich in Fett und fettfreie Masse
      op(k('comp'), c);
      const fat = k('fat');
      const lean = k('lean');
      if (fat && lean) {
        fat.style.transformOrigin = `${K.x68}px ${fat.getAttribute('y')}px`;
        fat.style.transform = `scaleY(${c})`;
        lean.style.transformOrigin = `${K.x68}px ${Number(lean.getAttribute('y')) + Number(lean.getAttribute('height'))}px`;
        lean.style.transform = `scaleY(${c})`;
      }
      // Laufender Punkt: zeigt nur die Zeit, keine erfundenen Zwischenwerte
      const on = (a > 0.01 && a < 0.999) || (b > 0.01 && b < 0.999);
      const mover = k('mover');
      op(mover, on ? 1 : 0);
      if (on) {
        const first = a < 0.999;
        const p = first ? K.sema1 : K.sema2;
        const pt = p.getPointAtLength((first ? K.L1 : K.L2) * (first ? a : b));
        const md = k('md');
        const mt = k('mt');
        if (md && mt) {
          md.setAttribute('cx', String(pt.x));
          md.setAttribute('cy', String(pt.y));
          md.style.fill = first ? 'var(--color-ink)' : 'var(--color-clay)';
          mt.setAttribute('x', String(pt.x));
          mt.setAttribute('y', String(pt.y - 16));
          mt.textContent = `Woche ${Math.round(((pt.x - K.x0) / (K.x120 - K.x0)) * 120)}`;
          // Beschriftung blendet vor dem Endpunkt aus, damit sie nicht auf −17,3 % oder −5,6 % liegt
          op(mt, 1 - seg(first ? a : b, 0.86, 0.96));
        }
      }
      // Text folgt der Kurve: „Ein Jahr später“ erst, wenn der Wiederanstieg größtenteils gezeichnet ist
      const step = t < 0.35 ? 0 : t < 0.63 ? 1 : t < 0.8 ? 2 : 3;
      caps.forEach((cap, i) => cap.classList.toggle('on', i === step));
      rail.forEach((r, i) => r.classList.toggle('on', i <= step));
    };

    const tg = story.querySelector<HTMLButtonElement>('[data-placebo]');
    tg?.addEventListener('click', () => {
      const on = tg.getAttribute('aria-pressed') !== 'true';
      tg.setAttribute('aria-pressed', on ? 'true' : 'false');
      chart?.classList.toggle('pl-off', !on);
    });

    if (!RM) {
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          update();
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      let rw: number | undefined;
      window.addEventListener('resize', () => {
        window.clearTimeout(rw);
        rw = window.setTimeout(pick, 150);
      });
      pick();
    }
  }

  /* ---------------- Einblenden, Punktfelder, Balken ---------------- */
  const targets = document.querySelectorAll<HTMLElement>('[data-rv], [data-dots], [data-cal], [data-week], [data-diff], [data-ep]');
  if (!RM && 'IntersectionObserver' in window) {
    const seen = (es: IntersectionObserverEntry[]) => {
      es.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    };
    const io = new IntersectionObserver(seen, { rootMargin: '0px 0px -12% 0px', threshold: 0.15 });
    targets.forEach((t) => io.observe(t));
  } else {
    targets.forEach((t) => t.classList.add('in'));
  }

  /* ---------------- Proteinregler ---------------- */
  const kg = document.querySelector<HTMLInputElement>('[data-kg]');
  const kgv = document.querySelector<HTMLElement>('[data-kgv]');
  const pg = document.querySelector<HTMLOutputElement>('[data-pg]');
  kg?.addEventListener('input', () => {
    const v = Number(kg.value);
    if (kgv) kgv.textContent = `${v} kg`;
    if (pg) pg.textContent = `${Math.round(v * 1.2)} g Protein am Tag`;
  });
</script>

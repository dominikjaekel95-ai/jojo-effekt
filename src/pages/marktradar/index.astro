---
/**
 * /marktradar/: Zulassungen, Markt, Preise, Kassenregeln, Lieferbarkeit, Studien. Daten nur aus src/data/markt/*.json
 * und src/data/studien.ts. Einstiegsseite: Der Zeitstrahl der Einträge baut sich beim Scrollen auf (Linie wächst mit dem
 * Scroll-Fortschritt, Punkte füllen sich), Filter nach Typ; die Preise zeichnen sich als Balken. Ohne JavaScript oder mit
 * reduzierter Bewegung steht alles sofort da, der Filter bleibt dann ausgeblendet.
 */
import Base from '../../layouts/Base.astro';
import SeitenKopf from '../../components/SeitenKopf.astro';
import PreisBalken from '../../components/PreisBalken.astro';
import GrafikDaten from '../../components/GrafikDaten.astro';
import GrafikHochformat from '../../components/GrafikHochformat.astro';
import GrafikEinbinden from '../../components/GrafikEinbinden.astro';
import { site } from '../../data/site';
import { radar, radarTypeLabel, radarLastmod, zulassungen, preise, kassen, lieferbarkeit, fmtDate, type RadarType } from '../../data/markt';
import { studien, studienLog, studienUpdated } from '../../data/studien';
import { sources } from '../../data/sources';

const title = 'Marktradar Abnehmspritze: Zulassungen, Preise, Lieferbarkeit';
const description =
  'Was sich bei Abnehmspritze und Abnehmtablette ändert: Zulassungen, Marktstarts, Preise, Kassenregeln, Lieferbarkeit und neue Studien. Mit Datum und Quelle.';
const stand = radarLastmod();
const neueStudien = studien.slice(0, 4);
const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${site.url}/marktradar/#page`,
    name: title,
    description,
    url: `${site.url}/marktradar/`,
    inLanguage: 'de-DE',
    dateModified: new Date(stand).toISOString(),
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: {
      '@type': 'ItemList',
      itemListOrder: 'https://schema.org/ItemListOrderDescending',
      numberOfItems: radar.eintraege.length,
      itemListElement: radar.eintraege.map((e, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: { '@type': 'Thing', name: e.title, description: e.summary, url: `${site.url}/marktradar/#${e.id}` },
      })),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Marktradar', item: `${site.url}/marktradar/` },
    ],
  },
];

// Zeitstrahl: Einträge nach Jahr gruppiert (neueste zuerst), Filter nur für Typen, die vorkommen
const jahre = [...new Set(radar.eintraege.map((e) => e.date.slice(0, 4)))];
const typen = (Object.keys(radarTypeLabel) as RadarType[])
  .map((t) => ({ t, n: radar.eintraege.filter((e) => e.type === t).length }))
  .filter((x) => x.n > 0);
// Zahl und Einheit nicht trennen („490 €“)
const nb = (t: string) => t.replace(/(\d) ([€%])/g, '$1\u00a0$2');
const tag = (d: string) => new Date(d).toLocaleDateString('de-DE', { day: 'numeric', month: 'long' });

// Kennzahlen oben, alle aus den JSON-Daten
const zugelassen = zulassungen.praeparate.filter((p) => !/^keine/i.test(p.eu)).length;
const preisWerte = preise.zeilen.map((z) => Number(String(z.monat).replace(/[^0-9]/g, ''))).filter((n) => n > 0);
const preisMin = Math.min(...preisWerte);
const preisMax = Math.max(...preisWerte);
const aeltester = radar.eintraege.at(-1)?.date ?? stand;
const seit = new Date(aeltester).toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });
---
<Base title={title} description={description} path="/marktradar/" jsonLd={jsonLd} modifiedTime={new Date(stand).toISOString()}>
  <SeitenKopf crumbs={[{ href: '/', label: 'Start' }, { label: 'Marktradar' }]} meta={`Marktradar, Stand ${fmtDate(stand)}`} title="Was sich bei Abnehmspritze und Abnehmtablette gerade ändert">
    <p>Zulassungen, Marktstarts, Preise als Größenordnung, Kassenregeln, Lieferbarkeit und neue Studien. Jeder Eintrag hat ein Datum und eine Quelle. Was wir nicht liefern: Bezugsquellen, Preisvergleiche, Empfehlungen für oder gegen ein Präparat.</p>
  </SeitenKopf>

  <div class="container-wide k-end">
    <div class="k-facts">
      <div class="k-fact" data-rv>
        <p class="k-num"><span data-count={radar.eintraege.length}>{radar.eintraege.length}</span></p>
        <p>geprüfte Einträge seit {seit}, jeder mit Datum und Quelle. <a href="#eintraege">Zum Zeitstrahl</a></p>
      </div>
      <div class="k-fact" data-rv style="--i:1">
        <p class="k-num"><span data-count={zugelassen}>{zugelassen}</span></p>
        <p>Präparate mit EU-Zulassung in der Übersicht, Stand {fmtDate(zulassungen.stand)}. <a href="#zulassungen">Zur Tabelle</a></p>
      </div>
      <div class="k-fact" data-rv style="--i:2">
        <p class="k-num"><span data-count={preisMin}>{preisMin}</span>–<span data-count={preisMax}>{preisMax}</span><small>€</small></p>
        <p>Selbstzahlerpreis im Monat, als Größenordnung, Stand {fmtDate(preise.stand)}. <a href="#preise">Zu den Preisen</a></p>
      </div>
    </div>

    <nav aria-label="Abschnitte" class="k-jump">
      <a href="#eintraege">Zuletzt</a>
      <a href="#zulassungen">Zulassungen</a>
      <a href="#lieferbarkeit">Lieferbarkeit</a>
      <a href="#preise">Preise</a>
      <a href="#kassen">Kassenregeln</a>
      <a href="#studien">Studien</a>
    </nav>

    <!-- Zuletzt: Zeitstrahl -->
    <section id="eintraege" class="k-sec scroll-mt-24" aria-labelledby="eintraege-h">
      <div class="tl-head">
        <h2 id="eintraege-h" class="k-h2">Zuletzt</h2>
        <div class="k-filter mr-filter" role="group" aria-label="Einträge nach Typ filtern" data-filter hidden>
          <button type="button" aria-pressed="true" data-typ="alle">Alle <span class="n">{radar.eintraege.length}</span></button>
          {typen.map(({ t, n }) => (<button type="button" aria-pressed="false" data-typ={t}>{radarTypeLabel[t]} <span class="n">{n}</span></button>))}
        </div>
      </div>
      <p class="sr-only" aria-live="polite" data-filter-status></p>

      <div class="tl" data-progress>
        <span class="tl-line" aria-hidden="true"><span></span></span>
        {jahre.map((jahr) => (
          <div class="tl-year" data-jahr={jahr}>
            <p class="tl-y" aria-hidden="true">{jahr}</p>
            <ol class="tl-list">
              {radar.eintraege.filter((e) => e.date.startsWith(jahr)).map((e) => (
                <li id={e.id} class="tl-e scroll-mt-24" data-typ={e.type} data-rv>
                  <div class="tl-when">
                    <time datetime={e.date}>{tag(e.date)} {jahr}</time>
                    <span class="tl-typ">{radarTypeLabel[e.type]}</span>
                    {e.substances && e.substances.length > 0 && (<span class="tl-sub">{e.substances.join(' · ')}</span>)}
                  </div>
                  <span class="tl-dot" aria-hidden="true"></span>
                  <div class="tl-body">
                    <h3 class="tl-t">{nb(e.title)}</h3>
                    <p class="tl-s">{nb(e.summary)}</p>
                    <p class="tl-q">
                      Quelle: <a href={e.source.url} rel="noopener nofollow" target="_blank">{e.source.name}</a>
                      {e.links && e.links.length > 0 && (<span> · {e.links.map((l, i) => (<><a href={l.href} class="tl-in">{l.label}</a>{i < e.links!.length - 1 ? ' · ' : ''}</>))}</span>)}
                    </p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
      <p class="k-note">Als Feed: <a href="/marktradar/feed.xml">/marktradar/feed.xml</a></p>
    </section>

    <!-- Zulassungen -->
    <section id="zulassungen" class="k-sec scroll-mt-24" aria-labelledby="zulassungen-h">
      <h2 id="zulassungen-h" class="k-h2" data-rv>Zulassungen in der EU</h2>
      <p class="k-intro" data-rv>Stand {fmtDate(zulassungen.stand)}. Quelle: {zulassungen.quelle}. Indikationen verkürzt; verbindlich ist die Fachinformation.</p>
      <div class="mt-8" data-rv>
        <table class="k-table k-stack">
          <thead>
            <tr><th scope="col">Präparat</th><th scope="col">Wirkstoff</th><th scope="col">Form</th><th scope="col">Indikation</th><th scope="col">EU-Zulassung</th><th scope="col">Deutschland</th></tr>
          </thead>
          <tbody>
            {zulassungen.praeparate.map((p) => (
              <tr>
                <th scope="row">{p.name} <span class="k-sub">{p.hersteller}</span></th>
                <td data-label="Wirkstoff">{p.wirkstoff}</td>
                <td data-label="Form">{p.form}</td>
                <td data-label="Indikation">{p.indikation}</td>
                <td data-label="EU-Zulassung">{p.eu}</td>
                <td data-label="Deutschland">{p.de}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Lieferbarkeit -->
    <section id="lieferbarkeit" class="k-sec scroll-mt-24" aria-labelledby="lieferbarkeit-h">
      <h2 id="lieferbarkeit-h" class="k-h2" data-rv>Lieferbarkeit</h2>
      {lieferbarkeit.manuell && (
        <div class="lf-man" data-rv>
          <p class="lf-stand">Geprüfter Stand {fmtDate(lieferbarkeit.manuell.stand)}</p>
          <p class="lf-text">{lieferbarkeit.manuell.text}</p>
          {lieferbarkeit.manuell.quelle && (<p class="k-note">Quelle: <a href={lieferbarkeit.manuell.quelle.url} rel="noopener nofollow" target="_blank">{lieferbarkeit.manuell.quelle.name}</a></p>)}
        </div>
      )}
      <p class="k-intro" data-rv>
        Automatischer Abruf: {lieferbarkeit.stand ? `zuletzt am ${fmtDate(lieferbarkeit.stand)}` : 'noch keiner'} · Quelle: <a href={lieferbarkeit.quelle.url} rel="noopener nofollow" target="_blank">{lieferbarkeit.quelle.name}</a> · Status: {lieferbarkeit.status}
      </p>
      <div class="k-facts lf-grid">
        {lieferbarkeit.wirkstoffe.map((w, i) => (
          <div class="k-fact" data-rv style={`--i:${i}`}>
            <p class="lf-w">{w.wirkstoff}</p>
            <p>{w.treffer === null ? 'Noch nicht automatisch geprüft.' : w.treffer === 0 ? 'Keine Meldung auf der Übersichtsseite der Datenbank gefunden.' : `${w.treffer} Fundstelle${w.treffer === 1 ? '' : 'n'} auf der Übersichtsseite der Datenbank.`}</p>
            {w.zeilen.length > 0 && (<ul class="lf-z">{w.zeilen.slice(0, 3).map((z) => (<li>{z}</li>))}</ul>)}
          </div>
        ))}
      </div>
      <p class="k-note">{lieferbarkeit.hinweis} Was bei einem Engpass für die Zeit ohne Medikament gilt, steht unter <a href="/wissen/abnehmspritze-absetzen/">Abnehmspritze absetzen</a>.</p>
    </section>

    <!-- Preise -->
    <section id="preise" class="k-sec scroll-mt-24" aria-labelledby="preise-h">
      <h2 id="preise-h" class="k-h2" data-rv>Preise als Größenordnung</h2>
      <p class="k-intro" data-rv>Stand {fmtDate(preise.stand)}. {preise.hinweis} Jahreskosten je Präparat, Kassenregeln und Methodik stehen zitierfähig unter <a href="/abnehmspritze-kosten/">Abnehmspritze: Kosten pro Monat und Jahr</a>.</p>
      <PreisBalken />
      <p class="k-note">Quelle: {preise.quelle.replace(/\.$/, '')}.</p>
      <figure class="mr-fig" data-rv>
        <picture><GrafikHochformat id="preise-im-monat" /><img src="/grafiken/preise-im-monat.png" alt={`Balkendiagramm der monatlichen Selbstzahlerpreise als Größenordnung, Stand ${fmtDate(preise.stand)}: ${preise.zeilen.map((z) => `${z.praeparat} ${z.monat}`).join('; ')}.`} width="1200" height="675" loading="lazy" /></picture>
        <figcaption>
          <p>Dieselben Zahlen als Grafik, Stand {fmtDate(preise.stand)}; wird mit jeder Preiserhebung neu erzeugt. Frei verwendbar mit Quellenangabe, alle Grafiken unter <a href="/grafiken/" class="k-a">Grafiken</a>.</p>
          <GrafikDaten id="preise-im-monat" class="mt-3" />
        </figcaption>
      </figure>
    </section>

    <!-- Kassen -->
    <section id="kassen" class="k-sec scroll-mt-24" aria-labelledby="kassen-h">
      <h2 id="kassen-h" class="k-h2" data-rv>Kassenregeln</h2>
      <p class="k-intro" data-rv>Stand {fmtDate(kassen.stand)}. Keine Rechtsberatung; im Einzelfall entscheiden Kasse, Versicherer und gegebenenfalls Gerichte.</p>
      <dl class="mr-dl">
        {kassen.regeln.map((r, i) => (
          <div class="k-pair" data-rv style={`--i:${i}`}><dt>{r.gruppe}</dt><dd>{r.regel}</dd></div>
        ))}
      </dl>
      <p class="k-note">
        Quellen: {kassen.quellen.map((q, i) => (<>{q.url ? (<a href={q.url} rel="noopener nofollow" target="_blank">{q.name}</a>) : q.name}{i < kassen.quellen.length - 1 ? ' · ' : ''}</>))}
      </p>
    </section>

    <!-- Studien -->
    <section id="studien" class="k-sec scroll-mt-24" aria-labelledby="studien-h">
      <h2 id="studien-h" class="k-h2" data-rv>Neue Studien</h2>
      <p class="k-intro" data-rv>Der <a href="/wissen/studien/">Studien-Tracker</a> führt alle Studien zum Absetzen mit Kernzahl und Link. Stand {fmtDate(studienUpdated)}.</p>
      <ul class="k-rows k-cols-2 mr-st">
        {neueStudien.map((s, i) => (
          <li data-rv style={`--i:${i}`}>
            <div class="k-row">
              <p class="k-row-k">{s.gruppe} · {s.jahr} · {s.wirkstoff}</p>
              <p class="k-row-t">{s.name}</p>
              <p class="k-row-d">{s.kernzahl}</p>
              {sources[s.sourceId]?.url && (<p class="k-row-d"><a href={sources[s.sourceId].url} rel="noopener nofollow" target="_blank" class="k-q">{sources[s.sourceId].short}</a></p>)}
            </div>
          </li>
        ))}
      </ul>
      <ul class="mr-log">
        {studienLog.slice(0, 3).map((l) => (<li><time datetime={l.date}>{fmtDate(l.date)}</time><span>{l.text}</span></li>))}
      </ul>
    </section>

    <section class="k-sec mr-pflege" aria-labelledby="pflege-h" data-rv>
      <h2 id="pflege-h" class="k-h3">Wie der Marktradar gepflegt wird</h2>
      <p class="k-intro">
        Lieferbarkeit wird montags automatisch aus der BfArM-Datenbank abgerufen; neue Studien und Behördenmeldungen werden
        automatisch gesammelt und erst nach Prüfung der Originalquelle als Eintrag veröffentlicht. Preise und Kassenregeln
        werden von Hand geprüft und tragen das Datum der letzten Prüfung. Fehler oder Ergänzungen: <a href={`mailto:${site.owner.email}`}>{site.owner.email}</a>. Begriffe erklärt das <a href="/glossar/">Glossar</a>.
      </p>
    </section>
  </div>
  <GrafikEinbinden />
</Base>

<script>
  import { beobachte } from '../../lib/bewegung';
  const box = document.querySelector<HTMLElement>('[data-filter]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  const eintraege = Array.from(document.querySelectorAll<HTMLElement>('.tl-e'));
  const jahre = Array.from(document.querySelectorAll<HTMLElement>('.tl-year'));
  if (box) {
    box.hidden = false;
    const knoepfe = Array.from(box.querySelectorAll<HTMLButtonElement>('button'));
    knoepfe.forEach((b) =>
      b.addEventListener('click', () => {
        const typ = b.dataset.typ ?? 'alle';
        knoepfe.forEach((k) => k.setAttribute('aria-pressed', String(k === b)));
        let n = 0;
        eintraege.forEach((e) => {
          const an = typ === 'alle' || e.dataset.typ === typ;
          if (an) n++;
          if (an && e.hidden) {
            e.hidden = false;
            e.classList.remove('in');
          }
          if (!an) e.hidden = true;
        });
        jahre.forEach((j) => (j.hidden = !j.querySelector('.tl-e:not([hidden])')));
        if (status) status.textContent = `${n} ${n === 1 ? 'Eintrag' : 'Einträge'}`;
        requestAnimationFrame(() => beobachte());
        window.dispatchEvent(new Event('resize'));
      }),
    );
  }
</script>

<style>
  .k-fact a {
    white-space: nowrap;
  }
  /* ---------- Zeitstrahl ---------- */
  .tl-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
  .mr-filter {
    margin-top: 0;
  }
  .tl {
    --col: 9.5rem;
    --gap: 1.5rem;
    position: relative;
    margin-top: 2.25rem;
    padding-top: 0.5rem;
  }
  .tl-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 5px;
    width: 1px;
    background: var(--color-line);
  }
  .tl-line span {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    transform-origin: top;
    transform: scaleY(var(--p, 1));
  }
  :global(html.js:not(.rm)) .tl-line span {
    transform: scaleY(var(--p, 0));
  }
  .tl-y {
    position: relative;
    margin: 1.75rem 0 0.25rem 2rem;
    font-stretch: 125%;
    font-weight: 470;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--color-ink);
  }
  .tl-year:first-of-type .tl-y {
    margin-top: 0;
  }
  .tl-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tl-e {
    position: relative;
    display: grid;
    grid-template-columns: 11px minmax(0, 1fr);
    grid-template-areas: "dot when" ". body";
    column-gap: calc(2rem - 11px);
    padding: 1.5rem 0;
  }
  .tl-when {
    grid-area: when;
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-ink-3);
  }
  .tl-when time {
    color: var(--color-ink);
    font-weight: 520;
  }
  .tl-dot {
    grid-area: dot;
    align-self: start;
    margin-top: 0.3rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-ink);
    box-shadow: 0 0 0 4px var(--color-paper);
    transition: background-color 0.5s var(--ease) 0.25s, transform 0.5s var(--ease) 0.25s;
  }
  :global(html.js:not(.rm)) .tl-e:not(.in) .tl-dot {
    background: var(--color-paper);
    box-shadow: 0 0 0 4px var(--color-paper), inset 0 0 0 1.5px var(--color-ink);
    transform: scale(0.7);
  }
  .tl-body {
    grid-area: body;
    margin-top: 0.6rem;
  }
  .tl-t {
    font-size: clamp(1.1875rem, 1.9vw, 1.5rem);
    font-stretch: 112%;
    font-weight: 520;
    letter-spacing: -0.012em;
    line-height: 1.22;
    color: var(--color-ink);
    max-width: 30em;
  }
  .tl-s {
    margin-top: 0.6rem;
    color: var(--color-ink-2);
    max-width: 42em;
  }
  .tl-q {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-ink-3);
  }
  .tl-q a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .tl-q a.tl-in {
    color: var(--color-moss);
  }
  @media (min-width: 900px) {
    .tl-line {
      left: calc(var(--col) + var(--gap) + 5px);
    }
    .tl-y {
      width: var(--col);
      margin: 3rem 0 0.5rem;
    }
    .tl-e {
      grid-template-columns: var(--col) 11px minmax(0, 1fr);
      grid-template-areas: "when dot body";
      column-gap: var(--gap);
      padding: 1.6rem 0;
    }
    .tl-when {
      flex-direction: column;
    }
    .tl-body {
      margin-top: 0;
    }
    .tl-dot {
      margin-top: 0.5rem;
    }
  }

  /* ---------- Lieferbarkeit ---------- */
  .lf-man {
    margin-top: 2rem;
    max-width: 44em;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-ink);
  }
  .lf-stand {
    font-size: 0.875rem;
    color: var(--color-ink-3);
  }
  .lf-text {
    margin-top: 0.5rem;
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--color-ink);
  }
  .lf-grid {
    margin-top: 2.5rem;
  }
  .lf-w {
    font-stretch: 118%;
    font-weight: 500;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .lf-z {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    list-style: none;
    padding: 0;
  }

  /* ---------- Preise: Grafik neben der Bildunterschrift ---------- */
  .mr-fig {
    display: grid;
    gap: 1.25rem 2.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .mr-fig img {
    width: 100%;
    height: auto;
    border-radius: 14px;
    border: 1px solid var(--color-line);
    background: #fff;
  }
  .mr-fig figcaption {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-ink-3);
  }
  @media (min-width: 900px) {
    .mr-fig {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: start;
    }
  }

  /* ---------- Kassen ---------- */
  .mr-dl {
    margin-top: 2rem;
    border-top: 1px solid var(--color-ink);

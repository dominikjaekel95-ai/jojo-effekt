---
/**
 * Primärer Call-to-Action: führt zur Warteliste auf der Startseite. Klick wird per Plausible-Klasse als Event gezählt.
 */
interface Props { position: string; label?: string; class?: string; secondary?: boolean }
const { position, label = 'Auf die Warteliste', class: cls = '', secondary = false } = Astro.props;
---
<a
  href="/#warteliste"
  class={`${secondary ? 'btn-secondary' : 'btn-primary'} plausible-event-name=Warteliste+Klick plausible-event-position=${position} ${cls}`}
>{label}</a>

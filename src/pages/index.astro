---
/**
 * Startseite „Kalk“ (seit 06.10.2026): 12-Wochen-Programm, Ziel Warteliste. Keine Markennamen von Arzneimitteln
 * (check:text), kein Arztbezug beim Programm, keine Health Claims. Jede Zahl mit Fußnote aus src/data/sources.ts.
 * Die Absetzkurve zeichnet sich beim Scrollen (Skript unten); ohne Skript oder mit reduzierter Bewegung steht der
 * Endzustand da.
 */
import Base from '../layouts/Base.astro';
import Fn from '../components/Fn.astro';
import Footnotes from '../components/Footnotes.astro';
import Faq from '../components/Faq.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import Absetzkurve from '../components/Absetzkurve.astro';
import MarktradarTeaser from '../components/MarktradarTeaser.astro';
import ErnaehrungsplanTeaser from '../components/ErnaehrungsplanTeaser.astro';
import { site } from '../data/site';
import { themen } from '../data/themen';
import { landingFaq } from '../data/faq';
import { getCollection } from 'astro:content';

// Reihenfolge der Fußnoten auf dieser Seite (Nummer = Position + 1), in der Reihenfolge der ersten Nennung
const fnIds = [
  'wilding2022ext',
  'wu2025',
  'wilding2021dxa',
  'rodriguez2025',
  'sardeli2018',
  'who2020',
  'leidy2015',
  'dgeProtein',
  'jensen2024',
  'bls',
] as const;
const fn = (id: (typeof fnIds)[number]) => fnIds.indexOf(id) + 1;

const artikel = (await getCollection('wissen', (a) => !a.data.draft)).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const werkzeuge = [
  { href: '/werkzeuge/zeitplan-nach-letzter-dosis/', name: 'Zeitplan nach der letzten Dosis' },
  { href: '/werkzeuge/proteinrechner/', name: 'Proteinrechner' },
  { href: '/werkzeuge/gewichtskorridor/', name: 'Gewichtskorridor' },
  { href: '/checkliste/', name: 'Checkliste für die ersten 8 Wochen' },
  { href: '/werkzeuge/', name: 'Alle Werkzeuge' },
];

// 100 Punkte, davon 65 hervorgehoben (rodriguez2025: 64,8 %, gerundet)
const dots = Array.from({ length: 100 }, (_, i) => i < 65);
// 12 Wochen × 7 Tage: Krafteinheit an Tag 2 und 5, Check-in an Tag 7
const tagTyp = (d: number) => (d === 1 || d === 4 ? 'tr' : d === 6 ? 'ci' : '');
const wochen = Array.from({ length: 12 }, () => Array.from({ length: 7 }, (_, d) => tagTyp(d)));

const kurveLabel = 'Liniendiagramm, schematisch zwischen den Messpunkten: Unter Semaglutid sinkt das Gewicht in 68 Wochen im Mittel um 17,3 Prozent, unter Placebo um 2,0 Prozent. Nach der letzten Dosis in Woche 68 steigt es wieder; in Woche 120 liegt es bei minus 5,6 Prozent, unter Placebo bei minus 0,1 Prozent. Zwei Drittel des Verlusts sind zurück. Rund 40 Prozent des verlorenen Gewichts waren fettfreie Masse.';
const kontakt = `mailto:${site.owner.email}?subject=${encodeURIComponent('Nach der Spritze: meine Frage')}`;
const pfeil = 'M2 9h13M10 4l5 5-5 5';

const title = 'Nach der Abnehmspritze: Muskeln behalten, Gewicht halten';
const description = site.description;
const jsonLd: Record<string, unknown>[] = [];
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <!-- ============ 1. HERO ============ -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="container-wide hero-grid">
      <h1 id="hero-h" class="hero-h1"><span class="h1a">Nach der Spritze:</span> <span class="h1b">Muskeln behalten, Gewicht halten.</span></h1>
      <div>
        <p class="lede" data-hv style="--i:2">Das 12-Wochen-Programm für die Zeit nach der Abnehmspritze. Studienbasiert: Krafttraining, genug Protein und ein klarer Plan, um das eigene Gewicht gezielt im Blick zu behalten. Für alle, die das Erreichte halten wollen.</p>
        <div class="hero-form" data-hv style="--i:3">
          <WaitlistForm position="hero" />
        </div>
        <p class="doc" data-hv style="--i:4">{site.doctorSentence}</p>
      </div>
      <div class="hnum" data-hv style="--i:3">
        <p class="frac num" role="img" aria-label="Zwei Drittel"><span aria-hidden="true">2</span><span class="sl" aria-hidden="true">/</span><span aria-hidden="true">3</span><span class="frac-hl" aria-hidden="true"></span></p>
        <p class="hnum-t">des verlorenen Gewichts waren ein Jahr nach dem Absetzen im Mittel wieder da.<Fn n={fn('wilding2022ext')} id="wilding2022ext" /></p>
        <a class="go" href="#kurve">Wie es dazu kommt <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1v12M2 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></a>
      </div>
    </div>
  </section>

  <!-- ============ 2. ABSETZKURVE (klebende Bühne) ============ -->
  <section class="story" id="kurve" aria-labelledby="kurve-h" data-kurve>
    <div class="stage">
      <div class="caps">
        <h2 id="kurve-h" class="sr-only">Was nach der letzten Dosis passiert</h2>
        <div class="cap on" data-step="0"><p class="k num">1 / 4 · Unter der Spritze</p><h3>68 Wochen mit Semaglutid: im Mittel −17,3 %.</h3><p>So viel verloren die Teilnehmenden der STEP-1-Verlängerung bis zur letzten Dosis. Unter Placebo waren es −2,0 %.<Fn n={fn('wilding2022ext')} id="wilding2022ext" /></p></div>
        <div class="cap" data-step="1"><p class="k num">2 / 4 · Woche 68</p><h3>Dann die letzte Dosis.</h3><p>Der Wirkstoff baut sich ab, der Appetit kommt zurück. In Studien wird die Zunahme etwa ab der achten Woche nach der letzten Dosis messbar.<Fn n={fn('wu2025')} id="wu2025" /></p></div>
        <div class="cap" data-step="2"><p class="k num">3 / 4 · Ein Jahr später</p><h3>Zwei Drittel sind zurück.</h3><p>Nach einem Jahr ohne Medikament lag das Gewicht im Mittel bei −5,6 %, unter Placebo bei −0,1 %. Zwei Drittel des Verlusts waren wieder da.<Fn n={fn('wilding2022ext')} id="wilding2022ext" /></p></div>
        <div class="cap" data-step="3"><p class="k num">4 / 4 · Was verloren ging</p><h3>Und nicht alles davon war Fett.</h3><p>In einer Substudie waren rund 40 % des verlorenen Gewichts fettfreie Masse, darunter Muskeln.<Fn n={fn('wilding2021dxa')} id="wilding2021dxa" /> Deshalb setzt das Programm bei Krafttraining und Protein an.</p></div>
        <div class="rail" aria-hidden="true"><i class="on"></i><i></i><i></i><i></i></div>
      </div>
      <div class="chart" data-chart>
        <div class="ctl"><button class="tgl" type="button" aria-pressed="true" data-placebo><i aria-hidden="true"></i>Placebo</button></div>
        <div class="chart-box">
          <Absetzkurve variant="d" label={kurveLabel} />
          <Absetzkurve variant="m" label={kurveLabel} />
        </div>
      </div>
      <p class="src">Messpunkte aus der STEP-1-Verlängerung,<Fn n={fn('wilding2022ext')} id="wilding2022ext" /> Linien dazwischen schematisch. Körperzusammensetzung aus der DXA-Substudie.<Fn n={fn('wilding2021dxa')} id="wilding2021dxa" /> Mehr dazu: <a href="/wissen/abnehmspritze-absetzen/">Abnehmspritze absetzen</a></p>
    </div>
  </section>

  <!-- ============ 3. 65 VON 100 ============ -->
  <section class="sec s-a" aria-labelledby="h-65">
    <div class="container-wide people">
      <div>
        <h2 id="h-65" class="sr-only">Die meisten setzen ab</h2>
        <p class="pbig num" data-rv>65<small>%</small></p>
        <p class="intro" data-rv style="--i:1">der Menschen ohne Typ-2-Diabetes setzen die Abnehmspritze innerhalb eines Jahres wieder ab.<Fn n={fn('rodriguez2025')} id="rodriguez2025" /> Die Zeit danach ist für die meisten keine Ausnahme, sondern der Normalfall.</p>
      </div>
      <div>
        <div class="dots" data-dots role="img" aria-label="65 von 100 Punkten sind hervorgehoben.">{dots.map((on, i) => (<i class={on ? 'on' : undefined} style={on ? `--d:${i * 16}ms` : undefined}></i>))}</div>
        <p class="dots-cap">Ein Punkt steht für einen Menschen.</p>
      </div>
    </div>
  </section>

  <!-- ============ 4. WAS HILFT ============ -->
  <section class="sec" id="hebel" aria-labelledby="h-help">
    <div class="container-wide">
      <h2 id="h-help" class="sec-h" data-rv>Was in Studien den Unterschied macht.</h2>
      <p class="intro" data-rv style="--i:1">Kein Trick, kein Präparat. Drei Dinge, die sich in Studien immer wieder zeigen.</p>
      <div class="help">
        <div data-rv>
          <p class="help-n num">2<small>× pro Woche</small></p>
          <h3 class="help-t">Krafttraining</h3>
          <p class="help-p">Krafttraining während einer Kalorienreduktion verhinderte in einer Meta-Analyse den Verlust an fettfreier Masse weitgehend.<Fn n={fn('sardeli2018')} id="sardeli2018" /> Die WHO empfiehlt muskelkräftigende Aktivität an mindestens zwei Tagen pro Woche.<Fn n={fn('who2020')} id="who2020" /></p>
          <div class="week" data-week aria-hidden="true"><span>Mo</span><span>Di</span><span>Mi</span><span>Do</span><span>Fr</span><span>Sa</span><span>So</span><i></i><i class="tr"></i><i></i><i></i><i class="tr"></i><i></i><i></i></div>
          <p class="help-f">Zwei Einheiten à 30 Minuten, zum Beispiel dienstags und freitags.</p>
        </div>
        <div data-rv style="--i:1">
          <p class="help-n num">1,2<small>g pro kg</small></p>
          <h3 class="help-t">Protein am Tag</h3>
          <p class="help-p">Übersichtsarbeiten empfehlen beim Abnehmen und beim Halten des Gewichts 1,2 bis 1,6 g pro kg Körpergewicht,<Fn n={fn('leidy2015')} id="leidy2015" /> deutlich mehr als die 0,8 g, die die DGE für Erwachsene ansetzt.<Fn n={fn('dgeProtein')} id="dgeProtein" /></p>
          <div class="calc">
            <label for="kg"><span>Dein Gewicht</span><span class="num" data-kgv>80 kg</span></label>
            <input id="kg" type="range" min="50" max="150" step="1" value="80" data-kg />
            <p class="calc-out"><output for="kg" class="num" data-pg>96 g Protein am Tag</output></p>
            <p class="help-f">Eigene Rechnung mit 1,2 g pro kg. Genauer mit dem <a href="/werkzeuge/proteinrechner/">Proteinrechner</a>.</p>
          </div>
        </div>
        <div data-rv style="--i:2">
          <p class="help-n num">6<small>kg</small></p>
          <h3 class="help-t">Unterschied nach einem Jahr</h3>
          <p class="help-p">In der S-LiTE-Studie hielten Teilnehmende, die während der Therapie trainiert hatten, ihr Gewicht ein Jahr nach Therapieende. Wer nur das Medikament bekommen hatte, nahm im Schnitt 6,0 kg mehr wieder zu als die Trainingsgruppe.<Fn n={fn('jensen2024')} id="jensen2024" /></p>
          <figure class="diff" data-diff>
            <svg viewBox="0 0 320 64" width="320" height="64" role="img" aria-label="Mehr Wiederzunahme nach dem Medikament allein als nach Training allein: 6,0 Kilogramm, 95-Prozent-Konfidenzintervall 2,1 bis 10,0 Kilogramm.">
              <line class="diff-ax" x1="10" x2="310" y1="40" y2="40" />
              {[0, 2, 4, 6, 8, 10].map((k) => (<g><line class="diff-ax" x1={10 + k * 30} x2={10 + k * 30} y1="40" y2="44" /><text x={10 + k * 30} y="58" text-anchor="middle">{k}</text></g>))}
              <line class="diff-ci" x1={10 + 2.1 * 30} x2={10 + 10 * 30} y1="20" y2="20" />
              <line class="diff-ci" x1={10 + 2.1 * 30} x2={10 + 2.1 * 30} y1="15" y2="25" />
              <line class="diff-ci" x1={10 + 10 * 30} x2={10 + 10 * 30} y1="15" y2="25" />
              <rect class="diff-bar" x="10" y="14" width={6 * 30} height="12" rx="2" />
              <circle class="diff-dot" cx={10 + 6 * 30} cy="20" r="4" />
            </svg>
            <figcaption class="help-f">Mehr Wiederzunahme nach dem Medikament allein, verglichen mit Training allein, in kg. Linie: 95-%-Konfidenzintervall 2,1 bis 10,0 kg.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 5. PROGRAMM ============ -->
  <section class="sec s-a" id="programm" aria-labelledby="h-prog">
    <div class="container-wide">
      <h2 id="h-prog" class="sec-h" data-rv>Zwölf Wochen. Ein Plan für die Zeit danach.</h2>
      <p class="intro" data-rv style="--i:1">Das Programm macht aus den Studien einen Plan für jede Woche. Eine eigene Studie zum Programm gibt es nicht.</p>
      <div class="prog">
        <div>
          <div class="cal" data-cal role="img" aria-label="Zwölf Wochen mit je sieben Tagen, davon zwei Krafteinheiten und ein Check-in pro Woche.">
            {wochen.map((w, wi) => (<div class="wk">{w.map((typ, di) => (<i class={typ || undefined} style={typ ? `--d:${wi * 110 + di * 40}ms` : undefined}></i>))}</div>))}
          </div>
          <div class="cal-l"><span>Woche 1</span><span>Woche 12</span></div>
          <div class="legend"><span><i></i>Krafteinheit, 30 Minuten</span><span><i class="c"></i>Check-in</span><span><i class="d"></i>Alltag</span></div>
        </div>
        <div class="feat">
          <div data-rv><h3>Krafttraining</h3><p>Zwei Einheiten pro Woche à 30 Minuten. Zuhause mit Bändern oder im Studio, für Einsteiger gemacht.</p></div>
          <div data-rv style="--i:1"><h3>Protein</h3><p>Dein Tagesziel in Gramm und Rezepte für kleine Portionen mit viel Protein.</p></div>
          <div data-rv style="--i:2"><h3>Die Waage</h3><p>Ein Gewichtskorridor statt Kalorienzählen, mit klaren Regeln, wann du gegensteuerst. Deinen Korridor kannst du schon jetzt <a href="/werkzeuge/gewichtskorridor/">berechnen</a>.</p></div>
          <div data-rv style="--i:3"><h3>Begleitung</h3><p>Ein Check-in pro Woche per E-Mail, mit Antworten auf deine Fragen. Orientierung, keine medizinische Beratung.</p></div>
        </div>
      </div>
      <p class="note" data-rv>84 Tage, 24 Krafteinheiten, 12 Check-ins. Was wir nicht sagen: dass das Programm die Spritze ersetzt oder den Jojo-Effekt verhindert. Das kann kein Programm versprechen.</p>
    </div>
  </section>

  <!-- ============ 6. WARTELISTE ============ -->
  <section class="sec band cta" id="warteliste" aria-labelledby="h-cta">
    <div class="container-wide cta-grid">
      <div>
        <h2 id="h-cta" class="cta-h" data-rv>Sei dabei, wenn es losgeht.</h2>
        <p class="intro band-muted" data-rv style="--i:1">Wir starten das Programm, sobald genug Menschen auf der Warteliste stehen. Bis dahin zahlst du nichts.</p>
      </div>
      <div data-rv style="--i:2">
        <WaitlistForm position="block" starterpaket dark micro="" />
        <p class="price">Basis-Programm geplant unter <strong>{site.price.programUnder} €</strong> für alle zwölf Wochen. Wer auf der Liste steht, erfährt Termin und Preis zuerst.</p>
      </div>
      <ol class="steps">
        <li><strong><span class="num">1</span> Eintragen</strong><span>Nur deine E-Mail-Adresse. Keine Zahlung.</span></li>
        <li><strong><span class="num">2</span> Bescheid bekommen</strong><span>Termin, Preis und Ablauf, bevor es losgeht.</span></li>
        <li><strong><span class="num">3</span> Entscheiden</strong><span>Erst dann meldest du dich an, oder du lässt es.</span></li>
      </ol>
      <p class="free">Fragen vorab? <a href={kontakt} class="plausible-event-name=Kontakt+Klick plausible-event-kanal=warteliste">Schreib uns an {site.owner.email}</a>. Wir antworten persönlich.</p>
    </div>
  </section>

  <!-- ============ 7. ERNÄHRUNGSPLAN (kostenlos) ============ -->
  <ErnaehrungsplanTeaser fnBls={fn('bls')} fnLeidy={fn('leidy2015')} />

  <!-- ============ 8. FÜR WEN ============ -->
  <section class="sec" id="fuer-wen" aria-labelledby="h-wen">
    <div class="container-wide">
      <h2 id="h-wen" class="sec-h" data-rv>Für wen das Programm gedacht ist.</h2>
      <div class="two">
        <div data-rv>
          <h3>Für dich, wenn du …</h3>
          <ul>
            <li>die Abnehmspritze absetzt, reduzierst oder das planst und dein Gewicht halten willst.</li>
            <li>unter der Spritze wenig gegessen hast und merkst, dass Kraft und Muskeln nachgelassen haben.</li>
            <li>einen einfachen Plan willst: zwei Einheiten pro Woche, ein Proteinziel, ein Check-in.</li>
            <li>keine Wunder erwartest, sondern etwas, das du zwölf Wochen durchhalten kannst.</li>
          </ul>
        </div>
        <div data-rv style="--i:1">
          <h3>Nicht für dich, wenn du …</h3>
          <ul>
            <li>schwanger bist, stillst oder unter 18 bist.</li>
            <li>eine Nierenerkrankung hast. Dann das Proteinziel nur nach Rücksprache mit deiner Ärztin oder deinem Arzt.</li>
            <li>eine Essstörung hast oder hattest. Bitte sprich zuerst mit deiner Behandlerin oder deinem Behandler.</li>
          </ul>
        </div>
      </div>
      <p class="says" data-rv>Das Programm ist keine Absetz-Anleitung und kein Ersatz für ärztliche Begleitung.</p>
    </div>
  </section>

  <!-- ============ 9. WISSEN ============ -->
  <section class="sec s-a" id="wissen" aria-labelledby="h-wissen">
    <div class="container-wide">
      <h2 id="h-wissen" class="sec-h" data-rv>Absetzen, Jojo-Effekt, Muskeln: die Fakten, mit Quellen.</h2>
      <p class="intro" data-rv style="--i:1">Was in Studien passiert, wenn die Spritze wegfällt, und was nachweislich hilft. Jede Zahl mit Link zur Originalstudie.</p>
      <div class="arts">
        {artikel.map((a, i) => (
          <a href={`/wissen/${a.id}/`} data-rv style={`--i:${i}`}><span class="c">{a.data.category}</span><span class="t">{a.data.title}</span><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d={pfeil} fill="none" stroke="currentColor" stroke-width="1.5" /></svg></a>
        ))}
      </div>
      <div class="more">
        <nav aria-label="Themen">
          <h3>Themen</h3>
          <ul>{themen.map((t) => (<li><a href={`/wissen/${t.slug}/`}>{t.name}</a></li>))}</ul>
        </nav>
        <nav aria-label="Werkzeuge">
          <h3>Werkzeuge</h3>
          <ul>{werkzeuge.map((w) => (<li><a href={w.href}>{w.name}</a></li>))}</ul>
        </nav>
        <nav aria-label="Nachschlagen">
          <h3>Nachschlagen</h3>
          <ul>
            <li><a href="/wissen/">Alle Artikel</a></li>
            <li><a href="/wissen/#praeparate">Nach Wirkstoff und Präparat</a></li>
            <li><a href="/wissen/studien/">Studien-Tracker</a></li>
            <li><a href="/glossar/">Glossar</a></li>
            <li><a href="/grafiken/">Grafiken</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </section>

  <!-- ============ 10. MARKTRADAR (Teaser ohne Markennamen, keine Affiliate-Links) ============ -->
  <MarktradarTeaser />

  <!-- ============ 11. FAQ und Quellen ============ -->
  <section class="sec faq-sec s-a" aria-label="Häufige Fragen und Quellen">
    <div class="container-narrow">
      <Faq items={landingFaq} />
      <p class="faq-k">Deine Frage ist nicht dabei? <a href={kontakt} class="plausible-event-name=Kontakt+Klick plausible-event-kanal=faq">Schreib uns</a>, wir antworten persönlich.</p>
      <Footnotes ids={fnIds} />
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero-grid {
    display: grid;
    gap: 2.75rem;
    padding-top: clamp(1.75rem, 7vh, 5.5rem);
    padding-bottom: clamp(2.25rem, 6vh, 4.5rem);
  }
  .hero-h1 {
    line-height: 0.98;
  }
  .h1a {
    display: block;
    font-size: clamp(1.375rem, 2.3vw, 2rem);
    font-stretch: 112%;
    font-weight: 480;
    color: var(--color-ink-2);
    letter-spacing: -0.01em;
    margin-bottom: 0.35em;
  }
  .h1b {
    display: block;
    font-size: clamp(2.6rem, 7vw, 6.5rem);
    letter-spacing: -0.025em;
  }
  .lede {
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    line-height: 1.5;
    color: var(--color-ink-2);
    max-width: 34em;
  }
  .hero-form {
    margin-top: 2rem;
  }
  .doc {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-ink-2);
    max-width: 34em;
  }
  .hnum {
    align-self: end;
  }
  .frac {
    position: relative;
    display: inline-block;
    font-stretch: 125%;
    font-weight: 460;
    font-size: clamp(6.5rem, 11vw, 10.5rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
    padding: 0 0.04em;
  }
  .frac span {
    position: relative;
    z-index: 1;
  }
  .frac .sl {
    font-weight: 300;
    color: var(--color-ink-2);
  }
  .frac .frac-hl {
    position: absolute;
    z-index: 0;
    left: 0.04em;
    right: 0.04em;
    bottom: -0.1em;
    height: 0.085em;
    border-radius: 0.04em;
    background: var(--color-amber);
    transform-origin: left;
  }
  .hnum-t {
    font-size: 1.0625rem;
    color: var(--color-ink-2);
    max-width: 19em;
    margin-top: 2.25rem;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.1rem;
    font-size: 0.9375rem;
    font-weight: 540;
    color: var(--color-ink);
    text-decoration: none;
  }
  .go svg {
    transition: transform 0.4s var(--ease);
  }
  .go:hover svg {
    transform: translateY(3px);
  }
  :global(html.js:not(.rm)) [data-hv] {
    opacity: 0;
    transform: translateY(16px);
    animation: hv 1.1s var(--ease) forwards;
    animation-delay: calc(120ms + var(--i, 0) * 110ms);
  }
  :global(html.js:not(.rm)) .frac-hl {
    transform: scaleX(0);
    animation: hl 1s var(--ease) 0.9s forwards;

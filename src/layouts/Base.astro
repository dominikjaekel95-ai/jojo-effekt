---
/**
 * Basis-Layout: <head> mit SEO-Metadaten, JSON-LD, Plausible (nur wenn konfiguriert), Header, Footer.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Canonical-Pfad, z. B. "/wissen/abnehmspritze-absetzen/" – Default: aktuelle URL */
  path?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Beliebige JSON-LD-Objekte; werden als @graph ausgegeben */
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  path,
  noindex = false,
  ogType = 'website',
  jsonLd = [],
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonical = new URL(path ?? Astro.url.pathname, Astro.site ?? site.url).toString();
const ogImage = new URL('/og-default.png', Astro.site ?? site.url).toString();
const fullTitle = title.includes(site.name) ? title : `${title} · ${site.name}`;

const graph = [
  {
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.name,
    url: site.url,
    logo: `${site.url}/favicon.svg`,
    founder: { '@type': 'Person', name: site.owner.name },
    address: { '@type': 'PostalAddress', addressLocality: site.owner.city, addressCountry: 'DE' },
  },
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    inLanguage: 'de-DE',
    publisher: { '@id': `${site.url}/#organization` },
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang={site.lang} data-theme={site.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#faf7f2" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })} />

    {/* Plausible: cookiefrei, EU-Hosting. Nur wenn PUBLIC_PLAUSIBLE_DOMAIN gesetzt ist. */}
    {site.plausibleDomain && (
      <script defer data-domain={site.plausibleDomain} src="https://plausible.io/js/script.tagged-events.outbound-links.js"></script>
    )}
    {site.plausibleDomain && (
      <script is:inline>window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
    )}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2">Zum Inhalt springen</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

{
  "name": "nachderspritze",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Landingpage und Wissens-Hub „Nach der Spritze“ – Astro, Tailwind, statisch.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",

---
/**
 * Kopf: Wortmarke, Hauptnavigation, Kontakt „Schreib uns“ und Button „Warteliste“. Den Newsletter-Knopf gibt es seit
 * 06.10.2026 nicht mehr; der Newsletter ist ein freiwilliges Häkchen bei Checkliste, Ernährungsplan und Warteliste.
 * Unter 1024 px: Warteliste bleibt sichtbar, der Rest liegt im Menü (<details>, funktioniert auch ohne Skript;
 * das kleine Skript schließt es bei Klick außerhalb, Escape und Linkwahl).
 */
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
const kontakt = `mailto:${site.owner.email}?subject=${encodeURIComponent('Nach der Spritze: meine Frage')}`;
---
<header class="hd">
  <div class="container-wide hd-in">
    <a href="/" class="hd-brand" aria-label="Nach der Spritze, Startseite"><Logo /></a>
    <nav aria-label="Hauptnavigation" class="hd-nav">
      {nav.map((item) => (<a href={item.href}>{item.label}</a>))}
    </nav>
    <div class="hd-r">
      <a href={kontakt} class="hd-link hd-desk plausible-event-name=Kontakt+Klick plausible-event-kanal=header">Schreib uns</a>
      <a href="/#warteliste" class="btn-primary hd-cta plausible-event-name=Warteliste+Klick plausible-event-position=header">Warteliste</a>
      <details class="hd-menu" id="hd-menu">
        <summary aria-label="Menü öffnen">
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path class="l1" d="M3 8h16" /><path class="l2" d="M3 14h16" /></svg>
        </summary>
        <nav aria-label="Menü" class="hd-mnav">
          {nav.map((item) => (<a href={item.href}>{item.label}</a>))}
          <a href={kontakt} class="plausible-event-name=Kontakt+Klick plausible-event-kanal=menue">Schreib uns</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid color-mix(in srgb, var(--color-line) 70%, transparent);
  }
  .hd-in {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }
  .hd-brand {
    flex: none;
    text-decoration: none;
  }
  .hd-nav {
    display: none;
    gap: 1.75rem;
    font-size: 0.9375rem;
  }
  .hd-nav a, .hd-link {
    color: var(--color-ink-2);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .hd-nav a:hover, .hd-link:hover {
    color: var(--color-ink);
  }
  .hd-r {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hd-link {
    font-size: 0.9375rem;
    padding: 0 0.5rem;
  }
  .hd-desk {
    display: none;
  }
  .hd-cta {
    min-height: 2.75rem;
    padding: 0.5rem 1.25rem;
    font-size: 0.9375rem;
  }
  .hd-menu summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    color: var(--color-ink);
    border-radius: 999px;
  }
  .hd-menu summary::-webkit-details-marker {
    display: none;
  }
  .hd-menu path {
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    transform-origin: 11px 11px;
    transition: transform 0.35s var(--ease);
  }
  .hd-menu[open] .l1 {
    transform: translateY(3px) rotate(45deg);
  }
  .hd-menu[open] .l2 {
    transform: translateY(-3px) rotate(-45deg);
  }
  .hd-mnav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
    padding: 0.25rem var(--pad) 1rem;
  }
  .hd-mnav a {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-ink);
    text-decoration: none;
    font-size: 1.1875rem;
    font-stretch: 112%;
    font-weight: 480;
  }
  .hd-mnav a:first-child {
    border-top: 0;
  }
  @media (max-width: 420px) {
    .hd-in { height: 3.75rem; gap: 0.5rem; }
    .hd-cta { padding: 0.5rem 1rem; min-height: 2.5rem; }
  }
  /* Sehr schmale Geräte (320–374 px): Wortmarke, Button und Abstände etwas kleiner, damit nichts über den Rand ragt */
  @media (max-width: 374px) {
    .hd-in { gap: 0.25rem; }
    .hd-brand :global(.brand) { font-size: 0.9375rem; }
    .hd-r { gap: 0.125rem; }
    .hd-cta { padding: 0.5rem 0.8rem; font-size: 0.875rem; }
    .hd-menu summary { width: 2.5rem; }
  }
  @media (min-width: 1024px) {
    .hd-nav { display: flex; }
    .hd-desk { display: inline-flex; }
    .hd-menu { display: none; }
  }
  @media (min-width: 1024px) and (max-width: 1140px) {
    .hd-nav { gap: 1.25rem; }
  }
</style>

<script is:inline>
  (function () {
    var m = document.getElementById('hd-menu');
    if (!m) return;
    document.addEventListener('click', function (e) { if (m.open && !m.contains(e.target)) m.open = false; });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && m.open) { m.open = false; m.querySelector('summary').focus(); } });
    m.addEventListener('toggle', function () { m.querySelector('summary').setAttribute('aria-label', m.open ? 'Menü schließen' : 'Menü öffnen'); });
    m.querySelectorAll('.hd-mnav a').forEach(function (a) { a.addEventListener('click', function () { m.open = false; }); });
  })();
</script>

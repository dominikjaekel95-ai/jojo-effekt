---
/**
 * Fuß jeder Seite. Der Arztsatz (site.medicalTeamSentence) steht wörtlich als eigener Absatz, nie neben Programm oder
 * Warteliste (CLAIMS.md Abschnitt H). Auf den Danke-Seiten (/danke/, /checkliste/danke/, /ernaehrungsplan/danke/,
 * /newsletter/danke/) entfällt er: Base.astro reicht dort footerArzt={false} als arzt={false} durch.
 */
import Logo from './Logo.astro';
import { site } from '../data/site';
import { themen } from '../data/themen';
interface Props {
  /** Arztsatz zeigen (Standard). false auf Danke-Seiten. */
  arzt?: boolean;
}
const { arzt = true } = Astro.props;
const year = new Date().getFullYear();
const kontakt = `mailto:${site.owner.email}?subject=${encodeURIComponent('Nach der Spritze: meine Frage')}`;
---
<footer class="ft">
  <div class="container-wide ft-grid">
    <div>
      <Logo />
      <p class="ft-t">Ein Projekt von {site.owner.name}, {site.owner.city}.</p>
      {arzt && <p class="ft-t">{site.medicalTeamSentence}</p>}
      <p class="ft-t ft-doc">{site.doctorSentence}</p>
      <p class="ft-t">Fragen, Hinweise, Kritik: <a href={kontakt} class="plausible-event-name=Kontakt+Klick plausible-event-kanal=footer">{site.owner.email}</a>. Wir antworten persönlich, ohne medizinische Beratung.</p>
    </div>
    <nav aria-label="Seiten">
      <p class="ft-h">Seite</p>
      <ul>
        <li><a href="/#programm">Das Programm</a></li>
        <li><a href="/#warteliste">Warteliste</a></li>
        <li><a href="/#faq">Häufige Fragen</a></li>
        <li><a href="/wissen/">Wissen: Absetzen, Jojo-Effekt, Muskeln</a></li>
        <li><a href="/wissen/studien/">Studien-Tracker: Absetzen und Gewicht</a></li>
        <li><a href="/glossar/">Glossar: Begriffe erklärt</a></li>
        <li><a href="/marktradar/">Marktradar: Zulassungen, Preise, Kassen</a></li>
        <li><a href="/abnehmspritze-kosten/">Kosten: Preise pro Monat und Jahr</a></li>
        <li><a href="/grafiken/">Grafiken: Studien, zitierfähig</a></li>
        <li><a href="/werkzeuge/">Werkzeuge: Zeitplan, Protein, Korridor, Kosten</a></li>
        <li><a href="/ueber/">Über diese Seite</a></li>
      </ul>
    </nav>
    <nav aria-label="Themen">
      <p class="ft-h">Themen</p>
      <ul>
        {themen.map((t) => (<li><a href={`/wissen/${t.slug}/`}>{t.name}</a></li>))}
        <li><a href="/checkliste/">Checkliste: die ersten 8 Wochen</a></li>
        <li><a href="/ernaehrungsplan/">Ernährungsplan: 14 Tage, kostenlos</a></li>
      </ul>
    </nav>
    <nav aria-label="Rechtliches">
      <p class="ft-h">Rechtliches</p>
      <ul>
        <li><a href="/impressum/">Impressum</a></li>
        <li><a href="/datenschutz/">Datenschutz</a></li>
      </ul>
      <p class="ft-small">© {year} {site.name}. Keine Cookies, keine Tracker mit Profilbildung.</p>
    </nav>
  </div>
</footer>

<style>
  .ft {
    margin-top: 6rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.875rem;
    color: var(--color-ink-2);
  }
  .ft-grid {
    display: grid;
    gap: 2.5rem;
    padding-top: 3.5rem;
    padding-bottom: 4.5rem;
  }
  .ft-t {
    margin-top: 0.875rem;
    max-width: 34em;
    line-height: 1.55;
  }
  .ft-doc {
    color: var(--color-ink);
  }
  .ft-h {
    font-size: 0.875rem;
    color: var(--color-ink-3);
    margin-bottom: 0.75rem;
  }
  .ft ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .ft a {
    color: var(--color-ink-2);
    text-decoration: none;
  }
  .ft a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ft-t a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-line);
    text-underline-offset: 3px;
  }
  .ft-small {
    margin-top: 1.5rem;
    font-size: 0.75rem;
    color: var(--color-ink-3);
  }
  @media (min-width: 768px) {
    .ft-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.8fr);
    }
  }
</style>

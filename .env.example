# Öffentliche Variablen (werden ins HTML gebaut, keine Geheimnisse hier)

# Live-Domain inkl. https://, ohne Slash am Ende. Steuert Canonical-URLs, Sitemap und robots.txt.
SITE_URL=https://nachderspritze.de

# Tally-Formular-ID (der Teil hinter tally.so/r/ bzw. tally.so/embed/). Leer = Platzhalter-Formular.
PUBLIC_TALLY_FORM_ID=

# Plausible: die in Plausible eingetragene Domain (ohne https://). Leer = kein Tracking-Snippet.
PUBLIC_PLAUSIBLE_DOMAIN=

# Design-Variante: a (Praxis), b (Magazin), c (Kraft), d (Ruhe), d1/d2/d3 (Ruhe mit anderer Palette). Leer = d1. Siehe src/styles/global.css.
PUBLIC_THEME=

---
/**
 * /abnehmspritze-kosten/: die monatliche Preiserhebung aus dem Marktradar als eigene, zitierfähige Seite.
 * Datenquelle ist ausschließlich src/data/markt/preise.json (pflegt Dominik, mit `stand`) und kassen.json; die Seite
 * rechnet daraus Jahreskosten als Größenordnung. Keine Bezugsquellen, keine Preisberatung, kein Vergleich mit dem Programm.
 * Gestaltung „Kalk“ seit 06.10.2026: Spannen als große Zahlen, Preise als Balken (PreisBalken), der Rechner rechnet beim
 * Ändern mit (gleiche Formeln) und zählt die Werte hoch.
 */
import Base from '../../layouts/Base.astro';
import SeitenKopf from '../../components/SeitenKopf.astro';
import PreisBalken from '../../components/PreisBalken.astro';
import GrafikDaten from '../../components/GrafikDaten.astro';
import Faq from '../../components/Faq.astro';
import GrafikEinbinden from '../../components/GrafikEinbinden.astro';
import { site } from '../../data/site';
import { preise, kassen, fmtDate } from '../../data/markt';

const MONATE = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
const [jahr, monat] = preise.stand.split('-').map(Number);
const monatJahr = `${MONATE[monat - 1]} ${jahr}`;
const eur = (n: number) => n.toLocaleString('de-DE');

/** Jahr rechnerisch: Pens, die vier Wochen reichen, × 13; Tabletten (30 Stück) und Saxenda (etwa 30 Tage) × 12. */
const rows = preise.zeilen.map((z) => {
  const monatEur = Number(String(z.monat).replace(/[^0-9]/g, ''));
  const faktor = /Tablette|Saxenda/.test(z.praeparat) ? 12 : 13;
  return { ...z, monatEur, faktor, jahrEur: monatEur * faktor };
});
const minMonat = Math.min(...rows.map((r) => r.monatEur));
const maxMonat = Math.max(...rows.map((r) => r.monatEur));
const minJahr = Math.min(...rows.map((r) => r.jahrEur));
const maxJahr = Math.max(...rows.map((r) => r.jahrEur));

const title = `Abnehmspritze Kosten ${jahr}: Preise pro Monat und Jahr, Rechner`;
const description = `Was kostet die Abnehmspritze? Je nach Präparat ca. ${eur(minMonat)} bis ${eur(maxMonat)} € im Monat, rechnerisch ${eur(minJahr)} bis ${eur(maxJahr)} € im Jahr. Stand ${monatJahr}, mit Kassenregeln.`;
const path = '/abnehmspritze-kosten/';
const url = `${site.url}${path}`;
const published = '2026-10-01';

const faq = [
  {
    q: 'Zahlt die Krankenkasse die Abnehmspritze?',
    a: kassen.regeln.slice(0, 2).map((k) => `<p>${k.gruppe}: ${k.regel}</p>`).join(''),
  },
  {
    q: 'Warum stehen hier nur Größenordnungen?',
    a: '<p>Apothekenverkaufspreise unterscheiden sich zwischen Apotheken und ändern sich. Wir nehmen den niedrigsten Versandpreis aus dem Preisvergleich, runden auf 5 € und nennen das Datum. Für eine Kaufentscheidung ist der tagesaktuelle Preis der Apotheke maßgeblich; Bezugsquellen nennen wir nicht.</p>',
  },
  {
    q: 'Wie sind die Jahreskosten gerechnet?',
    a: '<p>Ein Pen reicht bei den Spritzen vier Wochen, deshalb Monatspreis mal 13. Tabletten kommen in Packungen zu 30 Stück, Saxenda-Pens reichen etwa 30 Tage; dort Monatspreis mal 12. Dosissteigerungen am Anfang und Pausen sind nicht eingerechnet; die Spanne zeigt die Größenordnung.</p>',
  },
  {
    q: 'Was kostet die Abnehmspritze für drei Monate?',
    a: `<p>Als Selbstzahler je nach Präparat und Stufe etwa ${eur(minMonat * 3)} bis ${eur(maxMonat * 3)} € (Stand ${fmtDate(preise.stand)}), gerechnet aus dem Monatspreis mal drei. In den ersten drei Monaten läuft meist die Dosissteigerung, sodass die niedrigeren Stufen den Anfang prägen; der Jahreskosten-Rechner oben rechnet jede Stufe und jede Dauer einzeln.</p>`,
  },
  {
    q: 'Was rechnet der Jahreskosten-Rechner?',
    a: '<p>Aus dem Monatspreis der gewählten Zeile (oder einem eigenen Betrag) und der Dauer in Monaten die Gesamtkosten, die Kosten pro Jahr mit dem passenden Faktor und die Kosten pro Tag. Er rechnet nur im Browser, speichert nichts und ist eine Größenordnung für Selbstzahler; Kassenleistungen, Zuzahlungen und Dosiswechsel bildet er nicht ab.</p>',
  },
];

const rechnerZeilen = rows.map((r) => ({ name: r.praeparat, monat: r.monatEur, faktor: r.faktor }));

const jsonLd = [
  {
    '@type': 'WebApplication',
    '@id': `${url}#rechner`,
    name: 'Jahreskosten-Rechner Abnehmspritze',
    url: `${url}#rechner`,
    description: 'Präparat und Dauer wählen: Kosten pro Jahr, pro Tag und für die gewählte Dauer aus der monatlichen Preiserhebung; Größenordnung für Selbstzahler.',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    browserRequirements: 'JavaScript',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    inLanguage: 'de-DE',
    provider: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: title,
    description,
    inLanguage: 'de-DE',
    url,
    mainEntityOfPage: url,
    datePublished: new Date(published).toISOString(),
    dateModified: new Date(preise.stand).toISOString(),
    author: { '@type': 'Person', name: site.owner.name, url: `${site.url}/ueber/` },
    publisher: { '@id': `${site.url}/#organization` },
    image: [`${site.url}/grafiken/preise-im-monat.png`],
    about: { '@type': 'Thing', name: 'Kosten von GLP-1-Rezeptoragonisten in Deutschland' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Marktradar', item: `${site.url}/marktradar/` },
      { '@type': 'ListItem', position: 3, name: 'Kosten', item: url },
    ],
  },
];
---
<Base title={title} description={description} path={path} jsonLd={jsonLd} ogType="article" ogImage="/grafiken/preise-im-monat.png" publishedTime={new Date(published).toISOString()} modifiedTime={new Date(preise.stand).toISOString()}>
  <SeitenKopf crumbs={[{ href: '/', label: 'Start' }, { href: '/marktradar/', label: 'Marktradar' }, { label: 'Kosten' }]} meta={`Preise, Stand ${fmtDate(preise.stand)}, monatlich aktualisiert`} title="Was Abnehmspritzen kosten: Preise im Monat und im Jahr" size="m">
    <p>Selbstzahlerpreise für die zugelassenen Abnehmspritzen und die Abnehmtablette in Deutschland, als Größenordnung aus dem Preisvergleich, mit Datum und Quelle. Die Tabelle darf mit Nennung „nachderspritze.de“ zitiert werden.</p>
  </SeitenKopf>

  <article class="container-wide k-end">
    <div class="k-facts ko-facts">
      <div class="k-fact" data-rv>
        <p class="k-num"><span data-count={minMonat}>{eur(minMonat)}</span>–<span data-count={maxMonat}>{eur(maxMonat)}</span><small>€</small></p>
        <p>im Monat, je nach Präparat und Dosis, für Selbstzahler</p>
      </div>
      <div class="k-fact" data-rv style="--i:1">
        <p class="k-num"><span data-count={minJahr}>{eur(minJahr)}</span>–<span data-count={maxJahr}>{eur(maxJahr)}</span><small>€</small></p>
        <p>im Jahr, rechnerisch, ohne Dosissteigerung und Pausen</p>
      </div>
    </div>

    <div class="ko-main">
    <div class="prose-site mt-10">
      <blockquote>
        <p><strong>Kurz gesagt:</strong> Je nach Präparat und Dosis kostet die Therapie Selbstzahler etwa {eur(minMonat)} bis {eur(maxMonat)} € im Monat, rechnerisch {eur(minJahr)} bis {eur(maxJahr)} € im Jahr. Gesetzliche Kassen zahlen bei Adipositas ohne Diabetes nicht; bei Typ-2-Diabetes sind Ozempic und Mounjaro in der zugelassenen Indikation Kassenleistung.</p>
      </blockquote>

      <h2 id="tabelle">Preise je Präparat, Stand {fmtDate(preise.stand)}</h2>
      <p>{preise.hinweis}</p>
    </div>
    </div>

    <PreisBalken jahr />
    <p class="k-note">Quelle: {preise.quelle.replace(/\.$/, '')}. Jahr rechnerisch: Monatspreis × 13 bei Pens, die vier Wochen reichen, × 12 bei Tabletten (30 Stück) und Saxenda (etwa 30 Tage). Dosissteigerung und Pausen nicht eingerechnet.</p>

    <figure class="ko-fig" data-rv>
      <img src="/grafiken/preise-im-monat.png" alt={`Balkendiagramm der monatlichen Selbstzahlerpreise als Größenordnung, Stand ${fmtDate(preise.stand)}: ${preise.zeilen.map((z) => `${z.praeparat} ${z.monat}`).join('; ')}.`} width="1200" height="675" loading="lazy" />
      <figcaption>
        <p>Dieselben Zahlen als Grafik; frei verwendbar mit Quellenangabe (CC BY 4.0), Download unter <a href="/grafiken/#preise-im-monat" class="k-a">Grafiken</a>.</p>
        <GrafikDaten id="preise-im-monat" class="mt-3" />
      </figcaption>
    </figure>

    <div class="ko-main">
    <section id="rechner" class="k-sec scroll-mt-24" aria-labelledby="rechner-h">
      <h2 id="rechner-h" class="k-h2">Jahreskosten-Rechner</h2>
      <p class="k-intro">Präparat und Dauer wählen oder einen eigenen Monatspreis eintragen. Rechnet nur im Browser, Größenordnung für Selbstzahler, keine Preisberatung.</p>
      <form id="kosten-form" class="k-panel ko-form" novalidate data-zeilen={JSON.stringify(rechnerZeilen)}>
        <div class="k-field ko-wide">
          <label for="praeparat" class="k-label">Präparat und Stufe, Stand {fmtDate(preise.stand)}</label>
          <select id="praeparat" name="praeparat" class="k-input">
            {rechnerZeilen.map((z, i) => (<option value={i}>{z.name} (ca. {eur(z.monat)} € im Monat)</option>))}
            <option value="eigen">Eigener Monatspreis</option>
          </select>
        </div>
        <div class="k-field">
          <label for="monatspreis" class="k-label">Monatspreis in €</label>
          <input id="monatspreis" name="monatspreis" type="number" inputmode="numeric" min="10" max="3000" step="5" value={rechnerZeilen[0]?.monat} required class="k-input" />
        </div>
        <div class="k-field">
          <label for="monate" class="k-label">Dauer in Monaten</label>
          <div class="ko-dauer">
            <input id="monate" name="monate" type="number" inputmode="numeric" min="1" max="60" step="1" value="12" required class="k-input" />
            <input type="range" class="k-range" min="1" max="36" step="1" value="12" aria-label="Dauer in Monaten einstellen" data-regler />
          </div>
        </div>
        <div class="ko-act">
          <button type="submit" class="btn-primary">Berechnen</button>
        </div>
      </form>
      <div id="kosten-ergebnis" class="k-stats rows ko-res hidden" aria-live="polite">
        <div class="k-stat"><p class="k-stat-l" data-dauer-label>Für 12 Monate</p><p class="k-stat-v moss" data-gesamt></p></div>
        <div class="k-stat"><p class="k-stat-l">Pro Jahr, rechnerisch</p><p class="k-stat-v" data-jahr></p><p class="k-stat-n" data-faktor></p></div>
        <div class="k-stat"><p class="k-stat-l">Pro Tag</p><p class="k-stat-v" data-tag></p></div>
      </div>
      <p class="k-note">Dosissteigerung am Anfang, Pausen, Zuzahlungen und Kassenleistungen sind nicht eingerechnet. Nichts wird gespeichert oder übertragen.</p>
    </section>

    <div class="prose-site mt-12">
      <h2 id="kassen">Was die Krankenkassen zahlen, Stand {fmtDate(kassen.stand)}</h2>
    </div>
    <dl class="ko-dl">
      {kassen.regeln.map((k) => (<div class="k-pair"><dt>{k.gruppe}</dt><dd>{k.regel}</dd></div>))}
    </dl>

    <div class="prose-site">
      <h2 id="methodik">Methodik</h2>
      <p>Die Preise stammen aus dem Preisvergleich medipreis.de (niedrigster Versandpreis am Stichtag) und, für die Tablette, aus Presseberichten zum Marktstart; mit „Anbieterangabe“ markierte Zeilen stammen von Anbieterseiten und werden bei der nächsten Erhebung gegen den Preisvergleich geprüft. Beträge sind auf 5 € gerundet. Die Erhebung läuft einmal im Monat; das Datum steht oben und in jeder Zeile. Was wir nicht liefern: Bezugsquellen, Preisberatung, Empfehlungen für oder gegen ein Präparat. Der laufende Überblick zu Zulassungen, Lieferbarkeit und Kassenregeln steht im <a href="/marktradar/">Marktradar</a>.</p>

      <h2 id="zitieren">So zitierst du diese Seite</h2>
      <p>„Nach der Spritze: Was Abnehmspritzen kosten, Stand {fmtDate(preise.stand)}, nachderspritze.de/abnehmspritze-kosten/“. Die Tabelle und die Grafik dürfen mit dieser Nennung übernommen werden; bei Fragen zur Erhebung: <a href={`mailto:${site.owner.email}`}>{site.owner.email}</a>.</p>

      <h2 id="danach">Und nach der letzten Dosis?</h2>
      <p>Kosten sind der häufigste Grund, die Therapie zu beenden. Was danach mit Appetit, Gewicht und Blutwerten passiert, Woche für Woche, steht unter <a href="/wissen/abnehmspritze-absetzen/">Abnehmspritze absetzen</a>; den Vergleich von Tablette und Spritze unter <a href="/wissen/abnehmpille-oder-spritze/">Abnehmpille oder Spritze</a>.</p>
    </div>

    <div class="mt-14"><Faq items={faq} id="kosten-faq" title="Häufige Fragen zu den Kosten" /></div>
    </div>
    <GrafikEinbinden />
  </article>

</Base>

<script>
  import { zaehle, reduziert } from '../../lib/bewegung';
  type Zeile = { name: string; monat: number; faktor: number };
  const form = document.getElementById('kosten-form') as HTMLFormElement;
  const ergebnis = document.getElementById('kosten-ergebnis') as HTMLElement;
  const zeilen = JSON.parse(form.dataset.zeilen || '[]') as Zeile[];
  const el = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const regler = form.querySelector<HTMLInputElement>('[data-regler]')!;
  const q = (sel: string) => document.querySelector<HTMLElement>(sel)!;
  const euro = (n: number) => `ca. ${Math.round(n).toLocaleString('de-DE')} €`;
  const cent = (n: number) => `ca. ${n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} €`;
  const auswahl = () => (el('praeparat').value === 'eigen' ? null : zeilen[Number(el('praeparat').value)]);
  let alt = { gesamt: 0, jahr: 0, tag: 0 };
  const fuellung = () => regler.style.setProperty('--f', `${((Number(regler.value) - 1) / 35) * 100}%`);
  fuellung();

  const rechne = (fokus: boolean) => {
    const monat = Number(el('monatspreis').value);
    const monate = Number(el('monate').value);
    if (!(monat >= 10 && monat <= 3000)) { if (fokus) el('monatspreis').focus(); return; }
    if (!(monate >= 1 && monate <= 60)) { if (fokus) el('monate').focus(); return; }
    const z = auswahl();
    const faktor = z ? z.faktor : 13;
    const jahr = monat * faktor;
    const gesamt = (jahr / 12) * monate;
    const tag = jahr / 365;
    const zuerst = ergebnis.classList.contains('hidden');
    ergebnis.classList.remove('hidden');
    q('[data-dauer-label]').textContent = `Für ${monate} ${monate === 1 ? 'Monat' : 'Monate'}`;
    zaehle(q('[data-gesamt]'), zuerst ? 0 : alt.gesamt, gesamt, euro);
    zaehle(q('[data-jahr]'), zuerst ? 0 : alt.jahr, jahr, euro);
    zaehle(q('[data-tag]'), zuerst ? 0 : alt.tag, tag, cent);
    q('[data-faktor]').textContent = `Monatspreis × ${faktor}${z ? '' : ' (Pen, der vier Wochen reicht)'}`;
    alt = { gesamt, jahr, tag };
    if (fokus && zuerst) ergebnis.scrollIntoView({ behavior: reduziert() ? 'auto' : 'smooth', block: 'nearest' });
  };

  el('praeparat').addEventListener('change', () => {
    const z = auswahl();
    if (z) el('monatspreis').value = String(z.monat);
    if (!ergebnis.classList.contains('hidden')) rechne(false);
  });
  el('monatspreis').addEventListener('input', () => { if (!ergebnis.classList.contains('hidden')) rechne(false); });
  el('monate').addEventListener('input', () => {
    const m = Number(el('monate').value);
    if (m >= 1 && m <= 36) { regler.value = String(m); fuellung(); }
    if (!ergebnis.classList.contains('hidden')) rechne(false);
  });
  regler.addEventListener('input', () => {
    el('monate').value = regler.value;
    fuellung();
    rechne(false);
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    rechne(true);
  });
</script>

<style>
  .ko-facts .k-fact p:last-child {
    max-width: 26em;
  }
  @media (min-width: 760px) {
    .ko-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 62rem;
    }
  }
  .ko-main {
    max-width: 45rem;
  }
  .ko-fig {
    display: grid;
    gap: 1.25rem 2.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .ko-fig img {
    width: 100%;
    height: auto;
    border-radius: 14px;
    border: 1px solid var(--color-line);
    background: #fff;
  }
  .ko-fig figcaption {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-ink-3);
  }
  @media (min-width: 900px) {
    .ko-fig {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: start;
    }
  }
  .ko-form {
    display: grid;
    gap: 1.5rem 2rem;
  }
  .ko-dauer {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
  }
  @media (min-width: 640px) {
    .ko-form {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    }
    .ko-wide, .ko-act {
      grid-column: 1 / -1;
    }
  }
  .ko-res {
    margin-top: 2rem;
  }
  .ko-dl {
    margin-top: 1rem;
    border-top: 1px solid var(--color-ink);
  }
  .ko-dl > div {
    border-bottom: 1px solid var(--color-line);
  }
</style>

---
/**
 * Werkzeug: Gewichtskorridor für die Haltephase. Aus dem Startgewicht entstehen drei Zonen wie eine Ampel, nach dem
 * Selbstregulations-Programm von Wing et al. 2006 (grün bis +1,4 kg, gelb +1,4 bis +2,3 kg, rot ab +2,3 kg), jede mit
 * einer vorher festgelegten Reaktion: nichts tun, zwei Wochen gegensteuern, Plan prüfen (vier Punkte durchgehen, Gelb läuft
 * weiter). Routine-Hilfe, keine medizinische Einschätzung: Seit 07.10.2026 löst keine Zone eine Arzt-Empfehlung aus; der
 * zonenunabhängige Satz unter der Ampel und site.doctorSentence bleiben. Keine Medikamentenempfehlung, kein
 * Wiedereinstiegsschema. Rechnet nur im Browser, speichert nichts.
 * Gestaltung „Kalk“ seit 06.10.2026: Ergebnis rechnet beim Tippen mit (gleiche Formeln), Zonen zeichnen sich, die Marke
 * für heute gleitet an ihre Stelle.
 */
import Base from '../../../layouts/Base.astro';
import SeitenKopf from '../../../components/SeitenKopf.astro';
import Fn from '../../../components/Fn.astro';
import Footnotes from '../../../components/Footnotes.astro';
import Faq from '../../../components/Faq.astro';
import ProductTeaser from '../../../components/ProductTeaser.astro';
import { faqJsonLd } from '../../../data/faq';
import { site } from '../../../data/site';

const fnIds = ['wing2006', 'wu2025', 'wilding2022ext', 'jensen2024', 'leidy2015', 'who2020'] as const;
const fn = (id: (typeof fnIds)[number]) => fnIds.indexOf(id) + 1;

/* Ampelfarben aus dem Design „Kalk“ mit fester Bedeutung: Grün = halten, Gelb = Markierung, Braun = Wiederzunahme */
const AMPEL = { gruen: 'var(--color-moss)', gelb: 'var(--color-amber)', rot: 'var(--color-clay)' };

const title = 'Gewichtskorridor: Ampel fürs Gewicht nach der Abnehmspritze';
const description =
  'Gewichtskorridor: Startgewicht eingeben, Ampel erhalten. Grün bis 1,4 kg darüber: nichts tun. Gelb bis 2,3 kg: zwei Wochen gegensteuern. Rot: Plan prüfen.';
const path = '/werkzeuge/gewichtskorridor/';
const url = `${site.url}${path}`;

const faq = [
  {
    q: 'Warum liegen die Grenzen bei 1,4 und 2,3 kg?',
    a: '<p>Das sind die Zonen des Selbstregulations-Programms von Wing und Kollegen (2006): bis 3 Pfund (1,4 kg) über dem Startgewicht grün, 3 bis 5 Pfund gelb, ab 5 Pfund (2,3 kg) rot. In der Studie mit 314 Teilnehmenden, die zuvor mindestens 10 % abgenommen hatten, nahmen in 18 Monaten 45,7 % der Gruppe mit persönlicher Betreuung wieder 2,3 kg oder mehr zu, in der Kontrollgruppe 72,4 %. Unter 1,4 kg lassen sich Schwankungen durch Wasser, Salz, Darminhalt oder Zyklus nicht von echter Zunahme unterscheiden; ab 2,3 kg ist es keine Schwankung mehr.</p>',
  },
  {
    q: 'Was mache ich in der roten Zone konkret?',
    a: '<p>Den Plan prüfen, mit vier Fragen: Habe ich an den meisten Tagen mein Proteinziel erreicht? Habe ich zwei Krafteinheiten pro Woche gemacht? Schlafe ich sechs Stunden oder weniger? Trinke ich Kalorien, etwa Alkohol, Säfte, Milchkaffee? Wo es hakt, setzt du an; die Maßnahmen aus Gelb laufen weiter. Der Korridor ist eine Orientierung für deine Routinen, keine Bewertung deiner Gesundheit, und er sagt nichts über ein Medikament.</p>',
  },
  {
    q: 'Täglich oder einmal pro Woche wiegen?',
    a: '<p>Im Programm von Wing wogen sich die Teilnehmenden täglich. Wir empfehlen einmal pro Woche unter gleichen Bedingungen, weil Tagesschwankungen verunsichern. Für die Zonen ist beides geeignet; entscheidend ist, dass du den Wert mit dem Korridor vergleichst und vorher weißt, was du in jeder Zone tust.</p>',
  },
  {
    q: 'Was, wenn ich gerade Kreatin angefangen habe?',
    a: '<p>Kreatin bindet in den ersten Wochen zusätzlich Wasser in der Muskulatur. Das zeigt die Waage, ist aber kein Fett und zählt nicht als Zunahme. Setze das Startgewicht erst nach zwei bis drei Wochen Einnahme, oder rechne die Wassereinlagerung gedanklich heraus.</p>',
  },
  {
    q: 'Gilt der Korridor auch, wenn ich die Spritze noch nehme?',
    a: '<p>Ja, sobald das Gewicht stabil ist und du es halten willst, auch unter laufender Therapie. Der Korridor sagt nichts über das Medikament aus; er macht sichtbar, ob das Gewicht driftet, bevor es ein großer Unterschied wird.</p>',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    '@id': `${url}#app`,
    name: 'Gewichtskorridor nach der Abnehmspritze',
    url,
    description,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Web',
    browserRequirements: 'JavaScript',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    inLanguage: 'de-DE',
    provider: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'WebPage',
    '@id': `${url}#page`,
    name: title,
    description,
    url,
    inLanguage: 'de-DE',
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: { '@id': `${url}#app` },
    about: { '@type': 'Thing', name: 'Gewicht halten nach dem Absetzen von GLP-1-Rezeptoragonisten' },
  },
  faqJsonLd(faq),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Werkzeuge', item: `${site.url}/werkzeuge/` },
      { '@type': 'ListItem', position: 3, name: 'Gewichtskorridor', item: url },
    ],
  },
];
---
<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <SeitenKopf crumbs={[{ href: '/', label: 'Start' }, { href: '/werkzeuge/', label: 'Werkzeuge' }, { label: 'Gewichtskorridor' }]} meta="Werkzeug, rechnet nur in deinem Browser" title="Gewichtskorridor: eine Ampel für die Waage nach der Abnehmspritze" size="m" width="narrow" doc="Der Korridor ist keine Empfehlung für oder gegen ein Medikament.">
    <p>Nach dem Absetzen kommt das Gewicht in kleinen Schritten zurück. Kilo für Kilo. Jedes einzelne wirkt harmlos, deshalb übersieht man leicht den Trend. In Studien ist die Zunahme ab etwa Woche 8 messbar.<Fn n={fn('wu2025')} id="wu2025" /> Der Korridor ist eine Orientierung für deine Routinen, keine Bewertung deiner Gesundheit: Du legst einmal ein Startgewicht fest, und die Ampel zeigt, ob du einfach weitermachst oder zwei Wochen gegensteuerst.</p>
  </SeitenKopf>

  <article class="container-narrow k-end">
    <section class="kr-how" aria-labelledby="lesen-h" data-rv>
      <h2 id="lesen-h" class="k-h3">So funktioniert die Ampel</h2>
      <ol class="kr-zonen">
        <li><span class="kr-dot" style={`background:${AMPEL.gruen}`} aria-hidden="true"></span><span><strong>Grün, bis 1,4 kg über dem Start: nichts tun.</strong> So viel schwankt das Gewicht durch Wasser, Salz, Darminhalt oder Zyklus ohnehin. Routinen halten, nächste Woche wieder wiegen.</span></li>
        <li><span class="kr-dot" style={`background:${AMPEL.gelb}`} aria-hidden="true"></span><span><strong>Gelb, 1,4 bis 2,3 kg über dem Start: zwei Wochen gegensteuern.</strong> Das ist kein Zufall mehr, sondern ein Trend. Protein, Training und Mahlzeitenstruktur in Ordnung bringen, dann wieder wiegen. Keine Diät.</span></li>
        <li><span class="kr-dot" style={`background:${AMPEL.rot}`} aria-hidden="true"></span><span><strong>Rot, mehr als 2,3 kg über dem Start: Plan prüfen.</strong> Das Gegensteuern hat nicht gereicht. Die vier Punkte unten durchgehen; die Maßnahmen aus Gelb laufen weiter.</span></li>
      </ol>
      <p class="k-note">Beispiel: Startgewicht 82,4 kg. Grün bis 83,8 kg, gelb bis 84,7 kg, rot darüber. Die Grenzen stammen aus einem Programm, das in einer randomisierten Studie die Wiederzunahme deutlich senkte.<Fn n={fn('wing2006')} id="wing2006" /></p>
    </section>

    <form id="korridor-form" class="k-panel kr-form" novalidate>
      <div class="k-field">
        <label for="start" class="k-label">Startgewicht in kg</label>
        <input id="start" name="start" type="number" inputmode="decimal" min="35" max="300" step="0.1" placeholder="z. B. 82,4" required class="k-input" />
        <p class="k-hint">Das Gewicht am ersten Wiegetag deiner Haltephase, morgens, nüchtern. Nicht der Tiefstwert eines guten Tages.</p>
      </div>
      <div class="k-field">
        <label for="aktuell" class="k-label">Heutiges Gewicht in kg (optional)</label>
        <input id="aktuell" name="aktuell" type="number" inputmode="decimal" min="35" max="300" step="0.1" placeholder="z. B. 83,9" class="k-input" />
        <p class="k-hint">Zeigt, in welcher Zone du heute stehst.</p>
      </div>
      <div class="kr-act">
        <button type="submit" class="btn-primary">Ampel berechnen</button>
        <span class="k-hint">Nichts wird gespeichert oder übertragen.</span>
      </div>
    </form>

    <section id="korridor-ergebnis" class="kr-res hidden" aria-live="polite">
      <h2 class="k-h2">Deine Ampel</h2>
      <p class="kr-heute hidden" data-zone-heute></p>
      <div class="kr-bar" aria-hidden="true">
        <div class="kr-mk hidden" data-marker><span class="kr-mk-in"><span class="kr-mk-t" data-marker-text>heute</span><span class="kr-mk-p"></span></span></div>
        <div class="kr-seg">
          <span style={`width:40%;background:${AMPEL.gruen};--i:0`}></span>
          <span style={`width:25%;background:${AMPEL.gelb};--i:1`}></span>
          <span style={`width:35%;background:${AMPEL.rot};--i:2`}></span>
        </div>
        <div class="kr-skala">
          <span style="left:0" data-skala-start></span>
          <span style="left:40%" data-skala-gelb></span>
          <span style="left:65%" data-skala-rot></span>
        </div>
      </div>
      <div class="k-stats kr-stats">
        <div class="k-stat"><p class="k-stat-l"><i style={`background:${AMPEL.gruen}`}></i>Grün: nichts tun</p><p class="k-stat-v" data-gruen></p><p class="kr-t">Normale Schwankung. Routinen halten: Protein, zwei Krafteinheiten, fester Wiegetag.</p></div>
        <div class="k-stat"><p class="k-stat-l"><i style={`background:${AMPEL.gelb}`}></i>Gelb: zwei Wochen gegensteuern</p><p class="k-stat-v" data-gelb></p><p class="kr-t">Ein Trend, kein Zufall. Protein zuerst, Gemüse für Volumen, keine Flüssigkalorien, kein Training ausfallen lassen. Dann wieder wiegen.</p></div>
        <div class="k-stat"><p class="k-stat-l"><i style={`background:${AMPEL.rot}`}></i>Rot: Plan prüfen</p><p class="k-stat-v" data-rot></p><p class="kr-t">Gegensteuern hat nicht gereicht. Die vier Punkte unten durchgehen; die Maßnahmen aus Gelb laufen weiter.</p></div>
      </div>
      <p class="k-note">Nach unten gibt es keine Zone: Weiter sinkendes Gewicht ist kein Alarm, solange es gewollt ist und du dich gut fühlst.</p>
      <p class="k-note">Unabhängig von der Ampel: Fragen zu Gewicht, Gesundheit oder Medikament gehören zu deiner Ärztin oder deinem Arzt.</p>
      <div class="kr-act kr-act2">
        <button type="button" class="btn-secondary" data-korridor-drucken>Drucken</button>
        <a href="/werkzeuge/zeitplan-nach-letzter-dosis/" class="k-a">Wiegetage in den Kalender: Zeitplan nach der letzten Dosis</a>
      </div>
    </section>

    <div class="prose-site mt-12">
      <h2 id="warum">Warum eine Ampel und nicht einfach „aufpassen“</h2>
      <p>Wer nach der Abnehmspritze das Gewicht halten will, verliert den Überblick selten an einem Tag, sondern über Wochen: ein halbes Kilo hier, ein Kilo dort, und für jedes gibt es eine gute Erklärung. In der STEP-1-Verlängerung waren ein Jahr nach dem Absetzen im Mittel zwei Drittel des verlorenen Gewichts zurück.<Fn n={fn('wilding2022ext')} id="wilding2022ext" /> Mit der Ampel weißt du vorher, was du tust, und musst nicht erst auf der Waage entscheiden.</p>
      <p>Die drei Zonen stammen aus dem Selbstregulations-Programm von Wing und Kollegen: 314 Erwachsene, die zuvor mindestens 10 % abgenommen hatten, wurden 18 Monate begleitet. Sie wogen sich täglich, verglichen den Wert mit ihrem Korridor und reagierten nach Zone. In der Gruppe mit persönlicher Betreuung nahmen 45,7 % wieder 2,3 kg oder mehr zu, in der Kontrollgruppe 72,4 %.<Fn n={fn('wing2006')} id="wing2006" /> Die Teilnehmenden hatten ohne Medikament abgenommen. Wir übertragen die Zonen auf die Zeit nach der Spritze, denn das Prinzip ist dasselbe: wiegen und nach einer festen Regel reagieren.</p>

      <h2 id="zonen">Was in jeder Zone zu tun ist</h2>
      <ul>
        <li><strong>Grün, bis +1,4 kg:</strong> nichts ändern, Routinen halten. Das heißt 1,2 bis 1,6 g Protein pro kg Körpergewicht am Tag,<Fn n={fn('leidy2015')} id="leidy2015" /> Krafttraining an mindestens zwei Tagen pro Woche<Fn n={fn('who2020')} id="who2020" /> und der feste Wiegetag.</li>
        <li><strong>Gelb, +1,4 bis +2,3 kg:</strong> zwei Wochen lang gegensteuern, ohne Diät. Protein bei jeder Mahlzeit zuerst, Gemüse und Ballaststoffe für Volumen, keine Flüssigkalorien, kein Training ausfallen lassen. Dann wieder wiegen. Eine Crash-Diät wäre der falsche Hebel: weniger Muskeln, mehr Hunger, und danach kommt das Gewicht oft schneller zurück.</li>
        <li><strong>Rot, ab +2,3 kg:</strong> Plan prüfen. Die vier Punkte durchgehen: Proteinziel an den meisten Tagen erreicht? Zwei Krafteinheiten pro Woche gemacht? Sechs Stunden Schlaf oder weniger? Kalorien getrunken (Alkohol, Säfte, Milchkaffee)? Wo es hakt, setzt du an; die Maßnahmen aus Gelb laufen weiter.</li>
      </ul>
      <p>Warum Training in jeder Zone steht: In der dänischen S-LiTE-Studie nahmen Teilnehmende nach Liraglutid allein im Jahr nach Therapieende 6,0 kg mehr zu als nach einem betreuten Trainingsprogramm.<Fn n={fn('jensen2024')} id="jensen2024" /> Wie ein Einstieg aussieht, steht unter <a href="/wissen/krafttraining-nach-abnehmspritze/">Krafttraining nach der Abnehmspritze</a>.</p>

      <h2 id="wiegen">Die Wiegeregel</h2>
      <p>Einmal pro Woche, gleicher Wochentag, morgens nach der Toilette, vor dem Frühstück. Wer Kreatin nimmt: Es bindet in den ersten Wochen zusätzlich Wasser in der Muskulatur. Das zeigt die Waage, ist aber kein Fett; den Startwert setzt du danach. Der Wochenwert zählt, nicht der Tageswert; was dahintersteht, erklärt der Artikel <a href="/wissen/gewicht-halten-nach-abnehmspritze/">Gewicht halten nach der Abnehmspritze</a>. Was in den ersten Wochen nach der letzten Dosis sonst passiert, Woche für Woche, steht unter <a href="/wissen/abnehmspritze-absetzen/">Abnehmspritze absetzen</a>.</p>
    </div>

    <div class="mt-14"><Faq items={faq} id="korridor-faq" title="Häufige Fragen zum Gewichtskorridor" /></div>

    <ProductTeaser position="werkzeug-korridor" />

    <Footnotes ids={fnIds} />
  </article>
</Base>

<script>
  import { zaehle, reduziert } from '../../../lib/bewegung';
  const form = document.getElementById('korridor-form') as HTMLFormElement;
  const ergebnis = document.getElementById('korridor-ergebnis') as HTMLElement;
  const feldStart = form.elements.namedItem('start') as HTMLInputElement;
  const feldHeute = form.elements.namedItem('aktuell') as HTMLInputElement;
  const q = (sel: string) => document.querySelector<HTMLElement>(sel)!;
  const kg = (n: number) => `${n.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} kg`;
  const lesen = (feld: HTMLInputElement) => parseFloat(String(feld.value).replace(',', '.'));
  let altStart = 0;

  const rechne = (springen: boolean) => {
    const start = lesen(feldStart);
    if (!(start >= 35 && start <= 300)) {
      if (springen) feldStart.focus();
      return;
    }
    const gelbAb = start + 1.4;
    const rotAb = start + 2.3;
    const zuerst = ergebnis.classList.contains('hidden');
    ergebnis.classList.remove('hidden');
    const von = zuerst || !altStart ? start * 0.9 : altStart;
    // Die Grenzen hängen fest am Startgewicht (+1,4 und +2,3 kg); gezählt wird das Startgewicht, die Grenzen laufen mit
    zaehle(q('[data-gruen]'), von, start, (s) => `bis ${kg(s + 1.4)}`);
    zaehle(q('[data-gelb]'), von, start, (s) => `${kg(s + 1.4)} bis ${kg(s + 2.3)}`);
    zaehle(q('[data-rot]'), von, start, (s) => `ab ${kg(s + 2.3)}`);
    q('[data-skala-start]').textContent = `Start ${kg(start)}`;
    q('[data-skala-gelb]').textContent = kg(gelbAb);
    q('[data-skala-rot]').textContent = kg(rotAb);
    altStart = start;

    const heute = q('[data-zone-heute]');
    const marker = q('[data-marker]');
    const aktuell = lesen(feldHeute);
    if (aktuell >= 35 && aktuell <= 300) {
      const diff = aktuell - start;
      // Position auf der Leiste: Grün 0 bis 40 %, Gelb 40 bis 65 %, Rot 65 bis 100 % (bis +4,6 kg, darüber am Rand)
      let pos = 0;
      if (diff <= 0) pos = 0;
      else if (diff < 1.4) pos = (diff / 1.4) * 40;
      else if (diff < 2.3) pos = 40 + ((diff - 1.4) / 0.9) * 25;
      else pos = Math.min(100, 65 + ((diff - 2.3) / 2.3) * 35);
      marker.style.setProperty('--pos', pos.toFixed(2));
      marker.dataset.seite = pos > 75 ? 'rechts' : pos < 15 ? 'links' : '';
      q('[data-marker-text]').textContent = `heute ${kg(aktuell)}`;
      marker.classList.remove('hidden');
      const zone = diff >= 2.3 ? 'Rot: Plan prüfen. Die vier Punkte unten durchgehen; die Maßnahmen aus Gelb laufen weiter.' : diff >= 1.4 ? 'Gelb: zwei Wochen gegensteuern, dann wieder wiegen.' : diff < 0 ? 'Grün, unter dem Startgewicht: nichts tun.' : 'Grün: nichts tun, nächste Woche wieder wiegen.';
      heute.dataset.zone = diff >= 2.3 ? 'rot' : diff >= 1.4 ? 'gelb' : 'gruen';
      const vorzeichen = diff > 0 ? '+' : '';
      heute.textContent = `Heute ${kg(aktuell)}, das sind ${vorzeichen}${kg(diff)} gegenüber dem Start. ${zone}`;
      heute.classList.remove('hidden');
    } else {
      heute.classList.add('hidden');
      marker.classList.add('hidden');
    }
    if (zuerst && !reduziert()) requestAnimationFrame(() => requestAnimationFrame(() => ergebnis.classList.add('kr-in')));
    else ergebnis.classList.add('kr-in');
    if (springen) ergebnis.scrollIntoView({ behavior: reduziert() ? 'auto' : 'smooth', block: 'start' });
  };

  feldStart.addEventListener('input', () => rechne(false));
  feldHeute.addEventListener('input', () => {
    if (!ergebnis.classList.contains('hidden')) rechne(false);
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    rechne(true);
  });
  q('[data-korridor-drucken]').addEventListener('click', () => window.print());
</script>

<style>
  .kr-how {
    margin-top: clamp(2.5rem, 6vh, 3.5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-ink);
  }
  .kr-zonen {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }
  .kr-zonen li {
    display: flex;
    gap: 0.9rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink-2);
    font-size: 0.975rem;
    line-height: 1.55;
  }
  .kr-zonen strong {
    color: var(--color-ink);
    font-weight: 560;
  }
  .kr-dot {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.4rem;
    border-radius: 50%;
  }
  .kr-form {
    display: grid;
    gap: 1.5rem 2rem;
  }
  .kr-act {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  @media (min-width: 640px) {
    .kr-form {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .kr-act {
      grid-column: 1 / -1;
    }
  }
  .kr-res {
    margin-top: 3rem;
  }
  .kr-heute {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    border-radius: 14px;
    background: var(--color-paper-2);
    font-size: 1.0625rem;
    font-weight: 520;
    line-height: 1.5;
    color: var(--color-ink);
  }
  /* Leiste mit drei Zonen und Marke für heute */
  .kr-bar {
    position: relative;
    container-type: inline-size;
    margin-top: 2rem;
    padding-top: 2.75rem;
  }
  .kr-seg {
    display: flex;
    gap: 3px;
    height: 1.5rem;
  }
  .kr-seg span {
    display: block;
    height: 100%;
    transform-origin: left;
    transition: transform 0.9s var(--ease);
    transition-delay: calc(var(--i, 0) * 140ms);
  }
  .kr-seg span:first-child {
    border-radius: 999px 0 0 999px;
  }
  .kr-seg span:last-child {
    border-radius: 0 999px 999px 0;
  }
  /* Marke ohne eigene Breite, verschoben um --pos Prozent der Leiste (cqi): kein Überlauf nach rechts */
  .kr-mk {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 2.6rem;
    transform: translateX(calc(var(--pos, 0) * 1cqi));
    transition: transform 0.8s var(--ease);
    pointer-events: none;
  }
  .kr-mk-in {
    position: absolute;
    left: 0;
    bottom: 0;
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    transform: translateX(-50%);
  }
  .kr-mk[data-seite="rechts"] .kr-mk-in {
    justify-items: end;
    transform: translateX(calc(-100% + 7px));
  }
  .kr-mk[data-seite="links"] .kr-mk-in {
    justify-items: start;
    transform: translateX(-7px);
  }
  .kr-mk-t {
    font-size: 0.8125rem;
    font-weight: 560;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .kr-mk-p {
    width: 0;
    height: 0;
    border-left: 7px solid transparent;
    border-right: 7px solid transparent;
    border-top: 9px solid var(--color-ink);
  }
  .kr-skala {
    position: relative;

---
/**
 * Werkzeug: Ernährungsplan als Lead-Magnet. Fragen zu Ernährungsform, Laktose, Appetit, Gewicht und Vorlieben wählen
 * einen von 56 Grundplänen für 14 Tage (src/data/ernaehrungsplan.ts); Vorlieben tauschen Gerichte. Die Vorschau rechnet
 * mit demselben Generator im Browser (Tag 1, 14-Tage-Balken), ohne JavaScript steht ein Beispiel.
 * Das Formular postet an api/ernaehrungsplan.js: MailerLite (Double-Opt-in, Gruppen „Newsletter“ und „Ernährungsplan“,
 * Felder `plan` und `vorlieben`); nach der Bestätigung verschickt eine Automation den Link auf die Planseite
 * /ernaehrungsplan/plan/<plan>/?v=<vorlieben> und das PDF. Alternative ohne Newsletter: Mail an site.owner.email.
 * Einrichtung, Test und Pflege: docs/ERNAEHRUNGSPLAN.md.
 */
import Base from '../../layouts/Base.astro';
import Fn from '../../components/Fn.astro';
import Footnotes from '../../components/Footnotes.astro';
import Faq from '../../components/Faq.astro';
import { faqJsonLd } from '../../data/faq';
import { site } from '../../data/site';
import { VORLIEBEN, alleKombinationen } from '../../data/ernaehrungsplan-id.mjs';
import {
  erstellePlan,
  ernaehrungOptionen,
  appetitOptionen,
  gewichtLabel,
  proteinZiel,
  referenzKg,
  vorliebenText,
  erlaubteVorlieben,
  anzahlGerichte,
  TAGE,
} from '../../data/ernaehrungsplan';

const fnIds = ['leidy2015', 'bls', 'dgeBallaststoffe', 'almandoz2024'] as const;
const fn = (id: (typeof fnIds)[number]) => fnIds.indexOf(id) + 1;

// Startwert ohne JavaScript und vor der ersten Eingabe: Mischkost, nicht laktosefrei, Appetit normal, 80 kg.
const START_KG = 80;
const start = erstellePlan({ ernaehrung: 'mischkost', appetit: 'normal', gewicht: '70bis85', laktosefrei: false });
const tag1 = start.tage[0];
const SKALA = 145; // gemeinsame Höhe der 14-Tage-Balken für alle Varianten, damit sie beim Wechsel wachsen und schrumpfen
const erlaubtStart = new Set(erlaubteVorlieben('mischkost', false));
const varianten = alleKombinationen().length;
// Gewichtsregler 45 bis 160 kg; die Stufen als Abschnitte darunter, gleich breit wie ihr Bereich auf dem Regler
const MIN_KG = 45;
const MAX_KG = 160;
const stufen = [
  { g: 'bis70', von: MIN_KG, bis: 70, text: 'unter 70' },
  { g: '70bis85', von: 70, bis: 85, text: '70–85' },
  { g: '85bis100', von: 85, bis: 100, text: '85–100' },
  { g: 'ueber100', von: 100, bis: MAX_KG, text: 'über 100 kg' },
] as const;
// Tag 1 als Balken aus Abschnitten (gleiche Rechnung wie im Skript unten)
const oben1 = Math.max(start.ziel, tag1.protein) * 1.06;
let acc1 = 0;
const segStart = Array.from({ length: 7 }, (_, i) => {
  const m = tag1.mahlzeiten[i];
  const style = `transform:translateX(${((acc1 / oben1) * 100).toFixed(2)}%) scaleX(${m ? Math.max(0, m.protein / oben1 - 0.006).toFixed(4) : 0})`;
  acc1 += m ? m.protein : 0;
  return { style, snack: m?.slot === 'snack' };
});
const breite = (s: (typeof stufen)[number]) => `${(((s.bis - s.von) / (MAX_KG - MIN_KG)) * 100).toFixed(2)}%`;

const title = 'Ernährungsplan nach der Abnehmspritze: 14 Tage kostenlos als PDF';
const description = 'Ein paar Fragen zu Ernährung, Appetit, Gewicht und Vorlieben: dein Plan für 14 Tage mit Mengen, Einkaufslisten, Rezepten und genug Protein, kostenlos per Mail.';
const path = '/ernaehrungsplan/';
const url = `${site.url}${path}`;
const mailBetreff = 'Ernährungsplan ohne Newsletter';
const mailText = 'Hallo Dominik,\n\nich hätte gern den Ernährungsplan, aber ohne Newsletter.\n\nErnährungsform: Mischkost\nLaktosefrei: nein\nAppetit: Wieder normal\nGewicht: 70 bis 85 kg\nVorlieben: keine\n';
const mailHref = `mailto:${site.owner.email}?subject=${encodeURIComponent(mailBetreff)}&body=${encodeURIComponent(mailText)}`;

const faq = [
  {
    q: 'Für wen ist der Plan gedacht?',
    a: '<p>Für gesunde Erwachsene in den Wochen, in denen der Appetit nach der letzten Dosis zurückkommt, und für die Zeit unter der Therapie, in der viele zu wenig Protein essen. Für die zweite Gruppe gibt es die Variante „Appetit noch klein“ mit kleineren Tellern und mehr Zwischenmahlzeiten. Nicht geeignet ist er bei Nierenerkrankungen, in Schwangerschaft und Stillzeit, bei einer Essstörung und für unter 18-Jährige.</p>',
  },
  {
    q: 'Was bewirken die Vorlieben?',
    a: '<p>Gerichte mit den Lebensmitteln, die du ankreuzt, kommen im Plan öfter vor; der Rest bleibt abwechslungsreich, und kein Gericht steht an zwei Tagen hintereinander. Die Mengen rechnet der Plan danach neu, damit jeder Tag dein Proteinziel erreicht. Auf deiner Planseite kannst du Vorlieben jederzeit ändern.</p>',
  },
  {
    q: 'Muss ich mich an die Reihenfolge halten?',
    a: '<p>Nein. Die Tage lassen sich tauschen und wiederholen; wer am Wochenende kocht, bereitet Linsen, Reis oder Quinoa für mehrere Tage vor. Wichtig ist das Muster: bei jeder Mahlzeit zuerst Protein, dazu Gemüse oder Obst, nichts Kalorienhaltiges trinken.</p>',
  },
  {
    q: 'Was, wenn ich kein Fleisch oder keinen Fisch esse?',
    a: '<p>Dann wählst du pescetarisch, vegetarisch oder vegan. Der Plan enthält dann nur passende Gerichte, und die Austauschtabelle zeigt, wie viel Tofu, Tempeh, Linsen, Kichererbsen oder Edamame etwa 20 g Protein liefern. Pflanzliche Lebensmittel liefern pro 100 g meist weniger Protein, deshalb sind die Portionen etwas größer.</p>',
  },
  {
    q: 'Ich vertrage keine Laktose. Geht das?',
    a: '<p>Ja. Mit dem Häkchen „laktosefrei“ nimmt der Plan laktosefreie Milch, Joghurt und Quark und lässt Skyr, Hüttenkäse und Feta weg. Gereifter Hartkäse wie Gouda bleibt drin, er ist von Natur aus praktisch laktosefrei. Vegane Pläne sind immer laktosefrei.</p>',
  },
  {
    q: 'Muss ich Kalorien zählen?',
    a: '<p>Nicht mit diesem Plan. Er arbeitet mit Protein, Ballaststoffen und Portionsgröße statt mit Kalorienzahlen. Ob die Menge passt, zeigt die Waage einmal pro Woche.</p>',
  },
  {
    q: 'Warum kommt der Plan per Mail?',
    a: '<p>Weil wir ihn zusammen mit dem Newsletter verschicken: Nach der Bestätigung deiner Adresse kommt ein Link auf deinen Plan und das PDF, danach etwa alle zwei Wochen neue Artikel und Studien. Auf der Planseite wechselst du die Variante, wenn sich etwas ändert, zum Beispiel der Appetit. Abmelden geht in jeder Mail. Wer keinen Newsletter möchte, schreibt Dominik eine Mail und bekommt den Plan persönlich.</p>',
  },
];

const jsonLd = [
  {
    '@type': 'WebPage',
    '@id': `${url}#page`,
    name: title,
    description,
    url,
    inLanguage: 'de-DE',
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@type': 'Thing', name: 'Ernährung nach dem Absetzen einer Abnehmspritze' },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Werkzeuge', item: `${site.url}/werkzeuge/` },
      { '@type': 'ListItem', position: 3, name: 'Ernährungsplan', item: url },
    ],
  },
  faqJsonLd(faq),
];
---
<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <article class="epf">
    <div class="container-wide">
      <nav aria-label="Brotkrumen" class="epf-krumen"><a href="/">Start</a> › <a href="/werkzeuge/">Werkzeuge</a> › Ernährungsplan</nav>
      <div class="epf-kopf">
        <div>
          <p class="eyebrow">Kostenlos, als Link und PDF per Mail</p>
          <h1 class="h1 epf-h1">Dein kostenloser Ernährungsplan für die Zeit nach der Spritze</h1>
          <p class="epf-lead">Vier Fragen, ein Plan für {TAGE} Tage: Mahlzeiten mit Mengen, genug Protein für deinen Gewichtsbereich, zwei Einkaufslisten, Rezeptkarten und eine Tabelle zum Tauschen. Zusammengestellt aus {anzahlGerichte} alltagstauglichen Gerichten mit Zutaten aus dem Supermarkt.</p>
        </div>
        <dl class="epf-zahlen">
          <div><dt>Tage</dt><dd>{TAGE}</dd></div>
          <div><dt>Gerichte</dt><dd>{anzahlGerichte}</dd></div>
          <div><dt>Grundvarianten</dt><dd>{varianten}</dd></div>
          <div><dt>Vorlieben</dt><dd>{VORLIEBEN.length}</dd></div>
        </dl>
      </div>

      <form id="ep-form" method="post" action="/api/ernaehrungsplan/" class="epf-form plausible-event-name=Ernaehrungsplan+Anfrage">
        <div class="epf-grid">
        <div class="epf-fragen">
          <fieldset class="epf-frage">
            <legend><span class="epf-nr">1</span>Wie isst du?</legend>
            <div class="epf-kacheln epf-kacheln-4">
              {ernaehrungOptionen.map((o) => (
                <label class="epf-kachel">
                  <input type="radio" name="ernaehrung" value={o.value} checked={o.value === 'mischkost'} required />
                  <span class="epf-k-titel">{o.label}</span>
                  <span class="epf-k-text">{o.text}</span>
                </label>
              ))}
            </div>
            <label class="epf-schalter" data-laktose>
              <input type="checkbox" name="laktosefrei" value="ja" />
              <span class="epf-schalter-spur" aria-hidden="true"></span>
              <span><span class="epf-k-titel">Laktosefrei</span> <span class="epf-k-text" data-laktose-text>laktosefreie Milch, Joghurt und Quark; ohne Skyr, Hüttenkäse und Feta</span></span>
            </label>
          </fieldset>

          <fieldset class="epf-frage">
            <legend><span class="epf-nr">2</span>Wie ist dein Appetit gerade?</legend>
            <div class="epf-kacheln epf-kacheln-2">
              {appetitOptionen.map((o) => (
                <label class="epf-kachel">
                  <input type="radio" name="appetit" value={o.value} checked={o.value === 'normal'} required />
                  <span class="epf-k-titel">{o.label}</span>
                  <span class="epf-k-text">{o.text}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="epf-frage">
            <div class="epf-gewicht-kopf">
              <label for="ep-gewicht" class="epf-legende"><span class="epf-nr">3</span>Wie viel wiegst du ungefähr?</label>
              <output id="ep-gewicht-wert" for="ep-gewicht" class="epf-kg">{START_KG} kg</output>
            </div>
            <input id="ep-gewicht" name="gewicht" type="range" min={MIN_KG} max={MAX_KG} step="1" value={START_KG} class="epf-regler" aria-describedby="ep-gewicht-hinweis" />
            <ol class="epf-stufen" aria-hidden="true">
              {stufen.map((s) => (<li data-stufe={s.g} class={s.g === '70bis85' ? 'an' : ''} style={`width:${breite(s)}`}><span>{s.text}</span></li>))}
            </ol>
            <p id="ep-gewicht-hinweis" class="epf-hinweis">Der Plan rechnet mit vier Gewichtsstufen. Gespeichert wird nur die Nummer des passenden Plans, nicht dein Gewicht.</p>
          </div>

          <fieldset class="epf-frage">
            <legend><span class="epf-nr">4</span>Was isst du gern? <span class="epf-optional">freiwillig</span></legend>
            <p class="epf-hinweis epf-hinweis-oben">Gerichte damit kommen öfter vor. Die Auswahl passt sich deiner Ernährungsform an.</p>
            <div class="epf-vorlieben">
              {VORLIEBEN.map((v) => (
                <label class="epf-v" data-v={v.key} data-form={v.form} data-laktose={v.laktose ? 'ja' : undefined} hidden={!erlaubtStart.has(v.key)}>
                  <input type="checkbox" name="v" value={v.key} disabled={!erlaubtStart.has(v.key)} />
                  <span class="epf-v-text"><span class="epf-v-name">{vorliebenText[v.key].label}</span><span class="epf-v-hinweis">{vorliebenText[v.key].hinweis}</span></span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>

        <aside class="epf-vorschau" aria-label="Vorschau auf deinen Plan">
          <div class="epf-pv" data-pv>
            <p class="epf-pv-kopf" aria-live="polite"><span>Dein Plan</span><span data-pv-profil>Mischkost · Appetit wieder normal · 70 bis 85 kg</span></p>
            <p class="epf-pv-ziel"><span class="epf-pv-zahl" data-pv-ziel>{start.ziel}</span><span class="epf-pv-einheit">g Protein am Tag</span></p>
            <p class="epf-pv-rechnung" data-pv-rechnung>1,2 g × {referenzKg['70bis85']} kg, die Mitte deiner Gewichtsstufe<Fn n={fn('leidy2015')} id="leidy2015" /></p>

            <div class="epf-pv-14" role="img" aria-label="Protein an allen 14 Tagen im Zielbereich" data-pv-14>
              <span class="epf-pv-zielwrap" style={`transform:translateY(${(100 - (start.ziel / SKALA) * 100).toFixed(2)}%)`} data-pv-ziellinie><span>Ziel</span></span>
              <ol>
                {start.tage.map((t, i) => (<li style={`--i:${i}`}><b style={`transform:scaleY(${(t.protein / SKALA).toFixed(3)})`}></b></li>))}
              </ol>
            </div>
            <p class="epf-pv-unter"><span>Tag 1</span><span>14 Tage, jeder Tag im Ziel</span></p>

            <div class="epf-pv-tag">
              <div class="epf-pv-balken" aria-hidden="true" data-pv-balken>
                {segStart.map((x) => (<b class={x.snack ? 'snack' : ''} style={x.style}></b>))}
                <i data-pv-tagziel style={`transform:translateX(${((start.ziel / oben1) * 100).toFixed(2)}%)`}></i>
              </div>
              <ol class="epf-pv-liste" data-pv-liste>
                {tag1.mahlzeiten.map((m) => (<li class={m.slot === 'snack' ? 'snack' : ''}><span class="epf-pv-slot">{m.titel}</span><span class="epf-pv-name"><span>{m.name}</span></span><span class="epf-pv-g">{m.protein} g</span></li>))}
              </ol>
              <p class="epf-pv-summe"><span>Protein an Tag 1</span><span><strong data-pv-summe>{tag1.protein} g</strong> von <span data-pv-ziel2>{start.ziel}</span> g</span></p>
            </div>
            <p class="epf-pv-fuss">Im Plan: alle {TAGE} Tage mit Mengen, Einkaufslisten für zwei Wochen, Rezeptkarten, Austauschtabelle. Proteinwerte aus dem Bundeslebensmittelschlüssel, gerundet.<Fn n={fn('bls')} id="bls" /></p>
          </div>
        </aside>
        </div>

        <div class="epf-senden band">
          <div class="epf-senden-text">
            <p class="epf-nr epf-nr-hell">5</p>
            <h2 class="h2 epf-senden-h">Wohin sollen wir den Plan schicken?</h2>
            <p class="band-muted">Du bekommst einen Link auf deine Planseite und das PDF. Auf der Seite kannst du später die Variante wechseln oder Vorlieben ändern, ohne neue Mail.</p>
          </div>
          <div class="epf-senden-form">
            <label for="ep-email" class="sr-only">E-Mail-Adresse</label>
            <div class="epf-zeile">
              <input id="ep-email" name="email" type="email" autocomplete="email" required placeholder="Deine E-Mail-Adresse" />
              <button type="submit" class="btn-primary">Plan anfordern</button>
            </div>
            <label class="epf-check">
              <input type="checkbox" name="eignung" value="ja" required />
              <span>Keiner dieser Punkte trifft auf mich zu: Nierenerkrankung, Schwangerschaft oder Stillzeit, Essstörung (auch früher), jünger als 18 Jahre. <span class="band-muted">Trifft einer zu, ist ein allgemeiner Plan nicht das Richtige; sprich dann mit deiner Ärztin, deinem Arzt oder einer Ernährungsfachkraft.</span></span>
            </label>
            <label class="epf-check">
              <input type="checkbox" name="einwilligung" value="ja" required />
              <span>Schickt mir den Plan per Mail und meldet mich für den Newsletter von Nach der Spritze an ({site.newsletter.cadence}: neue Artikel und Studien zur Zeit nach der Abnehmspritze, gelegentlich Neuigkeiten zum Programm). Der Plan kommt, sobald ich die Anmeldung per Link bestätigt habe. Abmelden geht in jeder Mail. Details in der <a href="/datenschutz/">Datenschutzerklärung</a>.</span>
            </label>
            <div class="hidden" aria-hidden="true">
              <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
            </div>
            <p class="epf-mikro band-muted">Kostenlos. Keine Weitergabe deiner Adresse. Gespeichert werden Adresse, Plannummer und Vorlieben, nicht dein Gewicht.</p>
            <p class="epf-ohne">Lieber ohne Newsletter? Schreib mir eine Mail mit deinen Antworten an <a id="ep-mail" href={mailHref}>{site.owner.email}</a>, dann schicke ich dir den Plan persönlich. Dominik</p>
          </div>
        </div>
      </form>

      <div class="epf-text">
        <div class="prose-site">
          <h2 id="so-entsteht-der-plan">So entsteht dein Plan</h2>
          <ul>
            <li><strong>Protein nach Gewichtsbereich.</strong> Übersichtsarbeiten empfehlen während Gewichtsabnahme und Gewichtserhalt 1,2 bis 1,6 g Protein pro kg Körpergewicht und Tag.<Fn n={fn('leidy2015')} id="leidy2015" /> Die Pläne rechnen mit dem unteren Wert und der Mitte der Gewichtsstufe: rund {proteinZiel.bis70} g bei {gewichtLabel.bis70}, {proteinZiel['70bis85']} g bei {gewichtLabel['70bis85']}, {proteinZiel['85bis100']} g bei {gewichtLabel['85bis100']} und {proteinZiel.ueber100} g bei {gewichtLabel.ueber100} (gerechnet mit {referenzKg.ueber100} kg; wer deutlich mehr wiegt, findet sein Ziel im <a href="/werkzeuge/proteinrechner/">Proteinrechner</a>).</li>
            <li><strong>Mengen, die aufgehen.</strong> Jedes Gericht hat ein Grundrezept für eine normale Portion. Ein Faktor je Tag passt die Mengen an, bis der Tag das Ziel erreicht; jede Zutat zählt mit ihrem Proteingehalt aus dem Bundeslebensmittelschlüssel.<Fn n={fn('bls')} id="bls" /> Der Rechenweg steht im Plan.</li>
            <li><strong>Portionen nach Appetit.</strong> Ist der Appetit noch klein, sind Frühstück, Mittag und Abend kleiner, und es gibt zwei bis vier proteinreiche Zwischenmahlzeiten. Ist er wieder normal, reichen drei Mahlzeiten und bis zu zwei kleine dazwischen.</li>
            <li><strong>Abwechslung.</strong> {anzahlGerichte} Gerichte, kein Gericht an zwei Tagen hintereinander. Bei Mischkost gibt es Fleisch an drei und Fisch an zwei Tagen pro Woche, sonst Eier, Milchprodukte und Hülsenfrüchte. Deine Vorlieben verschieben die Auswahl, nicht das Ziel.</li>
            <li><strong>Ballaststoffe und Trinken.</strong> Hülsenfrüchte, Haferflocken und Vollkorn bringen dich in Richtung der 30 g Ballaststoffe, die die DGE empfiehlt.<Fn n={fn('dgeBallaststoffe')} id="dgeBallaststoffe" /> Für Flüssigkeit nennen Expertenempfehlungen zur Ernährung unter Adipositas-Medikamenten zwei bis drei Liter am Tag.<Fn n={fn('almandoz2024')} id="almandoz2024" /></li>
            <li><strong>Keine Kalorienvorgabe.</strong> Der Plan steuert Protein, Ballaststoffe und Portionsgröße.</li>
          </ul>
          <p>Ein allgemeiner Beispielplan für gesunde Erwachsene, keine Ernährungstherapie. Die Regeln dahinter stehen im Artikel <a href="/wissen/ernaehrung-nach-abnehmspritze/">Ernährung nach der Abnehmspritze</a>; dein genaues Proteinziel rechnet der <a href="/werkzeuge/proteinrechner/">Proteinrechner</a> aus.</p>
          <p class="epf-arzt">{site.doctorSentence}</p>
        </div>

        <div class="epf-faq"><Faq items={faq} id="plan-faq" title="Häufige Fragen zum Ernährungsplan" /></div>

        <Footnotes ids={fnIds} />
      </div>
    </div>
  </article>
</Base>

<script>
  import { erstellePlan, planId, erlaubteVorlieben, gewichtLabel, referenzKg, vorliebenText, type Ernaehrung, type Appetit, type Vorliebe } from '../../data/ernaehrungsplan';
  import { gewichtsstufe } from '../../data/ernaehrungsplan-id.mjs';

  const form = document.getElementById('ep-form') as HTMLFormElement | null;
  if (form) {
    const SKALA = 145;
    const $ = <T extends Element = HTMLElement>(s: string) => form.querySelector<T>(s)!;
    const slider = $<HTMLInputElement>('#ep-gewicht');
    const kgWert = $('#ep-gewicht-wert');
    const lfBox = $<HTMLInputElement>('input[name="laktosefrei"]');
    const lfText = $('[data-laktose-text]');
    const stufen = [...form.querySelectorAll<HTMLElement>('[data-stufe]')];
    const vBoxen = [...form.querySelectorAll<HTMLElement>('[data-v]')];
    const pv = $('[data-pv]');
    const zielEl = $('[data-pv-ziel]');
    const ziel2 = $('[data-pv-ziel2]');
    const summeEl = $('[data-pv-summe]');
    const profil = $('[data-pv-profil]');
    const rechnung = $('[data-pv-rechnung]');
    const zielLinie = $('[data-pv-ziellinie]');
    const balken14 = [...form.querySelectorAll<HTMLElement>('[data-pv-14] b')];
    const segs = [...form.querySelectorAll<HTMLElement>('[data-pv-balken] b')];
    const tagZiel = $('[data-pv-tagziel]');
    const liste = $('[data-pv-liste]');
    const mail = document.getElementById('ep-mail') as HTMLAnchorElement | null;
    const rm = document.documentElement.classList.contains('rm');
    const fnRechnung = rechnung.querySelector('sup')?.outerHTML ?? '';
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);
    const label: Record<string, string> = { mischkost: 'Mischkost', pescetarisch: 'Pescetarisch', vegetarisch: 'Vegetarisch', vegan: 'Vegan', klein: 'Appetit noch klein', normal: 'Appetit wieder normal' };
    let letzteListe = '';
    let erstesMal = true; // beim ersten Rechnen steht schon dasselbe da: ohne Überblendung austauschen
    let zielJetzt = Number(zielEl.textContent) || 0;
    let summeJetzt = Number.parseInt(summeEl.textContent ?? '0', 10) || 0;

    /** Zahl weich hochzählen (oder sofort bei reduzierter Bewegung). */
    function zaehle(el: HTMLElement, von: number, bis: number, suffix = '') {
      if (rm || von === bis) {
        el.textContent = `${bis}${suffix}`;
        return;
      }
      const t0 = performance.now();
      const schritt = (t: number) => {
        const p = Math.min(1, (t - t0) / 600);
        const e = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
        el.textContent = `${Math.round(von + (bis - von) * e)}${suffix}`;
        if (p < 1) requestAnimationFrame(schritt);
      };
      requestAnimationFrame(schritt);
    }

    function update() {
      const e = (form!.elements.namedItem('ernaehrung') as RadioNodeList).value as Ernaehrung;
      const a = (form!.elements.namedItem('appetit') as RadioNodeList).value as Appetit;
      const kg = Number(slider.value);
      const g = gewichtsstufe(kg) ?? '70bis85';
      const vegan = e === 'vegan';
      lfBox.disabled = vegan;
      if (vegan) lfBox.checked = true;
      lfText.textContent = vegan ? 'vegan ist immer laktosefrei' : 'laktosefreie Milch, Joghurt und Quark; ohne Skyr, Hüttenkäse und Feta';
      const lf = vegan || lfBox.checked;
      kgWert.textContent = kg >= 160 ? '160+ kg' : `${kg} kg`;
      stufen.forEach((s) => s.classList.toggle('an', s.dataset.stufe === g));

      const erlaubt = new Set(erlaubteVorlieben(e, lf));
      vBoxen.forEach((l) => {
        const ok = erlaubt.has(l.dataset.v as Vorliebe);
        const input = l.querySelector('input')!;
        l.hidden = !ok;
        input.disabled = !ok;
      });
      const v = vBoxen.filter((l) => !l.hidden && l.querySelector('input')!.checked).map((l) => l.dataset.v as Vorliebe);

      const plan = erstellePlan({ ernaehrung: e, appetit: a, gewicht: g, laktosefrei: lf, vorlieben: v });
      const tag = plan.tage[0];
      profil.textContent = `${label[e]}${lf && !vegan ? ', laktosefrei' : ''} · ${label[a]} · ${gewichtLabel[g]}`;
      zaehle(zielEl, zielJetzt, plan.ziel);
      zielJetzt = plan.ziel;
      ziel2.textContent = String(plan.ziel);
      rechnung.innerHTML = `1,2 g × ${referenzKg[g]} kg, die Mitte deiner Gewichtsstufe${fnRechnung}`;

      // 14 Tage: Balken wachsen oder schrumpfen, die Ziellinie wandert mit
      plan.tage.forEach((t, i) => balken14[i] && (balken14[i].style.transform = `scaleY(${(t.protein / SKALA).toFixed(3)})`));
      zielLinie.style.transform = `translateY(${(100 - (plan.ziel / SKALA) * 100).toFixed(2)}%)`;

      // Tag 1: Abschnitte des Balkens verschieben sich, statt zu springen
      const oben = Math.max(plan.ziel, tag.protein) * 1.06;
      let acc = 0;
      segs.forEach((s, i) => {
        const m = tag.mahlzeiten[i];
        const w = m ? m.protein / oben : 0;
        s.style.transform = `translateX(${((acc / oben) * 100).toFixed(2)}%) scaleX(${Math.max(0, w - 0.006).toFixed(4)})`;
        s.classList.toggle('snack', !!m && m.slot === 'snack');
        acc += m ? m.protein : 0;
      });
      tagZiel.style.transform = `translateX(${((plan.ziel / oben) * 100).toFixed(2)}%)`;
      zaehle(summeEl, summeJetzt, tag.protein, ' g');
      summeJetzt = tag.protein;

      const html = tag.mahlzeiten
        .map((m, i) => `<li class="${m.slot === 'snack' ? 'snack' : ''}${m.bevorzugt ? ' fav' : ''}" style="--i:${i}"><span class="epf-pv-slot">${esc(m.titel)}</span><span class="epf-pv-name"><span>${esc(m.name)}</span></span><span class="epf-pv-g">${m.protein} g</span></li>`)
        .join('');
      if (html !== letzteListe) {
        letzteListe = html;
        if (rm || erstesMal) liste.innerHTML = html;
        else {
          liste.classList.add('wechsel');
          window.setTimeout(() => {
            liste.innerHTML = html;
            requestAnimationFrame(() => liste.classList.remove('wechsel'));
          }, 180);
        }
      }

      erstesMal = false;

      if (mail) {
        const text = `Hallo Dominik,\n\nich hätte gern den Ernährungsplan, aber ohne Newsletter.\n\nErnährungsform: ${label[e]}\nLaktosefrei: ${lf ? 'ja' : 'nein'}\nAppetit: ${label[a].replace('Appetit ', '')}\nGewicht: ${gewichtLabel[g]}\nVorlieben: ${v.length ? v.map((x) => vorliebenText[x].label).join(', ') : 'keine'}\n\n(Plan ${planId(e, a, g, lf)}${v.length ? `, v=${v.join(',')}` : ''})\n`;
        mail.href = `mailto:${mail.textContent?.trim()}?subject=${encodeURIComponent('Ernährungsplan ohne Newsletter')}&body=${encodeURIComponent(text)}`;
      }
    }

    // Erst wenn die Vorschau sichtbar ist: Balken aus null wachsen lassen
    const start = () => {
      pv.classList.add('in');
      update();
    };
    if (!rm && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        if (es.some((x) => x.isIntersecting)) {
          io.disconnect();
          start();
        }
      }, { threshold: 0.25 });
      io.observe(pv);
    } else start();
    form.addEventListener('change', update);
    slider.addEventListener('input', update);
  }
</script>


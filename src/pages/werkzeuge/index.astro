---
/** Übersicht der Werkzeuge: Rechner und Hilfen, die im Browser laufen, plus die Nachschlageseiten der Website. */
import Base from '../../layouts/Base.astro';
import SeitenKopf from '../../components/SeitenKopf.astro';
import Pfeil from '../../components/Pfeil.astro';
import Faq from '../../components/Faq.astro';
import { faqJsonLd } from '../../data/faq';
import { site } from '../../data/site';

const title = 'Rechner zur Abnehmspritze: Zeitplan, Protein, Gewicht, Kosten';
const description =
  'Rechner zur Abnehmspritze, kostenlos und ohne Anmeldung: Zeitplan nach der letzten Dosis, Proteinziel, Gewichtskorridor und Jahreskosten, alles im Browser.';
const path = '/werkzeuge/';
const url = `${site.url}${path}`;

const rechner = [
  { href: '/werkzeuge/zeitplan-nach-letzter-dosis/', name: 'Zeitplan nach der letzten Dosis', text: 'Datum und Wirkstoff eingeben: wann der Wirkstoff abgebaut ist, wann der Appetit meist zurückkommt, ab welcher Woche Studien eine Zunahme messen. Mit Kalender-Export.' },
  { href: '/ernaehrungsplan/', name: 'Ernährungsplan für 14 Tage', text: 'Vier Fragen zu Ernährungsform, Unverträglichkeit, Appetit und Gewicht, dazu deine Lieblingsspeisen. Daraus entsteht dein Plan mit Mengen, Einkaufsliste und Rezeptkarten. Kostenlos als PDF.' },
  { href: '/werkzeuge/proteinrechner/', name: 'Proteinrechner', text: 'Körpergewicht eingeben: Tagesziel von 1,2 bis 1,6 g pro kg, Menge pro Mahlzeit und Beispiele in Lebensmitteln.' },
  { href: '/werkzeuge/gewichtskorridor/', name: 'Gewichtskorridor', text: 'Startgewicht der Haltephase eingeben: drei Zonen wie eine Ampel (grün, gelb, rot) und was du in jeder Zone tust. Die Grenzen stammen aus einem Programm, das in einer Studie geprüft wurde.' },
  { href: '/abnehmspritze-kosten/#rechner', name: 'Jahreskosten-Rechner', text: 'Präparat und Dauer wählen: Kosten pro Jahr, pro Tag und für die gewählte Dauer, aus der monatlichen Preiserhebung. Größenordnung, keine Preisberatung.' },
];
const nachschlagen = [
  { href: '/checkliste/', name: 'Checkliste für die ersten 8 Wochen', text: 'Woche für Woche: Protein, Training, Wiegetag. Als Seite und als PDF.' },
  { href: '/grafiken/', name: 'Studien-Grafiken', text: 'Absetzkurve, Zeitachse, Halbwertszeiten, Proteinbedarf und mehr als SVG und PNG, frei verwendbar mit Quellenangabe.' },
  { href: '/wissen/studien/', name: 'Studien-Tracker', text: 'Alle Absetz-Studien mit Kernzahl und Link zur Originalarbeit.' },
  { href: '/marktradar/', name: 'Marktradar', text: 'Zulassungen, Preise als Größenordnung, Kassenregeln, Lieferbarkeit; monatlich geprüft.' },
  { href: '/glossar/', name: 'Glossar', text: 'Begriffe von Absetzkurve bis Telogenes Effluvium, kurz und belegt.' },
];
const alle = [...rechner, ...nachschlagen];

const faq = [
  {
    q: 'Speichern die Rechner meine Eingaben?',
    a: '<p>Nein. Alle Werkzeuge rechnen im Browser; nichts wird übertragen oder gespeichert. Es gibt keine Anmeldung und keine Cookies. Die Kalenderdatei des Zeitplans entsteht ebenfalls im Browser und wird nur heruntergeladen.</p>',
  },
  {
    q: 'Woher kommen die Zahlen in den Werkzeugen?',
    a: '<p>Aus Fachinformationen (Halbwertszeiten), Studien (Zunahme ab Woche 8, Wiederzunahme nach einem Jahr, Zonen des Gewichtskorridors, Proteinbedarf) und aus der monatlichen Preiserhebung des Marktradars. Jede Seite nennt ihre Quellen mit Link.</p>',
  },
  {
    q: 'Ersetzen die Werkzeuge einen Arzttermin?',
    a: '<p>Nein. Sie geben Orientierung, keine Diagnose und keine Therapieentscheidung. Ob und wie ein Medikament abgesetzt wird, entscheidet die behandelnde Ärztin oder der Arzt; kein Werkzeug enthält Dosierungen oder Absetz-Schemata.</p>',
  },
];

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${url}#page`,
    name: title,
    description,
    url,
    inLanguage: 'de-DE',
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: alle.map((w, i) => ({ '@type': 'ListItem', position: i + 1, name: w.name, url: `${site.url}${w.href}` })),
    },
  },
  faqJsonLd(faq),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Werkzeuge', item: url },
    ],
  },
];
---
<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <SeitenKopf crumbs={[{ href: '/', label: 'Start' }, { label: 'Werkzeuge' }]} meta="Werkzeuge, ohne Anmeldung und ohne Speicherung" title="Rechner und Hilfen für die Zeit nach der Abnehmspritze">
    <p>Vier Rechner für die Fragen, die nach der letzten Dosis zuerst kommen: Wann ist der Wirkstoff weg, wie viel Protein brauche ich, ab welcher Zahl auf der Waage reagiere ich, und was kostet die Therapie im Jahr. Die Rechner laufen im Browser, ohne Anmeldung und ohne Speicherung. Nur den Ernährungsplan schicken wir per Mail. Die Zahlen dahinter stammen aus Fachinformationen und Studien; die Quellen stehen auf jeder Seite.</p>
  </SeitenKopf>

  <div class="container-wide k-end">
    <section class="k-sec-s" aria-labelledby="rechner-h">
      <h2 id="rechner-h" class="k-h2" data-rv>Rechner</h2>
      <ol class="k-rows wz">
        {rechner.map((w, i) => (
          <li data-rv style={`--i:${i}`}><a href={w.href} class="k-row wz-row"><span class="wz-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="k-row-t">{w.name}</span><span class="k-row-d">{w.text}</span><Pfeil /></a></li>
        ))}
      </ol>
    </section>

    <section class="k-sec" aria-labelledby="nachschlagen-h">
      <h2 id="nachschlagen-h" class="k-h2" data-rv>Nachschlagen</h2>
      <ul class="k-rows k-cols-2 wz-n2">
        {nachschlagen.map((w, i) => (
          <li data-rv style={`--i:${i % 2}`}><a href={w.href} class="k-row"><span class="k-row-t">{w.name}</span><span class="k-row-d">{w.text}</span><Pfeil /></a></li>
        ))}
      </ul>
    </section>

    <div class="wz-text">
      <div class="prose-site">
        <h2 id="warum">Warum Rechner statt noch mehr Text</h2>
        <p>Die Artikel im <a href="/wissen/">Wissensbereich</a> erklären, was nach dem Absetzen passiert und was dagegen hilft. Die Werkzeuge machen daraus deine Zahlen: dein Datum, an dem Semaglutid oder Tirzepatid weitgehend abgebaut ist, dein Proteinziel, deinen Gewichtskorridor, deine Jahreskosten. Mit konkreten Zahlen hast du etwas, woran du die Wochen misst. Den Rahmen dazu gibt der Hauptartikel <a href="/wissen/abnehmspritze-absetzen/">Abnehmspritze absetzen</a>; die Reihenfolge der ersten acht Wochen steht in der <a href="/checkliste/">Checkliste</a>.</p>
      </div>

      <div class="wz-faq">
        <Faq items={faq} id="werkzeuge-faq" title="Häufige Fragen zu den Werkzeugen" />
      </div>
    </div>
  </div>
</Base>

<style>
  .wz-row {
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    padding: 1.6rem 0;
  }
  .wz-row .k-row-t, .wz-row .k-row-d {
    grid-column: 2;
  }
  .wz-row .k-row-t {
    font-size: clamp(1.375rem, 2.4vw, 2rem);
    font-stretch: 118%;
    letter-spacing: -0.018em;
  }
  .wz-row > :global(svg) {
    grid-column: 3;
  }
  .wz-n {
    grid-column: 1;
    grid-row: 1 / span 2;
    font-stretch: 125%;
    font-weight: 480;
    font-size: 1rem;
    line-height: 2.1;
    color: var(--color-ink-3);
  }
  .wz-n2 {
    margin-top: 2rem;
  }
  @media (min-width: 760px) {
    .wz-n2 {
      border-top: 0;
    }
    .wz-n2 > li:nth-child(-n + 2) {
      border-top: 1px solid var(--color-line);
    }
  }
  .wz-text {
    max-width: 45rem;
    margin-top: clamp(3rem, 8vh, 5rem);
  }
  .wz-faq {
    margin-top: 4rem;
  }
  @media (max-width: 640px) {
    .wz-row {
      grid-template-columns: 2.25rem minmax(0, 1fr) auto;
      gap: 0.4rem 0.75rem;
    }
  }
</style>

---
/**
 * Absetzkurve der STEP-1-Verlängerung (Quelle wilding2022ext) als statisches SVG im Endzustand; die Startseite zeichnet
 * sie beim Scrollen (Skript in src/pages/index.astro über data-k-Attribute). Messpunkte: Woche 0, 68, 120
 * (−17,3 % und −5,6 %; Placebo −2,0 % und −0,1 %). Die Linien dazwischen sind schematisch (Bézier-Kurven).
 * Zusammensetzung des Verlusts: rund 40 % fettfreie Masse (wilding2021dxa), erscheint nur im vierten Schritt.
 * Zwei Fassungen: Desktop (760 × 520) und Handy (360 × 400), damit die Schrift auf beiden lesbar bleibt.
 */
interface Props { variant: 'd' | 'm'; label: string }
const { variant, label } = Astro.props;
const mob = variant === 'm';
const W = mob ? 360 : 760;
const H = mob ? 400 : 520;
const m = mob ? { l: 40, r: 78, t: 30, b: 36 } : { l: 56, r: 150, t: 36, b: 44 };
const r1 = (n: number) => Math.round(n * 10) / 10;
const x = (w: number) => r1(m.l + (w / 120) * (W - m.l - m.r));
const y = (v: number) => r1(m.t + ((2 - v) / 22) * (H - m.t - m.b));
type Pt = [number, number];
const D: Record<string, Pt[]> = {
  sema1: [[0, 0], [22, -10.5], [44, -17.5], [68, -17.3]],
  sema2: [[68, -17.3], [77, -17.2], [86, -9.2], [120, -5.6]],
  pla1: [[0, 0], [16, -1.7], [40, -2.2], [68, -2.0]],
  pla2: [[68, -2.0], [84, -1.8], [100, -0.6], [120, -0.1]],
};
const P = (pts: Pt[]) => `M${x(pts[0][0])} ${y(pts[0][1])} C${pts.slice(1).map((p) => `${x(p[0])} ${y(p[1])}`).join(' ')}`;
// Punkt auf der Bézier-Kurve (für die Beschriftung „Semaglutid“)
const bez = (pts: Pt[], t: number): Pt => {
  const c = [(1 - t) ** 3, 3 * (1 - t) ** 2 * t, 3 * (1 - t) * t ** 2, t ** 3];
  return [c.reduce((s, k, i) => s + k * x(pts[i][0]), 0), c.reduce((s, k, i) => s + k * y(pts[i][1]), 0)];
};
const sp = bez(D.sema1, 0.3);

const grid = [0, -5, -10, -15, -20];
const gridLabel = (v: number) => (v === 0 ? '0 %' : v === -20 ? '−20 %' : `−${Math.abs(v)}`);
const xLabels: [number, string, string][] = [[0, '0', 'start'], [68, '68', 'middle'], [120, mob ? '120 Wo.' : '120 Wochen', 'end']];

const by = y(-17.3) + (mob ? 22 : 30);
// Klammer rechts: von −17,3 bis −5,6 = zwei Drittel des Verlusts
const bx = x(120) + (mob ? 14 : 22);
const b1 = y(-5.6);
const b2 = y(-17.3);
const bm = r1((b1 + b2) / 2);
const d = 8;
const brace = `M${bx - d} ${b1} Q${bx} ${b1} ${bx} ${b1 + 12} L${bx} ${bm - 10} Q${bx} ${bm} ${bx + d} ${bm} Q${bx} ${bm} ${bx} ${bm + 10} L${bx} ${b2 - 12} Q${bx} ${b2} ${bx - d} ${b2}`;
const hlW = mob ? 50 : 104;
const hlH = mob ? 42 : 32;
const hlX = bx + (mob ? 10 : 14);

// Zusammensetzung bei Woche 68: Balken von 0 bis −17,3, 60 % Fett oben, 40 % fettfreie Masse unten
const cw = mob ? 14 : 20;
const cx = r1(x(68) - cw / 2);
const top = y(0);
const bot = y(-17.3);
const fatH = r1((bot - top) * 0.6);
const leanY = r1(top + fatH);
const leanH = r1(bot - top - fatH);
---
<svg class={`kv kv-${variant}`} data-kv={variant} viewBox={`0 0 ${W} ${H}`} width={W} height={H} preserveAspectRatio="xMidYMid meet" role="img" aria-label={label}>
  <g data-k="grid" class="kv-grid">
    {grid.map((v) => (<line x1={m.l} x2={W - m.r + 6} y1={y(v)} y2={y(v)} />))}
    {grid.map((v) => (<text x={m.l - 10} y={y(v) + 4} text-anchor="end">{gridLabel(v)}</text>))}
    {xLabels.map(([w, t, a]) => (<text x={x(w)} y={H - m.b + 24} text-anchor={a}>{t}</text>))}
  </g>
  <g class="kv-plg">
    <path data-k="pla1" class="kv-placebo" d={P(D.pla1)} />
    <path data-k="pla2" class="kv-placebo" d={P(D.pla2)} />
    {!mob && <text data-k="plLab" x={x(120)} y={y(-0.1) - 12} text-anchor="end">Placebo −0,1 %</text>}
  </g>
  <g data-k="dose">
    <line data-k="doseL" class="kv-dose" x1={x(68)} x2={x(68)} y1={m.t - 6} y2={H - m.b} />
    <text class="kv-lab" x={x(68) + 10} y={m.t + 8}>letzte Dosis</text>
  </g>
  <g data-k="eight">
    <path class="kv-dose" fill="none" d={`M${x(68)} ${by - 6} V${by} H${x(76)} V${by - 6}`} />
    <text x={x(76) + 8} y={by + 4}>{mob ? '≈ 8 Wo.' : '≈ 8 Wochen'}</text>
  </g>
  <path data-k="sema1" class="kv-weight" d={P(D.sema1)} pathLength="1" />
  <path data-k="sema2" class="kv-regain" d={P(D.sema2)} pathLength="1" />
  <text data-k="semaT" class="kv-lab" x={r1(mob ? sp[0] + 12 : sp[0] - 14)} y={r1(sp[1] + 4)} text-anchor={mob ? 'start' : 'end'}>Semaglutid</text>
  <g data-k="p1">
    <circle class="kv-mdot" cx={x(68)} cy={y(-17.3)} r="5.5" />
    <text class="kv-lab" x={x(68) - 10} y={y(-17.3) + 24} text-anchor="end">−17,3 %</text>
  </g>
  <g data-k="p2">
    <circle class="kv-rdot" cx={x(120)} cy={y(-5.6)} r="5.5" />
    <text class="kv-lab-r" x={x(120) - 14} y={y(-5.6) - 12} text-anchor="end">−5,6 %</text>
  </g>
  <g data-k="braceG">
    <path data-k="brace" class="kv-brace" d={brace} pathLength="1" />
    <rect class="kv-hlbox" x={hlX} y={bm - hlH / 2} width={hlW} height={hlH} rx="4" />
    {mob
      ? <><text class="kv-hltxt" x={hlX + hlW / 2} y={bm - 3} text-anchor="middle">2/3</text><text class="kv-hltxt kv-hlsm" x={hlX + hlW / 2} y={bm + 13} text-anchor="middle">zurück</text></>
      : <text class="kv-hltxt" x={hlX + hlW / 2} y={bm + 5} text-anchor="middle">2/3 zurück</text>}
  </g>
  <g data-k="comp" class="kv-comp">
    <rect data-k="fat" class="kv-fat" x={cx} y={top} width={cw} height={fatH} rx="3" />
    <rect data-k="lean" class="kv-lean" x={cx} y={leanY} width={cw} height={leanH} rx="3" />
    <text class="kv-lab" x={cx - 12} y={r1(top + fatH / 2 + 5)} text-anchor="end">{mob ? '≈ 60 % Fett' : '≈ 60 % Fettmasse'}</text>
    <text class="kv-lab kv-lab-l" x={cx - 12} y={r1(leanY + leanH / 2 + 5)} text-anchor="end">{mob ? '≈ 40 % fettfrei' : '≈ 40 % fettfreie Masse'}</text>
  </g>
  <g data-k="mover" class="kv-mover">
    <circle data-k="md" r="6" cx="0" cy="0" />
    <text data-k="mt" class="kv-mlab" text-anchor="middle" x="0" y="0"></text>
  </g>
</svg>

<style>
  .kv {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .kv text {
    font-family: var(--font-sans);
    font-stretch: 100%;
    fill: var(--color-ink-3);
    font-size: 13px;
  }
  .kv-m text {
    font-size: 12.5px;
  }
  .kv .kv-lab {
    fill: var(--color-ink);
    font-weight: 560;
    font-size: 15px;
  }
  .kv-m .kv-lab {
    font-size: 13.5px;
  }
  .kv .kv-lab-l {
    fill: var(--color-moss);
  }
  .kv .kv-lab-r {
    fill: var(--color-clay);
    font-weight: 600;
    font-size: 15px;
  }
  .kv-grid line {
    stroke: var(--color-line);
    stroke-width: 1;
  }
  .kv-weight {
    stroke: var(--color-ink);
    stroke-width: 3;
    fill: none;
    stroke-linecap: round;
  }
  .kv-regain {
    stroke: var(--color-clay);
    stroke-width: 3;
    fill: none;
    stroke-linecap: round;
  }
  .kv-placebo {
    stroke: var(--color-placebo);
    stroke-width: 2;
    fill: none;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
  }
  .kv-dose {
    stroke: var(--color-ink);
    stroke-width: 1.25;
  }
  .kv-brace {
    stroke: var(--color-clay);
    stroke-width: 2;
    fill: none;
  }
  .kv-hlbox {
    fill: var(--color-amber);
  }
  .kv .kv-hltxt {
    fill: var(--color-ink);
    font-weight: 600;
    font-size: 15px;
  }
  .kv .kv-hlsm {
    font-size: 12px;
  }
  .kv-mdot {
    fill: var(--color-ink);
  }
  .kv-rdot {
    fill: var(--color-clay);
  }
  .kv-fat {
    fill: var(--color-sand);
    stroke: var(--color-sand-edge);
    stroke-width: 1;
  }
  .kv-lean {
    fill: var(--color-moss);
  }
  .kv-comp, .kv-mover {
    opacity: 0;
  }
  /* Endzustand ohne Skript oder mit reduzierter Bewegung: Zusammensetzung des Verlusts sichtbar (Schritt 4 steht im Text
     darunter); der laufende Punkt bleibt weg, er zeigt nur die Zeit während der Bewegung. */
  :global(html.rm) .kv-comp, :global(html:not(.js)) .kv-comp {
    opacity: 1;
  }
  .kv .kv-mlab {
    fill: var(--color-ink);
    font-size: 13px;
    font-weight: 540;
  }
  .kv-plg {
    transition: opacity 0.5s var(--ease);
  }
  :global(.pl-off) .kv-plg {
    opacity: 0 !important;
  }
</style>

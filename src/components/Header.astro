---
import Logo from './Logo.astro';
import NewsletterPanel from './NewsletterPanel.astro';
import { nav } from '../data/site';
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/90 backdrop-blur supports-[backdrop-filter]:bg-paper/75">
  <div class="container-wide relative flex h-16 items-center justify-between gap-3">
    <a href="/" class="shrink-0 whitespace-nowrap no-underline" aria-label="Nach der Spritze – Startseite"><Logo /></a>
    <nav aria-label="Hauptnavigation" class="hidden items-center gap-6 text-sm font-medium text-ink-2 md:flex">
      {nav.map((item) => (
        <a href={item.href} class="hover:text-moss">{item.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <NewsletterPanel />
      <a href="/#vorbestellen" class="btn-primary !px-2.5 !py-1.5 text-xs sm:!px-4 sm:!py-2 sm:text-sm plausible-event-name=Vorbestellen+Klick plausible-event-position=header">Vorbestellen</a>
    </div>
  </div>
</header>

---
/**
 * Werkzeug: Zeitplan nach der letzten Dosis. Rechnet aus Datum und Wirkstoff die Orientierungspunkte aus Fachinformation
 * (Halbwertszeit, Faustregel fünf Halbwertszeiten) und Studien (Zunahme ab Woche 8, Wu 2025; Ein-Jahres-Daten) in Daten um.
 * Kein Absetz-Plan, keine Dosierung: Das Werkzeug beginnt nach der letzten Dosis. Rechnet nur im Browser, speichert nichts.
 * Seit 06.10.2026 ohne Kontrolltermin und ohne Handlungsempfehlungen: Jeder Zeitpunkt steht als Woche nach der letzten Dosis
 * mit Herkunft (Fachinformation, Studien), als allgemeine Orientierung, nicht als Vorhersage.
 * Gestaltung „Kalk“ seit 06.10.2026: Ergebnis zusätzlich als Bild über 20 Wochen (dieselben Daten, Bahnen zeichnen sich),
 * rechnet neu, sobald Datum oder Wirkstoff sich ändern.
 */
import Base from '../../../layouts/Base.astro';
import SeitenKopf from '../../../components/SeitenKopf.astro';
import Fn from '../../../components/Fn.astro';
import Footnotes from '../../../components/Footnotes.astro';
import ProductTeaser from '../../../components/ProductTeaser.astro';
import Faq from '../../../components/Faq.astro';
import { faqJsonLd } from '../../../data/faq';
import { site } from '../../../data/site';

const fnIds = ['fachinfoWegovy', 'fachinfoOzempic', 'fachinfoRybelsus', 'fachinfoMounjaro', 'fachinfoSaxenda', 'wu2025', 'wilding2022ext', 'aronne2024', 'jensen2024'] as const;

const faq = [
  {
    q: 'Wie lange wirkt die Abnehmspritze nach der letzten Dosis nach?',
    a: '<p>Semaglutid (Wegovy, Ozempic, als Tablette Rybelsus und Wegovy-Tablette) hat eine Halbwertszeit von etwa einer Woche und ist nach etwa fünf Wochen weitgehend abgebaut, laut Fachinformation bis etwa sieben Wochen nachweisbar. Tirzepatid (Mounjaro) hat etwa fünf Tage Halbwertszeit und ist nach rund 25 Tagen weitgehend abgebaut, Liraglutid (Saxenda) nach etwa drei Tagen. Die Wirkung auf den Appetit lässt schon vorher nach.</p>',
  },
  {
    q: 'Ab wann nimmt man nach dem Absetzen wieder zu?',
    a: '<p>In einer Meta-Analyse randomisierter Studien war die Gewichtszunahme ab etwa Woche 8 nach dem Absetzen messbar und setzte sich bis etwa Woche 20 fort. Ein Jahr nach dem Absetzen von Semaglutid waren in der STEP-1-Verlängerung im Mittel zwei Drittel des verlorenen Gewichts zurück. Der Zeitplan zeigt diese Wochen als Kalenderdaten und markiert die Wiegetage; das ist allgemeine Orientierung aus Studien, keine Vorhersage für dich.</p>',
  },
  {
    q: 'Ist der Zeitplan ein Absetz-Plan oder ein Ausschleich-Schema?',
    a: '<p>Nein. Das Werkzeug beginnt nach der letzten Dosis und enthält keine Dosierungen, keine Schritte zum Reduzieren und keine Empfehlung, ob oder wann abgesetzt wird. Diese Entscheidung triffst du mit deiner Ärztin oder deinem Arzt.</p>',
  },
  {
    q: 'Was steht in der Kalenderdatei?',
    a: '<p>Die Orientierungspunkte als Termine: Wirkstoff weitgehend abgebaut, Appetit kommt zurück, Zunahme in Studien messbar, Wiegetage in Woche 1, 2, 4, 8 und 12 sowie der Ein-Jahres-Punkt. Die Datei entsteht im Browser und lässt sich in jeden Kalender importieren; nichts wird übertragen.</p>',
  },
];
const fn = (id: (typeof fnIds)[number]) => fnIds.indexOf(id) + 1;

const title = 'Zeitplan nach der letzten Dosis: Was wann passiert (Rechner)';
const description =
  'Letzte Dosis und Wirkstoff eingeben: wann der Wirkstoff abgebaut ist, wann der Appetit meist zurückkommt und ab welcher Woche Studien eine Zunahme messen.';
const path = '/werkzeuge/zeitplan-nach-letzter-dosis/';
const url = `${site.url}${path}`;

const jsonLd = [
  {
    '@type': 'WebApplication',
    '@id': `${url}#app`,
    name: 'Zeitplan nach der letzten Dosis',
    url,
    description,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Web',
    browserRequirements: 'JavaScript',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    inLanguage: 'de-DE',
    provider: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'WebPage',
    '@id': `${url}#page`,
    name: title,
    description,
    url,
    inLanguage: 'de-DE',
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: { '@id': `${url}#app` },
    about: { '@type': 'Thing', name: 'Zeitlicher Verlauf nach dem Absetzen von GLP-1-Rezeptoragonisten' },
  },
  faqJsonLd(faq),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Werkzeuge', item: `${site.url}/werkzeuge/` },
      { '@type': 'ListItem', position: 3, name: 'Zeitplan nach der letzten Dosis', item: url },
    ],
  },
];
---
<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <SeitenKopf crumbs={[{ href: '/', label: 'Start' }, { href: '/werkzeuge/', label: 'Werkzeuge' }, { label: 'Zeitplan' }]} meta="Werkzeug, rechnet nur in deinem Browser" title="Zeitplan nach der letzten Dosis" size="m" width="narrow" doc="Dieses Werkzeug ist kein Absetz-Plan und keine Dosierhilfe; es beginnt nach der letzten Dosis.">
    <p>Datum der letzten Dosis und Wirkstoff eingeben. Das Werkzeug rechnet die Orientierungspunkte aus Fachinformation und Studien in Kalenderdaten um: wann der Wirkstoff weitgehend abgebaut ist, wann der Appetit meist zurückkommt und ab wann die Zunahme in Studien messbar wird. Allgemeine Orientierung aus Studien, keine Vorhersage für dich.</p>
  </SeitenKopf>

  <article class="container-narrow k-end">
    <form id="zeitplan-form" class="k-panel zp-form" novalidate>
      <div class="k-field">
        <label for="datum" class="k-label">Datum der letzten Dosis</label>
        <input id="datum" name="datum" type="date" required class="k-input" />
      </div>
      <div class="k-field">
        <label for="wirkstoff" class="k-label">Wirkstoff</label>
        <select id="wirkstoff" name="wirkstoff" class="k-input">
          <option value="sema-spritze">Semaglutid, wöchentliche Spritze (Wegovy, Ozempic)</option>
          <option value="sema-tablette">Semaglutid, Tablette (Wegovy-Tablette, Rybelsus)</option>
          <option value="tirzepatid">Tirzepatid (Mounjaro)</option>
          <option value="liraglutid">Liraglutid (Saxenda)</option>
        </select>
      </div>
      <div class="zp-act">
        <button type="submit" class="btn-primary">Zeitplan berechnen</button>
        <span class="k-hint">Nichts wird gespeichert oder übertragen.</span>
      </div>
    </form>

    <section id="zeitplan-ergebnis" class="zp-res hidden" aria-live="polite">
      <h2 class="k-h2">Dein Zeitplan</h2>
      <p class="k-note" data-zeitplan-kopf></p>
      <p class="zp-orient">Allgemeine Orientierung aus Fachinformation und Studien, keine Vorhersage für dich.</p>
      <figure class="zp-vis" aria-hidden="true">
        <div class="zp-lanes" data-zeitplan-bild></div>
        <div class="zp-axis"><span style="left:0%">0</span><span style="left:20%">4</span><span style="left:40%">8</span><span style="left:60%">12</span><span style="left:80%">16</span><span style="left:100%">20 Wochen</span></div>
      </figure>
      <ol class="zp-list" data-zeitplan-liste></ol>
      <div class="zp-act zp-act2">
        <button type="button" class="btn-secondary" data-zeitplan-ics>In den Kalender (ICS-Datei)</button>
        <button type="button" class="btn-secondary" data-zeitplan-drucken>Drucken</button>
      </div>
      <p class="k-note">Alle Angaben sind Mittelwerte aus Fachinformation und Studien. Was in jeder Phase zu tun ist, steht unter <a href="/wissen/abnehmspritze-absetzen/">Abnehmspritze absetzen</a> und in der <a href="/checkliste/">Checkliste für die ersten 8 Wochen</a>.</p>
    </section>

    <div class="prose-site mt-12">
      <h2 id="so-gerechnet">So wird gerechnet</h2>
      <ul>
        <li><strong>Wirkstoff weitgehend abgebaut:</strong> nach etwa fünf Halbwertszeiten. Semaglutid hat laut Fachinformation eine Halbwertszeit von etwa einer Woche, als Spritze<Fn n={fn('fachinfoWegovy')} id="fachinfoWegovy" /><Fn n={fn('fachinfoOzempic')} id="fachinfoOzempic" /> wie als Tablette<Fn n={fn('fachinfoRybelsus')} id="fachinfoRybelsus" />, Tirzepatid etwa fünf Tage<Fn n={fn('fachinfoMounjaro')} id="fachinfoMounjaro" />, Liraglutid etwa 13 Stunden.<Fn n={fn('fachinfoSaxenda')} id="fachinfoSaxenda" /> Die Wirkung auf den Appetit lässt schon vorher spürbar nach.</li>
        <li><strong>Appetit kommt zurück:</strong> Orientierung aus dem Wirkstoffabbau, etwa zwischen der zweiten und der fünften Halbwertszeit. Bei Semaglutid sind das Woche 2 bis 5, bei Tirzepatid Tag 10 bis 25, bei Liraglutid die ersten Tage.</li>
        <li><strong>Zunahme messbar:</strong> In einer Meta-Analyse randomisierter Studien war der Gewichtsunterschied zur Kontrollgruppe ab etwa Woche 8 nach dem Absetzen signifikant und stieg bis etwa Woche 20.<Fn n={fn('wu2025')} id="wu2025" /></li>
        <li><strong>Ein Jahr danach:</strong> Nach Semaglutid waren in der STEP-1-Verlängerung im Mittel zwei Drittel des Verlusts zurück.<Fn n={fn('wilding2022ext')} id="wilding2022ext" /> Nach Tirzepatid lag die Zunahme in SURMOUNT-4 bei etwa 14 % in 52 Wochen.<Fn n={fn('aronne2024')} id="aronne2024" /> Nach Liraglutid allein lag die Zunahme in der S-LiTE-Nachbeobachtung 6 kg höher als nach Training.<Fn n={fn('jensen2024')} id="jensen2024" /></li>
      </ul>
      <p>Was das Werkzeug nicht tut: Es sagt nicht, ob oder wie du absetzen sollst, und es rechnet keine Dosen. Beides gehört in das Gespräch mit deiner Ärztin oder deinem Arzt.</p>
    </div>

    <div class="prose-site mt-10">
      <h2 id="warum">Warum ein Datum mehr hilft als eine Wochenzahl</h2>
      <p>„Nach fünf bis sieben Wochen ist Semaglutid weitgehend abgebaut“ bleibt abstrakt. Ein Datum im Kalender nicht: Es zeigt, in welche Wochen deines Kalenders die Zeitpunkte aus Fachinformation und Studien fallen, und legt die Wiegetage dorthin, wo die Zunahme in Studien beginnt.<Fn n={fn('wu2025')} id="wu2025" /> Wer die Haltephase mit festen Terminen beginnt, merkt die Drift früher; ab welcher Zahl du dann reagierst, legt der <a href="/werkzeuge/gewichtskorridor/">Gewichtskorridor</a> fest, und wie viel Protein in diese Wochen gehört, der <a href="/werkzeuge/proteinrechner/">Proteinrechner</a>.</p>
      <p>Die Mittelwerte sagen nichts über dich allein: In der STEP-1-Verlängerung waren ein Jahr nach dem Absetzen im Mittel zwei Drittel des Verlusts zurück,<Fn n={fn('wilding2022ext')} id="wilding2022ext" /> hinter dem Mittel stehen Menschen mit fast vollständiger Zunahme und Menschen, die fast nichts zugenommen haben. Was den Unterschied gemacht hat, zeigt die S-LiTE-Nachbeobachtung: Nach Liraglutid allein lag die Zunahme im Jahr nach Therapieende 6,0 kg höher als nach einem Trainingsprogramm.<Fn n={fn('jensen2024')} id="jensen2024" /></p>
    </div>

    <div class="mt-14"><Faq items={faq} id="zeitplan-faq" title="Häufige Fragen zum Zeitplan" /></div>

    <ProductTeaser position="werkzeug-zeitplan" />

    <Footnotes ids={fnIds} />
  </article>

  <script is:inline>
    const PROFILE = {
      'sema-spritze': { name: 'Semaglutid (Spritze)', hwzTage: 7, jahr: 'In der STEP-1-Verlängerung waren ein Jahr nach dem Absetzen von Semaglutid im Mittel zwei Drittel des Verlusts zurück.' },
      'sema-tablette': { name: 'Semaglutid (Tablette)', hwzTage: 7, jahr: 'Für die Tablette gibt es noch keine Absetz-Daten; nach der Spritze waren ein Jahr später im Mittel zwei Drittel des Verlusts zurück (Übertrag).' },
      tirzepatid: { name: 'Tirzepatid', hwzTage: 5, jahr: 'In SURMOUNT-4 lag die Zunahme nach dem Wechsel auf Placebo bei etwa 14 % in 52 Wochen.' },
      liraglutid: { name: 'Liraglutid', hwzTage: 13 / 24, jahr: 'In der S-LiTE-Nachbeobachtung lag die Zunahme nach Liraglutid allein ein Jahr später 6 kg höher als nach Training.' },
    };
    const form = document.getElementById('zeitplan-form');
    const ergebnis = document.getElementById('zeitplan-ergebnis');
    const liste = document.querySelector('[data-zeitplan-liste]');
    const kopf = document.querySelector('[data-zeitplan-kopf]');
    const bild = document.querySelector('[data-zeitplan-bild]');
    const RM = document.documentElement.classList.contains('rm');
    let aktuelleEvents = [];

    const addDays = (d, n) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };
    const fmt = (d) => d.toLocaleDateString('de-DE', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' });
    // Zeitpunkt als Tag (unter vier Wochen) oder Woche nach der letzten Dosis
    const wann = (tage) => (tage < 28 ? `Tag ${tage}` : `Woche ${Math.round(tage / 7)}`);
    const spanne = (von, bis) => (bis < 28 ? `Tag ${von} bis ${bis}` : `Woche ${Math.round(von / 7)} bis ${Math.round(bis / 7)}`);
    const ics = (d) => `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}`;

    const eintrag = (titel, zeit, text, art) => {
      const li = document.createElement('li');
      li.className = 'zp-e';
      if (art) li.dataset.art = art;
      const z = document.createElement('p'); z.className = 'zp-d'; z.textContent = zeit;
      const b = document.createElement('div');
      const h = document.createElement('p'); h.className = 'zp-t'; h.textContent = titel;
      const t = document.createElement('p'); t.className = 'zp-x'; t.textContent = text;
      b.append(h, t);
      li.append(z, b);
      return li;
    };

    // Bild: Wochen 0 bis 20 als Bahnen; Lage in Prozent aus Tagen
    const pct = (tage) => Math.max(0, Math.min(100, (tage / 140) * 100));
    const bahn = (label, teile, i) => {
      const row = document.createElement('div');
      row.className = 'zp-lane';
      row.style.setProperty('--i', String(i));
      const l = document.createElement('span'); l.className = 'zp-l'; l.textContent = label;
      const track = document.createElement('span'); track.className = 'zp-track';
      teile.forEach((t) => {
        const s = document.createElement('span');
        s.className = 'zp-b ' + (t.cls || '');
        s.style.left = `${pct(t.von)}%`;
        s.style.width = t.punkt ? '' : `max(3px, ${pct(t.bis) - pct(t.von)}%)`;
        track.append(s);
      });
      row.append(l, track);
      return row;
    };

    const rechne = (springen) => {
      const datumWert = form.datum.value;
      if (!datumWert) { if (springen) form.datum.focus(); return; }
      const start = new Date(datumWert + 'T12:00:00');
      if (Number.isNaN(start.getTime())) return;
      const p = PROFILE[form.wirkstoff.value] || PROFILE['sema-spritze'];
      const tAbgebaut = Math.max(1, Math.round(p.hwzTage * 5));
      const tAppetit = Math.max(1, Math.round(p.hwzTage * 2));
      const abgebaut = addDays(start, tAbgebaut);
      const appetitVon = addDays(start, tAppetit);
      const appetitBis = abgebaut;
      const zunahme = addDays(start, 56);
      const jahr = addDays(start, 365);
      const wochen = [1, 2, 4, 8, 12];
      const wiegetage = wochen.map((w) => addDays(start, w * 7));

      liste.replaceChildren(
        eintrag('Wirkstoff weitgehend abgebaut', `Laut Fachinformation: ${wann(tAbgebaut)} nach der letzten Dosis, im Kalender um den ${fmt(abgebaut)}`, `Etwa fünf Halbwertszeiten (${p.name}). Die Wirkung auf den Appetit lässt schon vorher nach.`, 'stoff'),
        eintrag('Appetit kommt meist zurück', `Aus der Halbwertszeit abgeleitet: ${spanne(tAppetit, tAbgebaut)} nach der letzten Dosis, im Kalender ${fmt(appetitVon)} bis ${fmt(appetitBis)}`, 'Mit sinkendem Wirkstoffspiegel arbeitet der Magen wieder schneller, das Sättigungssignal kommt später.', 'appetit'),
        eintrag('Zunahme in Studien messbar', `In Studien: ab Woche 8 nach der letzten Dosis, Anstieg bis etwa Woche 20; im Kalender ab ${fmt(zunahme)}`, 'Meta-Analyse randomisierter Studien: Der Unterschied zur Kontrollgruppe war ab etwa Woche 8 messbar und stieg bis etwa Woche 20. Mittelwerte, keine Vorhersage für dich.', 'zunahme'),
        eintrag('Wiegetage', `jede Woche am ${start.toLocaleDateString('de-DE', { weekday: 'long' })}, zum Beispiel ${wiegetage.map((d) => d.toLocaleDateString('de-DE', { day: 'numeric', month: 'numeric' })).join(', ')}`, 'Einmal pro Woche, morgens, unter gleichen Bedingungen.', 'wiegen'),
        eintrag('Ein Jahr danach', `In Studien: Woche 52 nach der letzten Dosis, im Kalender ${fmt(jahr)}`, p.jahr),
      );
      bild.replaceChildren(
        bahn('Wirkstoff', [{ von: 0, bis: tAbgebaut, cls: 'zp-stoff' }], 0),
        bahn('Appetit', [{ von: tAppetit, bis: tAbgebaut, cls: 'zp-appetit' }], 1),
        bahn('Zunahme', [{ von: 56, bis: 140, cls: 'zp-zunahme' }], 2),
        bahn('Wiegen', wochen.map((w) => ({ von: w * 7, punkt: true, cls: 'zp-punkt' })), 3),
      );
      kopf.textContent = `Letzte Dosis ${fmt(start)}, ${p.name}. Woche 0 beginnt am ${start.toLocaleDateString('de-DE', { day: 'numeric', month: 'long' })}.`;
      ergebnis.classList.remove('hidden');
      ergebnis.classList.remove('zp-in');
      if (RM) ergebnis.classList.add('zp-in');
      else requestAnimationFrame(() => requestAnimationFrame(() => ergebnis.classList.add('zp-in')));
      if (springen) ergebnis.scrollIntoView({ behavior: RM ? 'auto' : 'smooth', block: 'start' });

      aktuelleEvents = [];
      aktuelleEvents.push({ d: abgebaut, s: `Nach der Spritze: laut Fachinformation Wirkstoff weitgehend abgebaut (${wann(tAbgebaut)})` });
      aktuelleEvents.push({ d: appetitVon, s: 'Nach der Spritze: Appetit kommt meist zurück (bis ' + fmt(appetitBis) + ')' });
      aktuelleEvents.push({ d: zunahme, s: 'Nach der Spritze: in Studien ab Woche 8 Zunahme messbar' });
      wiegetage.forEach((d) => aktuelleEvents.push({ d, s: 'Nach der Spritze: Wiegetag' }));
      aktuelleEvents.push({ d: jahr, s: 'Nach der Spritze: Woche 52, ein Jahr nach der letzten Dosis' });
    };

    form.addEventListener('submit', (e) => { e.preventDefault(); rechne(true); });
    form.wirkstoff.addEventListener('change', () => { if (form.datum.value) rechne(false); });
    form.datum.addEventListener('change', () => { if (form.datum.value) rechne(false); });

    document.querySelector('[data-zeitplan-ics]').addEventListener('click', () => {
      if (!aktuelleEvents.length) return;
      const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d+Z$/, 'Z');
      const lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//nachderspritze.de//Zeitplan//DE', 'CALSCALE:GREGORIAN'];
      aktuelleEvents.forEach((ev, i) => {
        lines.push('BEGIN:VEVENT', `UID:zeitplan-${ics(ev.d)}-${i}@nachderspritze.de`, `DTSTAMP:${stamp}`, `DTSTART;VALUE=DATE:${ics(ev.d)}`, `DTEND;VALUE=DATE:${ics(addDays(ev.d, 1))}`, `SUMMARY:${ev.s}`, 'DESCRIPTION:Allgemeine Orientierung aus Fachinformation und Studien\\, keine Vorhersage für dich. nachderspritze.de/werkzeuge/zeitplan-nach-letzter-dosis/', 'END:VEVENT');
      });
      lines.push('END:VCALENDAR');
      const blob = new Blob([lines.join('\r\n')], { type: 'text/calendar;charset=utf-8' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'nach-der-spritze-zeitplan.ics';
      document.body.append(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(a.href);
    });
    document.querySelector('[data-zeitplan-drucken]').addEventListener('click', () => window.print());
  </script>
</Base>

<style>
  .zp-form {
    display: grid;
    gap: 1.5rem 2rem;
  }
  .zp-act {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  @media (min-width: 640px) {
    .zp-form {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
    .zp-act {
      grid-column: 1 / -1;
    }
  }
  .zp-res {
    margin-top: 3rem;
  }
  .zp-res .k-note a {
    color: var(--color-moss);
  }
  .zp-orient {
    margin-top: 0.5rem;
    font-size: 1rem;
    line-height: 1.55;
    font-weight: 500;
    color: var(--color-ink);
  }
  /* Bild: vier Bahnen über 20 Wochen */
  .zp-vis {
    margin-top: 2rem;
  }
  .zp-vis :global(.zp-lane) {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    height: 2rem;
  }
  .zp-vis :global(.zp-l) {
    font-size: 0.8125rem;
    color: var(--color-ink-3);
  }
  .zp-vis :global(.zp-track) {
    position: relative;
    height: 100%;
    border-left: 1px solid var(--color-line);
    background: repeating-linear-gradient(to right, transparent 0, transparent calc(20% - 1px), var(--color-line) calc(20% - 1px), var(--color-line) 20%);
  }
  .zp-vis :global(.zp-b) {
    position: absolute;
    top: 0.55rem;
    height: 0.9rem;
    border-radius: 3px;
    transform-origin: left center;
    transition: transform 0.9s var(--ease), opacity 0.6s var(--ease);
    transition-delay: calc(var(--i, 0) * 120ms);
  }
  .zp-vis :global(.zp-stoff) {
    background: var(--color-ink-3);
  }
  .zp-vis :global(.zp-appetit) {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--color-ink);
  }
  .zp-vis :global(.zp-zunahme) {
    background: var(--color-clay);
  }
  .zp-vis :global(.zp-punkt) {
    top: 0.65rem;
    width: 0.7rem;
    height: 0.7rem;

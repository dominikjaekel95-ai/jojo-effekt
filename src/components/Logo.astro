---
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2 ${cls}`}>
  <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" class="shrink-0">
    <circle cx="14" cy="14" r="13" fill="var(--color-moss)"/>
    <path d="M8 18c2.2-5 4.6-8 6-8s3.8 3 6 8" stroke="#fff" stroke-width="2.2" stroke-linecap="round" fill="none"/>
    <circle cx="14" cy="10" r="1.8" fill="var(--color-amber)"/>
  </svg>
  <span class="font-serif text-[1.15rem] font-semibold tracking-[-0.01em] text-ink">Nach der Spritze</span>
</span>

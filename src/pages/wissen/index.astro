---
/**
 * Wissens-Hub /wissen/: nach Themen gegliedert (src/data/themen.json), Anker #praeparate bleibt (die Startseite verlinkt
 * dorthin). Gestaltung „Kalk“ seit 06.10.2026: Themen und Artikel als ruhige Zeilen, Einblenden beim Scrollen.
 */
import Base from '../../layouts/Base.astro';
import SeitenKopf from '../../components/SeitenKopf.astro';
import Pfeil from '../../components/Pfeil.astro';
import GrafikDaten from '../../components/GrafikDaten.astro';
import GrafikEinbinden from '../../components/GrafikEinbinden.astro';
import Cta from '../../components/Cta.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
import { themen, gehoertZu } from '../../data/themen';

const artikel = (await getCollection('wissen', (a) => !a.data.draft)).sort((a, b) => a.data.order - b.data.order);
const glossarCount = (await getCollection('glossar', (g) => !g.data.draft)).length;
// Gliederung nach Themen (Hubs): jeder Artikel erscheint unter seiner Kategorie; die Themenseite listet zusätzlich `include`
const gruppen = themen.map((t) => ({ thema: t, artikel: artikel.filter((a) => a.data.category === t.category) }));
const ohneThema = artikel.filter((a) => !themen.some((t) => t.category === a.data.category));
if (ohneThema.length > 0) throw new Error(`Artikel ohne Thema in src/data/themen.json: ${ohneThema.map((a) => a.id).join(', ')}`);
// Präparate-Artikel als Linkzeile mit Anker; die Startseite verlinkt hierher, weil dort keine Markennamen stehen
const praeparateThema = themen.find((t) => t.slug === 'praeparate');
const praeparate = praeparateThema ? artikel.filter((a) => gehoertZu(praeparateThema, a.id, a.data.category)) : [];
const title = 'Wissen zur Abnehmspritze: Absetzen, Jojo-Effekt, Muskeln';
const description =
  'Was nach der Abnehmspritze passiert und was hilft: Absetzen, Jojo-Effekt, Muskelabbau, Protein, Kreatin, Gewicht halten. Jede Zahl mit Link zur Originalstudie.';
const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: title,
    description,
    url: `${site.url}/wissen/`,
    isPartOf: { '@id': `${site.url}/#website` },
    hasPart: [
      ...themen.map((t) => ({ '@type': 'CollectionPage', name: t.title, url: `${site.url}/wissen/${t.slug}/` })),
      ...artikel.map((a) => ({ '@type': 'Article', headline: a.data.title, url: `${site.url}/wissen/${a.id}/` })),
    ],
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Wissen', item: `${site.url}/wissen/` },
    ],
  },
];
---
<Base title={title} description={description} path="/wissen/" jsonLd={jsonLd}>
  <SeitenKopf crumbs={[{ href: '/', label: 'Start' }, { label: 'Wissen' }]} meta={`Wissen, ${artikel.length} Artikel in ${themen.length} Themen`} title="Nach der Abnehmspritze: die Fakten, mit Quellen" doc={false}>
    <p>Was in Studien passiert, wenn die Spritze wegfällt, und was nachweislich hilft. Jede Zahl mit Link zur Originalstudie, Quellen unter jedem Artikel, kein Verkaufston. Und immer: Ob und wie du dein Medikament absetzt, besprichst du mit deiner Ärztin oder deinem Arzt.</p>
  </SeitenKopf>

  <div class="container-wide k-end">
    <figure class="wi-fig" data-rv>
      <a href="/wissen/abnehmspritze-absetzen/" class="wi-img"><img src="/grafiken/zeitachse-nach-letzter-dosis.png" alt="Zeitachse über 20 Wochen nach der letzten Dosis einer Abnehmspritze: Semaglutid (Halbwertszeit etwa eine Woche) ist nach etwa fünf Wochen weitgehend abgebaut und laut Fachinformation Wegovy bis etwa sieben Wochen nachweisbar, Tirzepatid (Halbwertszeit etwa fünf Tage) nach etwa 25 Tagen. Der Appetit kehrt, abgeleitet aus dem sinkenden Wirkstoffspiegel, ab Woche 2 bis 5 zurück; die Gewichtszunahme ist ab etwa Woche 8 messbar und steigt bis etwa Woche 20." width="1200" height="675" loading="eager" /></a>
      <figcaption>
        <p>Die ersten 20 Wochen nach der letzten Dosis; Woche für Woche erklärt unter <a href="/wissen/abnehmspritze-absetzen/" class="k-a">Abnehmspritze absetzen</a>. Alle Grafiken mit Quellen und Download: <a href="/grafiken/" class="k-a">Grafiken</a>.</p>
        <GrafikDaten id="zeitachse-nach-letzter-dosis" class="mt-3" />
      </figcaption>
    </figure>

    <!-- Themen: ruhige Zeilen mit Artikelzahl -->
    <nav class="k-sec-s" aria-label="Themen">
      <h2 class="k-h3 wi-h3">Themen</h2>
      <ul class="k-rows k-cols-2 wi-themen">
        {gruppen.map(({ thema, artikel: liste }, i) => (
          <li data-rv style={`--i:${i % 2}`}><a href={`/wissen/${thema.slug}/`} class="k-row wi-thema"><span class="wi-anz" aria-hidden="true">{liste.length}</span><span class="k-row-t">{thema.name}</span><span class="k-row-d">{liste.length} Artikel · Themenseite mit Einordnung</span><Pfeil /></a></li>
        ))}
      </ul>
    </nav>

    <!-- Nachschlagen -->
    <section class="k-sec-s" aria-label="Nachschlagen">
      <ul class="k-rows wi-tools">
        <li data-rv><a href="/wissen/studien/" class="k-row"><span class="k-row-k">Studien-Tracker</span><span class="k-row-t">Alle Studien zum Absetzen der Abnehmspritze in einer Tabelle</span><span class="k-row-d">Zulassungsstudien, Absetz-Phasen, Meta-Analysen und Mechanismen mit je einer Kernzahl und Link zum Original. Monatlich aktualisiert.</span><Pfeil /></a></li>
        <li data-rv style="--i:1"><a href="/glossar/" class="k-row"><span class="k-row-k">Glossar</span><span class="k-row-t">Begriffe zur Zeit nach der Abnehmspritze</span><span class="k-row-d">Haltephase, Absetzkurve, fettfreie Masse, Halbwertszeit: {glossarCount} Definitionen in je einem Satz, mit Quelle und Link zum passenden Artikel.</span><Pfeil /></a></li>
        <li data-rv style="--i:2"><a href="/marktradar/" class="k-row"><span class="k-row-k">Marktradar</span><span class="k-row-t">Was sich bei Spritze und Tablette gerade ändert</span><span class="k-row-d">Zulassungen, Marktstarts, Preise als Größenordnung, Kassenregeln und Lieferbarkeit, mit Datum und Quelle. Lieferbarkeit wird automatisch abgerufen.</span><Pfeil /></a></li>
      </ul>
    </section>

    {gruppen.map(({ thema, artikel: liste }) => (
      <section id={thema.slug === 'praeparate' ? 'praeparate' : `thema-${thema.slug}`} class="k-sec wi-sec scroll-mt-24" aria-labelledby={`h-${thema.slug}`}>
        <div class="wi-head" data-rv>
          <div>
            <p class="wi-kicker">{thema.name}</p>
            <h2 id={`h-${thema.slug}`} class="wi-h"><a href={`/wissen/${thema.slug}/`}>{thema.title}</a></h2>
          </div>
          <a href={`/wissen/${thema.slug}/`} class="k-q wi-more">Themenseite mit Einordnung</a>
        </div>
        {thema.slug === 'praeparate' && praeparate.length > 0 && (
          <ul class="k-inline wi-praep" aria-label="Absetzen nach Präparat" data-rv>
            {praeparate.map((a) => (<li><a href={`/wissen/${a.id}/`} class="k-q">{a.data.title.split(':')[0]}</a></li>))}
          </ul>
        )}
        <ul class="k-rows wi-arts">
          {liste.map((a, i) => (
            <li data-rv style={`--i:${i % 4}`}><a href={`/wissen/${a.id}/`} class="k-row"><span class="k-row-t">{a.data.title}</span><span class="k-row-d">{a.data.description}</span><Pfeil /></a></li>
          ))}
        </ul>
      </section>
    ))}

    <section class="k-sec wi-why" aria-labelledby="warum-h" data-rv>
      <h2 id="warum-h" class="k-h3">Warum es diese Seite gibt</h2>
      <div>
        <p>
          Wir entwickeln ein 12-Wochen-Programm für die Zeit nach der Abnehmspritze. Beim Recherchieren haben wir gemerkt: Die
          wichtigsten Informationen zum Absetzen sind über Studien, Nachrichtenmeldungen und Anbieter-Blogs verstreut, und
          oft widersprechen sie sich. Dieser Bereich fasst zusammen, was belegt ist. Das Programm ist ein Trainings- und
          Ernährungsprogramm, kein Medikament, und es verhindert den Jojo-Effekt nicht.
        </p>
        <div class="wi-cta"><Cta position="wissen-hub" secondary /><a href="/#programm" class="k-q">So ist das Programm aufgebaut</a></div>
      </div>
    </section>
  </div>
  <GrafikEinbinden />
</Base>

<style>
  .wi-fig {
    display: grid;
    gap: 1.25rem 2.5rem;
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }
  .wi-img img {
    display: block;
    width: 100%;
    height: auto;
  }
  .wi-fig figcaption {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-ink-3);
  }
  @media (min-width: 1000px) {
    .wi-fig {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.5fr);
      align-items: end;
    }
  }
  .wi-h3 {
    color: var(--color-ink-3);
    font-size: 1rem;
    font-stretch: 100%;
    font-weight: 450;
    letter-spacing: 0;
  }
  .wi-themen {
    margin-top: 0.75rem;
  }
  .wi-thema {
    grid-template-columns: 3.25rem minmax(0, 1fr) auto;
  }
  .wi-thema .k-row-t, .wi-thema .k-row-d {
    grid-column: 2;
  }
  .wi-thema > :global(svg) {
    grid-column: 3;
  }
  .wi-anz {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: center;
    font-stretch: 125%;
    font-weight: 470;
    letter-spacing: -0.03em;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-ink);
  }
  @media (min-width: 760px) {
    .wi-themen {
      border-top: 0;
    }
    .wi-themen > li:nth-child(-n + 2) {
      border-top: 1px solid var(--color-line);
    }
  }
  .wi-tools .k-row-t {
    font-size: clamp(1.125rem, 1.5vw, 1.3rem);
  }
  .wi-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }
  .wi-kicker {
    font-size: 0.9375rem;
    color: var(--color-ink-3);
  }
  .wi-h {
    margin-top: 0.4rem;
    font-size: clamp(1.625rem, 3vw, 2.5rem);
    line-height: 1.08;
    max-width: 24em;
  }
  .wi-h a {
    color: var(--color-ink);
    text-decoration: none;
  }
  .wi-h a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }
  .wi-more {
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .wi-praep {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
  }
  .wi-arts {
    margin-top: 1.5rem;
  }
  .wi-why {
    display: grid;
    gap: 0.75rem 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-ink);
    color: var(--color-ink-2);
  }
  .wi-why > div {
    max-width: 44em;
  }
  .wi-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
  }
  @media (min-width: 900px) {
    .wi-why {
      grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    }
  }
</style>

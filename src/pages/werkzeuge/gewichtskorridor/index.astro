---
/**
 * Werkzeug: Gewichtskorridor für die Haltephase. Aus dem Startgewicht entstehen drei Zonen wie eine Ampel, nach dem
 * Selbstregulations-Programm von Wing et al. 2006 (grün bis +1,4 kg, gelb +1,4 bis +2,3 kg, rot ab +2,3 kg), jede mit
 * einer vorher festgelegten Reaktion: nichts tun, selbst gegensteuern, Ursachen klären (spätestens jetzt mit der Ärztin).
 * Keine Medikamentenempfehlung, kein Wiedereinstiegsschema. Rechnet nur im Browser, speichert nichts.
 */
import Base from '../../../layouts/Base.astro';
import Fn from '../../../components/Fn.astro';
import Footnotes from '../../../components/Footnotes.astro';
import Faq from '../../../components/Faq.astro';
import ProductTeaser from '../../../components/ProductTeaser.astro';
import { faqJsonLd } from '../../../data/faq';
import { site } from '../../../data/site';

const fnIds = ['wing2006', 'wu2025', 'wilding2022ext', 'jensen2024', 'leidy2015', 'who2020', 'kreider2017'] as const;
const fn = (id: (typeof fnIds)[number]) => fnIds.indexOf(id) + 1;

/* Ampelfarben für die Zonen, bewusst eindeutig statt Theme-Töne */
const AMPEL = { gruen: '#2f7a4d', gelb: '#c48a12', rot: '#b23a3a' };

const title = 'Gewichtskorridor nach der Abnehmspritze: Ampel fürs Gewicht halten';
const description =
  'Startgewicht der Haltephase eingeben und eine Ampel für die Waage erhalten: grün bis 1,4 kg darüber (nichts tun), gelb bis 2,3 kg (zwei Wochen gegensteuern), rot darüber (Ursachen klären). Aus einem erprobten Programm, mit Quellen.';
const path = '/werkzeuge/gewichtskorridor/';
const url = `${site.url}${path}`;

const faq = [
  {
    q: 'Warum liegen die Grenzen bei 1,4 und 2,3 kg?',
    a: '<p>Das sind die Zonen des Selbstregulations-Programms von Wing und Kollegen (2006): bis 3 Pfund (1,4 kg) über dem Startgewicht grün, 3 bis 5 Pfund gelb, ab 5 Pfund (2,3 kg) rot. In der Studie mit 314 Teilnehmenden, die zuvor mindestens 10 % abgenommen hatten, nahmen in 18 Monaten 45,7 % der Gruppe mit persönlicher Betreuung wieder 2,3 kg oder mehr zu, in der Kontrollgruppe 72,4 %. Unter 1,4 kg lassen sich Schwankungen durch Wasser, Salz, Darminhalt oder Zyklus nicht von echter Zunahme unterscheiden; ab 2,3 kg ist es keine Schwankung mehr.</p>',
  },
  {
    q: 'Warum erst in der roten Zone zur Ärztin, und nicht früher?',
    a: '<p>Weil die gelbe Zone deine Aufgabe ist, nicht die der Praxis: Bei 1,4 bis 2,3 kg über dem Start reicht in den meisten Fällen, zwei Wochen lang Protein, Training und Mahlzeitenstruktur wieder in Ordnung zu bringen. Erst wenn das nicht gewirkt hat oder das Gewicht trotzdem weiter steigt, lohnt sich der Blick auf Ursachen, die du selbst nicht prüfen kannst: Schilddrüse, Schlaf, andere Medikamente, Blutwerte. Dafür ist die Ärztin oder der Arzt da. Wer früher hingehen will, darf das selbstverständlich; der Korridor sagt, ab wann es sinnvoll wird, nicht, ab wann es erlaubt ist.</p>',
  },
  {
    q: 'Was mache ich in der roten Zone konkret?',
    a: '<p>Zuerst vier Dinge selbst prüfen: Habe ich an den meisten Tagen mein Proteinziel erreicht? Habe ich zwei Krafteinheiten pro Woche gemacht? Schlafe ich sechs Stunden oder weniger? Trinke ich Kalorien, etwa Alkohol, Säfte, Milchkaffee? Dann ein Termin bei der Ärztin oder dem Arzt, mit dem Wiegeprotokoll in der Hand. Dort werden Ursachen geprüft und Optionen besprochen; ob eine erneute Therapie dazugehört, ist eine medizinische Entscheidung, die dieses Werkzeug nicht vorwegnimmt. Die Maßnahmen aus Gelb laufen in der Zwischenzeit weiter.</p>',
  },
  {
    q: 'Täglich oder einmal pro Woche wiegen?',
    a: '<p>Im Programm von Wing wogen sich die Teilnehmenden täglich. Wir empfehlen einmal pro Woche unter gleichen Bedingungen, weil Tagesschwankungen verunsichern. Für die Zonen ist beides geeignet; entscheidend ist, dass du den Wert mit dem Korridor vergleichst und vorher weißt, was du in jeder Zone tust.</p>',
  },
  {
    q: 'Was, wenn ich gerade Kreatin angefangen habe?',
    a: '<p>Kreatin bindet in den ersten Wochen 0,5 bis 2 kg Wasser in der Muskulatur. Das ist kein Fett und zählt nicht als Zunahme. Setze das Startgewicht erst nach zwei bis drei Wochen Einnahme, oder rechne die Wassereinlagerung gedanklich heraus.</p>',
  },
  {
    q: 'Gilt der Korridor auch, wenn ich die Spritze noch nehme?',
    a: '<p>Ja, sobald das Gewicht stabil ist und du es halten willst, auch unter laufender Therapie. Der Korridor sagt nichts über das Medikament aus; er macht sichtbar, ob das Gewicht driftet, bevor es ein großer Unterschied wird.</p>',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    '@id': `${url}#app`,
    name: 'Gewichtskorridor nach der Abnehmspritze',
    url,
    description,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Web',
    browserRequirements: 'JavaScript',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    inLanguage: 'de-DE',
    provider: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'WebPage',
    '@id': `${url}#page`,
    name: title,
    description,
    url,
    inLanguage: 'de-DE',
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: { '@id': `${url}#app` },
    about: { '@type': 'Thing', name: 'Gewicht halten nach dem Absetzen von GLP-1-Rezeptoragonisten' },
  },
  faqJsonLd(faq),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Werkzeuge', item: `${site.url}/werkzeuge/` },
      { '@type': 'ListItem', position: 3, name: 'Gewichtskorridor', item: url },
    ],
  },
];
---
<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <article class="container-narrow py-12">
    <nav aria-label="Brotkrumen" class="text-sm text-ink-3"><a href="/" class="hover:text-moss">Start</a> › <a href="/werkzeuge/" class="hover:text-moss">Werkzeuge</a> › Gewichtskorridor</nav>
    <p class="eyebrow mt-6">Werkzeug · rechnet nur in deinem Browser</p>
    <h1 class="h1 mt-3 !text-[2.1rem] sm:!text-[2.8rem]">Gewichtskorridor: eine Ampel für die Waage nach der Abnehmspritze</h1>
    <p class="mt-4 text-lg text-ink-2">
      Nach dem Absetzen kommt das Gewicht nicht an einem Tag zurück, sondern in kleinen Schritten, jeder einzeln erklärbar. In Studien ist die Zunahme ab etwa Woche 8 messbar.<Fn n={fn('wu2025')} id="wu2025" /> Der Korridor nimmt dir die Entscheidung ab, ob eine Zahl auf der Waage „noch normal“ ist: Du legst einmal ein Startgewicht fest, und ab dann sagt die Ampel, ob du nichts tun, selbst gegensteuern oder Ursachen klären solltest.
    </p>
    <p class="mt-4 rounded-lg border border-line bg-white px-4 py-3 text-sm font-medium text-ink">{site.doctorSentence} Der Korridor ist keine Empfehlung für oder gegen ein Medikament.</p>

    <section class="mt-8 rounded-xl2 border border-line bg-white p-5" aria-labelledby="lesen-h">
      <h2 id="lesen-h" class="text-base font-semibold text-ink">So funktioniert die Ampel</h2>
      <ol class="mt-3 space-y-3 text-sm text-ink-2">
        <li class="flex gap-3"><span class="mt-1 h-3 w-3 shrink-0 rounded-full" style={`background:${AMPEL.gruen}`} aria-hidden="true"></span><span><strong class="text-ink">Grün, bis 1,4 kg über dem Start: nichts tun.</strong> So viel schwankt das Gewicht durch Wasser, Salz, Darminhalt oder Zyklus ohnehin. Routinen halten, nächste Woche wieder wiegen.</span></li>
        <li class="flex gap-3"><span class="mt-1 h-3 w-3 shrink-0 rounded-full" style={`background:${AMPEL.gelb}`} aria-hidden="true"></span><span><strong class="text-ink">Gelb, 1,4 bis 2,3 kg über dem Start: zwei Wochen gegensteuern.</strong> Das ist kein Zufall mehr, sondern ein Trend. Protein, Training und Mahlzeitenstruktur in Ordnung bringen, dann wieder wiegen. Keine Diät.</span></li>
        <li class="flex gap-3"><span class="mt-1 h-3 w-3 shrink-0 rounded-full" style={`background:${AMPEL.rot}`} aria-hidden="true"></span><span><strong class="text-ink">Rot, mehr als 2,3 kg über dem Start: Ursachen klären.</strong> Entweder hat das Gegensteuern nicht gereicht, oder etwas anderes spielt mit. Vier Punkte selbst prüfen (unten), und spätestens jetzt ein Termin bei der Ärztin oder dem Arzt.</span></li>
      </ol>
      <p class="mt-3 text-sm text-ink-3">Beispiel: Startgewicht 82,4 kg. Grün bis 83,8 kg, gelb bis 84,7 kg, rot ab 84,7 kg. Die Grenzen stammen aus einem Programm, das in einer randomisierten Studie die Wiederzunahme deutlich senkte.<Fn n={fn('wing2006')} id="wing2006" /></p>
    </section>

    <form id="korridor-form" class="mt-6 grid gap-4 rounded-xl2 border border-line bg-white p-5 sm:grid-cols-2" novalidate>
      <div>
        <label for="start" class="block text-sm font-semibold text-ink">Startgewicht in kg</label>
        <input id="start" name="start" type="number" inputmode="decimal" min="35" max="300" step="0.1" placeholder="z. B. 82,4" required class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2 text-ink" />
        <p class="mt-1 text-xs text-ink-3">Das Gewicht am ersten Wiegetag deiner Haltephase, morgens, nüchtern. Nicht der Tiefstwert eines guten Tages.</p>
      </div>
      <div>
        <label for="aktuell" class="block text-sm font-semibold text-ink">Heutiges Gewicht in kg (optional)</label>
        <input id="aktuell" name="aktuell" type="number" inputmode="decimal" min="35" max="300" step="0.1" placeholder="z. B. 83,9" class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2 text-ink" />
        <p class="mt-1 text-xs text-ink-3">Zeigt, in welcher Zone du heute stehst.</p>
      </div>
      <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
        <button type="submit" class="btn-primary">Ampel berechnen</button>
        <span class="text-xs text-ink-3">Nichts wird gespeichert oder übertragen.</span>
      </div>
    </form>

    <section id="korridor-ergebnis" class="mt-8 hidden" aria-live="polite">
      <h2 class="h2">Deine Ampel</h2>
      <p class="mt-2 hidden rounded-lg border border-line bg-white px-4 py-3 text-base font-semibold text-ink" data-zone-heute></p>

      <div class="relative mt-6 pt-7" aria-hidden="true">
        <div class="absolute top-0 hidden -translate-x-1/2 text-xs font-semibold text-ink" data-marker><span class="block whitespace-nowrap text-center" data-marker-text>heute</span><span class="mx-auto block h-0 w-0 border-x-[7px] border-t-[9px] border-x-transparent border-t-ink"></span></div>
        <div class="flex h-6 w-full overflow-hidden rounded-full">
          <div style={`width:40%;background:${AMPEL.gruen}`}></div>
          <div style={`width:25%;background:${AMPEL.gelb}`}></div>
          <div style={`width:35%;background:${AMPEL.rot}`}></div>
        </div>
        <div class="relative mt-1 h-5 text-xs text-ink-3">
          <span class="absolute left-0" data-skala-start></span>
          <span class="absolute -translate-x-1/2" style="left:40%" data-skala-gelb></span>
          <span class="absolute -translate-x-1/2" style="left:65%" data-skala-rot></span>
        </div>
      </div>

      <div class="mt-5 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl2 border border-line bg-white p-4" style={`border-top:5px solid ${AMPEL.gruen}`}><p class="text-sm font-semibold" style={`color:${AMPEL.gruen}`}>Grün: nichts tun</p><p class="mt-1 text-2xl font-bold text-ink" data-gruen></p><p class="mt-2 text-sm text-ink-2">Normale Schwankung. Routinen halten: Protein, zwei Krafteinheiten, fester Wiegetag.</p></div>
        <div class="rounded-xl2 border border-line bg-white p-4" style={`border-top:5px solid ${AMPEL.gelb}`}><p class="text-sm font-semibold" style={`color:${AMPEL.gelb}`}>Gelb: zwei Wochen gegensteuern</p><p class="mt-1 text-2xl font-bold text-ink" data-gelb></p><p class="mt-2 text-sm text-ink-2">Ein Trend, kein Zufall. Protein zuerst, Gemüse für Volumen, keine Flüssigkalorien, kein Training ausfallen lassen. Dann wieder wiegen.</p></div>
        <div class="rounded-xl2 border border-line bg-white p-4" style={`border-top:5px solid ${AMPEL.rot}`}><p class="text-sm font-semibold" style={`color:${AMPEL.rot}`}>Rot: Ursachen klären</p><p class="mt-1 text-2xl font-bold text-ink" data-rot></p><p class="mt-2 text-sm text-ink-2">Gegensteuern hat nicht gereicht. Vier Punkte selbst prüfen, spätestens jetzt ein Termin bei der Ärztin oder dem Arzt. Gelb läuft weiter.</p></div>
      </div>
      <p class="mt-4 text-sm text-ink-3">Nach unten gibt es keine Zone: Weiter sinkendes Gewicht ist kein Alarm, solange es gewollt ist und du dich gut fühlst. Ungewollter, schneller Verlust gehört ebenfalls in die Sprechstunde.</p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button type="button" class="btn-secondary" data-korridor-drucken>Drucken</button>
        <a href="/werkzeuge/zeitplan-nach-letzter-dosis/" class="text-sm font-semibold text-moss underline underline-offset-4">Wiegetage in den Kalender: Zeitplan nach der letzten Dosis</a>
      </div>
    </section>

    <div class="prose-site mt-10">
      <h2 id="warum">Warum eine Ampel und nicht einfach „aufpassen“</h2>
      <p>Wer nach der Abnehmspritze das Gewicht halten will, verliert den Überblick selten an einem Tag, sondern über Wochen: ein halbes Kilo hier, ein Kilo dort, jedes einzeln erklärbar. In der STEP-1-Verlängerung waren ein Jahr nach dem Absetzen im Mittel zwei Drittel des verlorenen Gewichts zurück.<Fn n={fn('wilding2022ext')} id="wilding2022ext" /> Die Ampel legt die Entscheidung in einen Moment, in dem sie leicht ist: bevor die Zahl auf der Waage steht.</p>
      <p>Die drei Zonen stammen aus dem Selbstregulations-Programm von Wing und Kollegen: 314 Erwachsene, die zuvor mindestens 10 % abgenommen hatten, wurden 18 Monate begleitet. Sie wogen sich täglich, verglichen den Wert mit ihrem Korridor und reagierten nach Zone. In der Gruppe mit persönlicher Betreuung nahmen 45,7 % wieder 2,3 kg oder mehr zu, in der Kontrollgruppe 72,4 %.<Fn n={fn('wing2006')} id="wing2006" /> Die Teilnehmenden hatten ohne Medikament abgenommen; die Zonen übertragen wir, die Mechanik aus Wiegen und festgelegter Reaktion ist dieselbe.</p>

      <h2 id="zonen">Was in jeder Zone zu tun ist</h2>
      <ul>
        <li><strong>Grün, bis +1,4 kg:</strong> nichts ändern, Routinen halten. Das heißt 1,2 bis 1,6 g Protein pro kg Körpergewicht am Tag,<Fn n={fn('leidy2015')} id="leidy2015" /> Krafttraining an mindestens zwei Tagen pro Woche<Fn n={fn('who2020')} id="who2020" /> und der feste Wiegetag.</li>
        <li><strong>Gelb, +1,4 bis +2,3 kg:</strong> zwei Wochen lang gegensteuern, ohne Diät. Protein bei jeder Mahlzeit zuerst, Gemüse und Ballaststoffe für Volumen, keine Flüssigkalorien, kein Training ausfallen lassen. Dann wieder wiegen. Eine Crash-Diät wäre der falsche Hebel: weniger Muskeln, mehr Hunger, und beim nächsten Mal geht es schneller zurück. Wer unsicher ist, darf auch jetzt schon in der Praxis fragen.</li>
        <li><strong>Rot, ab +2,3 kg:</strong> zuerst vier Punkte selbst prüfen: Proteinziel an den meisten Tagen erreicht? Zwei Krafteinheiten pro Woche gemacht? Sechs Stunden Schlaf oder weniger? Kalorien getrunken (Alkohol, Säfte, Milchkaffee)? Dann ein Termin bei der Ärztin oder dem Arzt, mit dem Wiegeprotokoll. Dort werden Ursachen geprüft, die du selbst nicht prüfen kannst, und Optionen besprochen; welche, entscheidet ihr gemeinsam. Die Maßnahmen aus Gelb laufen weiter.</li>
      </ul>
      <p>Warum Training in jeder Zone steht: In der dänischen S-LiTE-Studie nahmen Teilnehmende nach Liraglutid allein im Jahr nach Therapieende 6,0 kg mehr zu als nach einem betreuten Trainingsprogramm.<Fn n={fn('jensen2024')} id="jensen2024" /> Wie ein Einstieg aussieht, steht unter <a href="/wissen/krafttraining-nach-abnehmspritze/">Krafttraining nach der Abnehmspritze</a>.</p>

      <h2 id="wiegen">Die Wiegeregel</h2>
      <p>Einmal pro Woche, gleicher Wochentag, morgens nach der Toilette, vor dem Frühstück. Wer Kreatin nimmt, rechnet in den ersten Wochen mit 0,5 bis 2 kg Wasser in der Muskulatur<Fn n={fn('kreider2017')} id="kreider2017" /> und setzt den Startwert danach. Der Wochenwert zählt, nicht der Tageswert; was dahintersteht, erklärt der Artikel <a href="/wissen/gewicht-halten-nach-abnehmspritze/">Gewicht halten nach der Abnehmspritze</a>. Was in den ersten Wochen nach der letzten Dosis sonst passiert, Woche für Woche, steht unter <a href="/wissen/abnehmspritze-absetzen/">Abnehmspritze absetzen</a>.</p>
    </div>

    <Faq items={faq} id="korridor-faq" title="Häufige Fragen zum Gewichtskorridor" />

    <ProductTeaser position="werkzeug-korridor" />

    <Footnotes ids={fnIds} />
  </article>

  <script is:inline>
    const form = document.getElementById('korridor-form');
    const ergebnis = document.getElementById('korridor-ergebnis');
    const kg = (n) => `${n.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} kg`;
    const lesen = (feld) => parseFloat(String(feld.value).replace(',', '.'));
    const q = (sel) => document.querySelector(sel);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const start = lesen(form.start);
      if (!(start >= 35 && start <= 300)) { form.start.focus(); return; }
      const gelbAb = start + 1.4;
      const rotAb = start + 2.3;
      q('[data-gruen]').textContent = `bis ${kg(gelbAb)}`;
      q('[data-gelb]').textContent = `${kg(gelbAb)} bis ${kg(rotAb)}`;
      q('[data-rot]').textContent = `ab ${kg(rotAb)}`;
      q('[data-skala-start]').textContent = `Start ${kg(start)}`;
      q('[data-skala-gelb]').textContent = kg(gelbAb);
      q('[data-skala-rot]').textContent = kg(rotAb);
      const heute = q('[data-zone-heute]');
      const marker = q('[data-marker]');
      const aktuell = lesen(form.aktuell);
      if (aktuell >= 35 && aktuell <= 300) {
        const diff = aktuell - start;
        // Position auf der Leiste: Grün 0 bis 40 %, Gelb 40 bis 65 %, Rot 65 bis 100 % (bis +4,6 kg, darüber am Rand)
        let pos = 0;
        if (diff <= 0) pos = 0;
        else if (diff < 1.4) pos = (diff / 1.4) * 40;
        else if (diff < 2.3) pos = 40 + ((diff - 1.4) / 0.9) * 25;
        else pos = Math.min(100, 65 + ((diff - 2.3) / 2.3) * 35);
        marker.style.left = `${pos}%`;
        q('[data-marker-text]').textContent = `heute ${kg(aktuell)}`;
        marker.classList.remove('hidden');
        const zone = diff >= 2.3 ? 'Rot: vier Punkte prüfen, dann Termin bei der Ärztin oder dem Arzt; Gelb läuft weiter.' : diff >= 1.4 ? 'Gelb: zwei Wochen gegensteuern, dann wieder wiegen.' : diff < 0 ? 'Grün, unter dem Startgewicht: nichts tun.' : 'Grün: nichts tun, nächste Woche wieder wiegen.';
        const vorzeichen = diff > 0 ? '+' : '';
        heute.textContent = `Heute ${kg(aktuell)}, das sind ${vorzeichen}${kg(diff)} gegenüber dem Start. ${zone}`;
        heute.classList.remove('hidden');
      } else {
        heute.classList.add('hidden');
        marker.classList.add('hidden');
      }
      ergebnis.classList.remove('hidden');
      ergebnis.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    q('[data-korridor-drucken]').addEventListener('click', () => window.print());
  </script>
</Base>

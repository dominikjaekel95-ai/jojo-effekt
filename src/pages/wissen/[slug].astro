---
/**
 * /wissen/<slug>/: Artikel (src/content/wissen) und Themenseiten (src/data/themen.json) teilen sich diese Route.
 * Ein Themen-Slug darf nie mit einem Artikel-Slug übereinstimmen; der Build bricht sonst ab.
 */
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import ArticlePage from '../../components/ArticlePage.astro';
import HubPage from '../../components/HubPage.astro';
import { themen, type Thema } from '../../data/themen';

export const getStaticPaths = (async () => {
  const artikel = await getCollection('wissen', (a) => !a.data.draft);
  const ids = new Set(artikel.map((a) => a.id));
  for (const t of themen) {
    if (ids.has(t.slug)) throw new Error(`Themen-Slug "${t.slug}" kollidiert mit einem Artikel in src/content/wissen/`);
  }
  return [
    ...artikel.map((a) => ({ params: { slug: a.id }, props: { entry: a } })),
    ...themen.map((t) => ({ params: { slug: t.slug }, props: { thema: t } })),
  ];
}) satisfies GetStaticPaths;

interface Props { entry?: CollectionEntry<'wissen'>; thema?: Thema }
const { entry, thema } = Astro.props;
if (!entry && !thema) throw new Error('Weder Artikel noch Thema übergeben');
---
{thema ? <HubPage thema={thema} /> : <ArticlePage entry={entry!} />}

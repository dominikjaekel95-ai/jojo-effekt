---
/**
 * Werkzeug: Gewichtskorridor für die Haltephase. Aus dem Startgewicht entstehen drei Zonen nach dem Selbstregulations-
 * Programm von Wing et al. 2006 (grün bis +1,4 kg, gelb +1,4 bis +2,3 kg, rot ab +2,3 kg) mit der passenden Reaktion:
 * weitermachen, nachjustieren, ärztlich abklären. Keine Medikamentenempfehlung, kein Wiedereinstiegsschema.
 * Rechnet nur im Browser, speichert nichts.
 */
import Base from '../../../layouts/Base.astro';
import Fn from '../../../components/Fn.astro';
import Footnotes from '../../../components/Footnotes.astro';
import Faq from '../../../components/Faq.astro';
import ProductTeaser from '../../../components/ProductTeaser.astro';
import { faqJsonLd } from '../../../data/faq';
import { site } from '../../../data/site';

const fnIds = ['wing2006', 'wu2025', 'wilding2022ext', 'jensen2024', 'leidy2015', 'who2020', 'kreider2017'] as const;
const fn = (id: (typeof fnIds)[number]) => fnIds.indexOf(id) + 1;

const title = 'Gewichtskorridor nach der Abnehmspritze: drei Zonen, eine Schwelle';
const description =
  'Startgewicht der Haltephase eingeben und drei Zonen mit Reaktionsschwelle erhalten (grün, gelb, rot), nach einem erprobten Programm zum Halten des Gewichts. Mit Wiegeregel und dem, was in jeder Zone zu tun ist.';
const path = '/werkzeuge/gewichtskorridor/';
const url = `${site.url}${path}`;

const faq = [
  {
    q: 'Warum liegen die Grenzen bei 1,4 und 2,3 kg?',
    a: '<p>Das sind die Zonen des Selbstregulations-Programms von Wing und Kollegen (2006): Bis 3 Pfund, also 1,4 kg, über dem Startgewicht galt als grün, 3 bis 5 Pfund als gelb, ab 5 Pfund, also 2,3 kg, als rot. In der Studie mit 314 Teilnehmenden, die zuvor mindestens 10 % abgenommen hatten, nahmen in 18 Monaten 45,7 % der Gruppe mit persönlicher Betreuung wieder 2,3 kg oder mehr zu, in der Kontrollgruppe 72,4 %.</p>',
  },
  {
    q: 'Täglich oder einmal pro Woche wiegen?',
    a: '<p>Im Programm von Wing wogen sich die Teilnehmenden täglich. Wir empfehlen im Artikel zum Gewicht halten einmal pro Woche, immer unter gleichen Bedingungen, weil Tagesschwankungen durch Wasser und Mahlzeiten verunsichern. Für die Zonen ist beides geeignet; entscheidend ist, dass du den Wert mit dem Korridor vergleichst und vorher weißt, was du in jeder Zone tust.</p>',
  },
  {
    q: 'Was, wenn ich gerade Kreatin angefangen habe?',
    a: '<p>Kreatin bindet in den ersten Wochen 0,5 bis 2 kg Wasser in der Muskulatur. Das ist kein Fett. Setze das Startgewicht erst nach zwei bis drei Wochen Einnahme, oder rechne die Wassereinlagerung gedanklich heraus.</p>',
  },
  {
    q: 'Was passiert in der roten Zone?',
    a: '<p>Ein Termin bei deiner Ärztin oder deinem Arzt. Dort wird geklärt, was dahintersteckt: Appetit, Schlaf, Stress, andere Medikamente, Schilddrüse. Ob eine erneute Therapie in Frage kommt, ist eine medizinische Entscheidung, die dieses Werkzeug nicht vorwegnimmt. Was du selbst tun kannst, steht in der gelben Zone; es gilt in der roten weiter.</p>',
  },
  {
    q: 'Gilt der Korridor auch, wenn ich die Spritze noch nehme?',
    a: '<p>Ja, sobald das Gewicht stabil ist und du es halten willst, auch unter laufender Therapie. Der Korridor sagt nichts über das Medikament aus; er macht sichtbar, ob das Gewicht driftet, bevor es ein großer Unterschied wird.</p>',
  },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    '@id': `${url}#app`,
    name: 'Gewichtskorridor nach der Abnehmspritze',
    url,
    description,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Web',
    browserRequirements: 'JavaScript',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    inLanguage: 'de-DE',
    provider: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'WebPage',
    '@id': `${url}#page`,
    name: title,
    description,
    url,
    inLanguage: 'de-DE',
    isPartOf: { '@id': `${site.url}/#website` },
    mainEntity: { '@id': `${url}#app` },
    about: { '@type': 'Thing', name: 'Gewicht halten nach dem Absetzen von GLP-1-Rezeptoragonisten' },
  },
  faqJsonLd(faq),
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Werkzeuge', item: `${site.url}/werkzeuge/` },
      { '@type': 'ListItem', position: 3, name: 'Gewichtskorridor', item: url },
    ],
  },
];
---
<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <article class="container-narrow py-12">
    <nav aria-label="Brotkrumen" class="text-sm text-ink-3"><a href="/" class="hover:text-moss">Start</a> › <a href="/werkzeuge/" class="hover:text-moss">Werkzeuge</a> › Gewichtskorridor</nav>
    <p class="eyebrow mt-6">Werkzeug · rechnet nur in deinem Browser</p>
    <h1 class="h1 mt-3 !text-[2.1rem] sm:!text-[2.8rem]">Gewichtskorridor: drei Zonen für die Zeit nach der Abnehmspritze</h1>
    <p class="mt-4 text-lg text-ink-2">
      Nach dem Absetzen kommt das Gewicht in Studien ab etwa Woche 8 zurück,<Fn n={fn('wu2025')} id="wu2025" /> langsam und erst spät sichtbar. Der Korridor legt vorher fest, ab welcher Zahl du was tust: weitermachen, nachjustieren oder ärztlich abklären. Die Zonen stammen aus einem Programm, das in einer randomisierten Studie die Wiederzunahme deutlich senkte.<Fn n={fn('wing2006')} id="wing2006" />
    </p>
    <p class="mt-4 rounded-lg border border-line bg-white px-4 py-3 text-sm font-medium text-ink">{site.doctorSentence} Der Korridor ist keine Empfehlung für oder gegen ein Medikament; in der roten Zone ist die Ärztin oder der Arzt die nächste Station.</p>

    <form id="korridor-form" class="mt-8 grid gap-4 rounded-xl2 border border-line bg-white p-5 sm:grid-cols-2" novalidate>
      <div>
        <label for="start" class="block text-sm font-semibold text-ink">Startgewicht der Haltephase in kg</label>
        <input id="start" name="start" type="number" inputmode="decimal" min="35" max="300" step="0.1" placeholder="z. B. 82,4" required class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2 text-ink" />
        <p class="mt-1 text-xs text-ink-3">Das Gewicht am ersten Wiegetag nach der letzten Dosis, oder das Gewicht, das du halten willst.</p>
      </div>
      <div>
        <label for="aktuell" class="block text-sm font-semibold text-ink">Heutiges Gewicht in kg (optional)</label>
        <input id="aktuell" name="aktuell" type="number" inputmode="decimal" min="35" max="300" step="0.1" placeholder="z. B. 83,9" class="mt-1 w-full rounded-lg border border-line bg-paper px-3 py-2 text-ink" />
        <p class="mt-1 text-xs text-ink-3">Zeigt, in welcher Zone du heute stehst.</p>
      </div>
      <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
        <button type="submit" class="btn-primary">Korridor berechnen</button>
        <span class="text-xs text-ink-3">Nichts wird gespeichert oder übertragen.</span>
      </div>
    </form>

    <section id="korridor-ergebnis" class="mt-8 hidden" aria-live="polite">
      <h2 class="h2">Dein Korridor</h2>
      <p class="mt-2 rounded-lg border border-line bg-white px-4 py-3 text-base font-semibold text-ink hidden" data-zone-heute></p>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl2 border border-line bg-white p-4 border-t-4 border-t-moss"><p class="text-sm font-semibold text-moss">Grün: weitermachen</p><p class="mt-1 text-2xl font-bold text-ink" data-gruen></p><p class="mt-2 text-sm text-ink-2">Bis 1,4 kg über dem Start. Routinen halten: Protein, Krafttraining, Wiegetag.</p></div>
        <div class="rounded-xl2 border border-line bg-white p-4 border-t-4 border-t-amber"><p class="text-sm font-semibold text-amber-dark">Gelb: nachjustieren</p><p class="mt-1 text-2xl font-bold text-ink" data-gelb></p><p class="mt-2 text-sm text-ink-2">1,4 bis 2,3 kg über dem Start. Zwei Wochen lang Protein zuerst, Volumen, kein Training ausfallen lassen, keine Crash-Diät.</p></div>
        <div class="rounded-xl2 border border-line bg-white p-4 border-t-4 border-t-clay"><p class="text-sm font-semibold text-clay">Rot: abklären</p><p class="mt-1 text-2xl font-bold text-ink" data-rot></p><p class="mt-2 text-sm text-ink-2">Ab 2,3 kg über dem Start. Termin bei der Ärztin oder dem Arzt; die Punkte aus Gelb laufen weiter.</p></div>
      </div>
      <p class="mt-4 text-sm text-ink-3">Nach unten gibt es keine Zone: Weiter sinkendes Gewicht ist kein Alarm, solange es gewollt ist und du dich gut fühlst. Ungewollter, schneller Verlust gehört ebenfalls in die Sprechstunde.</p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <button type="button" class="btn-secondary" data-korridor-drucken>Drucken</button>
        <a href="/werkzeuge/zeitplan-nach-letzter-dosis/" class="text-sm font-semibold text-moss underline underline-offset-4">Wiegetage in den Kalender: Zeitplan nach der letzten Dosis</a>
      </div>
    </section>

    <div class="prose-site mt-10">
      <h2 id="so-funktioniert">So funktioniert der Gewichtskorridor</h2>
      <p>Wer nach der Abnehmspritze das Gewicht halten will, verliert den Überblick selten an einem Tag, sondern über Wochen: ein halbes Kilo hier, ein Kilo dort, jedes einzeln erklärbar. In der STEP-1-Verlängerung waren ein Jahr nach dem Absetzen im Mittel zwei Drittel des verlorenen Gewichts zurück.<Fn n={fn('wilding2022ext')} id="wilding2022ext" /> Der Korridor macht die Drift früh sichtbar und nimmt die Entscheidung vorweg, die im Moment selbst schwerfällt.</p>
      <p>Die drei Zonen stammen aus dem Selbstregulations-Programm von Wing und Kollegen: 314 Erwachsene, die zuvor mindestens 10 % abgenommen hatten, wurden 18 Monate begleitet. Sie wogen sich täglich, verglichen den Wert mit ihrem Korridor und reagierten nach Zone. In der Gruppe mit persönlicher Betreuung nahmen 45,7 % wieder 2,3 kg oder mehr zu, in der Kontrollgruppe 72,4 %.<Fn n={fn('wing2006')} id="wing2006" /> Die Teilnehmenden hatten ohne Medikament abgenommen; die Zonen übertragen wir, die Mechanik des Wiegens und Reagierens ist dieselbe.</p>

      <h2 id="zonen">Was in jeder Zone zu tun ist</h2>
      <ul>
        <li><strong>Grün, bis +1,4 kg:</strong> nichts ändern, Routinen halten. Das heißt 1,2 bis 1,6 g Protein pro kg Körpergewicht am Tag,<Fn n={fn('leidy2015')} id="leidy2015" /> Krafttraining an mindestens zwei Tagen pro Woche<Fn n={fn('who2020')} id="who2020" /> und der feste Wiegetag.</li>
        <li><strong>Gelb, +1,4 bis +2,3 kg:</strong> zwei Wochen lang nachjustieren, ohne Diät. Protein bei jeder Mahlzeit zuerst, Gemüse und Ballaststoffe für Volumen, keine Flüssigkalorien, kein Training ausfallen lassen. Dann wieder wiegen. Eine Crash-Diät wäre der falsche Hebel: weniger Muskeln, mehr Hunger, und beim nächsten Mal geht es schneller zurück.</li>
        <li><strong>Rot, ab +2,3 kg:</strong> Termin bei der Ärztin oder dem Arzt. Dort werden Ursachen geprüft und Optionen besprochen; welche, entscheidet ihr gemeinsam. Die Maßnahmen aus Gelb laufen in der Zwischenzeit weiter.</li>
      </ul>
      <p>Warum Training in jeder Zone steht: In der dänischen S-LiTE-Studie nahmen Teilnehmende nach Liraglutid allein im Jahr nach Therapieende 6,0 kg mehr zu als nach einem betreuten Trainingsprogramm.<Fn n={fn('jensen2024')} id="jensen2024" /> Wie ein Einstieg aussieht, steht unter <a href="/wissen/krafttraining-nach-abnehmspritze/">Krafttraining nach der Abnehmspritze</a>.</p>

      <h2 id="wiegen">Die Wiegeregel</h2>
      <p>Einmal pro Woche, gleicher Wochentag, morgens nach der Toilette, vor dem Frühstück. Wer Kreatin nimmt, rechnet in den ersten Wochen mit 0,5 bis 2 kg Wasser in der Muskulatur<Fn n={fn('kreider2017')} id="kreider2017" /> und setzt den Startwert danach. Der Wochenwert zählt, nicht der Tageswert; was dahintersteht, erklärt der Artikel <a href="/wissen/gewicht-halten-nach-abnehmspritze/">Gewicht halten nach der Abnehmspritze</a>. Was in den ersten Wochen nach der letzten Dosis sonst passiert, Woche für Woche, steht unter <a href="/wissen/abnehmspritze-absetzen/">Abnehmspritze absetzen</a>.</p>
    </div>

    <Faq items={faq} id="korridor-faq" title="Häufige Fragen zum Gewichtskorridor" />

    <ProductTeaser position="werkzeug-korridor" />

    <Footnotes ids={fnIds} />
  </article>

  <script is:inline>
    const form = document.getElementById('korridor-form');
    const ergebnis = document.getElementById('korridor-ergebnis');
    const kg = (n) => `${n.toLocaleString('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} kg`;
    const lesen = (feld) => parseFloat(String(feld.value).replace(',', '.'));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const start = lesen(form.start);
      if (!(start >= 35 && start <= 300)) { form.start.focus(); return; }
      const gelbAb = start + 1.4;
      const rotAb = start + 2.3;
      document.querySelector('[data-gruen]').textContent = `bis ${kg(gelbAb)}`;
      document.querySelector('[data-gelb]').textContent = `${kg(gelbAb)} bis ${kg(rotAb)}`;
      document.querySelector('[data-rot]').textContent = `ab ${kg(rotAb)}`;
      const heute = document.querySelector('[data-zone-heute]');
      const aktuell = lesen(form.aktuell);
      if (aktuell >= 35 && aktuell <= 300) {
        const diff = aktuell - start;
        const zone = diff >= 2.3 ? 'Rot: Termin bei der Ärztin oder dem Arzt, die Punkte aus Gelb laufen weiter.' : diff >= 1.4 ? 'Gelb: zwei Wochen nachjustieren, dann wieder wiegen.' : diff < 0 ? 'Grün, unter dem Startgewicht: weitermachen.' : 'Grün: weitermachen.';
        const vorzeichen = diff > 0 ? '+' : '';
        heute.textContent = `Heute ${kg(aktuell)}, das sind ${vorzeichen}${kg(diff)} gegenüber dem Start. ${zone}`;
        heute.classList.remove('hidden');
      } else {
        heute.classList.add('hidden');
      }
      ergebnis.classList.remove('hidden');
      ergebnis.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    document.querySelector('[data-korridor-drucken]').addEventListener('click', () => window.print());
  </script>
</Base>

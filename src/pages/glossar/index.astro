---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
import { byTerm } from '../../lib/glossar';

const entries = (await getCollection('glossar', (g) => !g.data.draft)).sort(byTerm);
const letters = [...new Set(entries.map((e) => e.data.term[0].toUpperCase()))];
const own = entries.filter((e) => e.data.own);
const latest = entries.map((e) => (e.data.updatedDate ?? e.data.pubDate)).sort((a, b) => b.getTime() - a.getTime())[0];

const title = 'Glossar: Begriffe zur Zeit nach der Abnehmspritze';
const description =
  'Kurze, belegte Definitionen zu Körperzusammensetzung, Gewichtsregulation und Messung nach dem Absetzen: Haltephase, Absetzkurve, Set-Point, fettfreie Masse, Halbwertszeit.';
const jsonLd = [
  {
    '@type': 'DefinedTermSet',
    '@id': `${site.url}/glossar/#set`,
    name: title,
    description,
    url: `${site.url}/glossar/`,
    inLanguage: 'de-DE',
    dateModified: latest?.toISOString(),
    hasDefinedTerm: entries.map((e) => ({
      '@type': 'DefinedTerm',
      '@id': `${site.url}/glossar/${e.id}/#term`,
      name: e.data.term,
      description: e.data.short,
      url: `${site.url}/glossar/${e.id}/`,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Glossar', item: `${site.url}/glossar/` },
    ],
  },
];
---
<Base title={title} description={description} path="/glossar/" jsonLd={jsonLd}>
  <section class="container-wide py-14">
    <nav aria-label="Brotkrumen" class="text-sm text-ink-3"><a href="/" class="hover:text-moss">Start</a> › Glossar</nav>
    <p class="eyebrow mt-6">Glossar</p>
    <h1 class="h1 mt-3">Begriffe zur Zeit nach der Abnehmspritze</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-2">
      Was Studien und Fachinformationen meinen, wenn sie von fettfreier Masse, Halbwertszeit oder adaptiver Thermogenese
      sprechen. Jeder Eintrag: eine Definition in einem Satz, die wichtigste Zahl mit Quelle, und der Artikel, der das
      Thema vertieft. Zwei Begriffe haben wir selbst geprägt, weil es dafür kein Wort gab; sie sind gekennzeichnet.
    </p>
    <p class="mt-3 max-w-2xl text-sm text-ink-3">
      {entries.length} Begriffe · Stand {latest?.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })} · Fehlt ein Begriff? Schreib an <a href={`mailto:${site.owner.email}`} class="underline">{site.owner.email}</a>.
    </p>

    <nav aria-label="Buchstaben" class="mt-8 flex flex-wrap gap-2 text-sm font-semibold">
      {letters.map((l) => (<a href={`#buchstabe-${l}`} class="rounded-lg border border-line bg-white px-3 py-1 text-ink hover:border-moss hover:text-moss">{l}</a>))}
    </nav>

    {letters.map((l) => (
      <section id={`buchstabe-${l}`} class="mt-10 scroll-mt-24" aria-labelledby={`buchstabe-${l}-h`}>
        <h2 id={`buchstabe-${l}-h`} class="text-2xl font-bold text-moss">{l}</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          {entries.filter((e) => e.data.term[0].toUpperCase() === l).map((e) => (
            <a href={`/glossar/${e.id}/`} class="card group block no-underline hover:border-moss">
              <p class="text-xl font-bold leading-snug text-ink group-hover:text-moss">{e.data.term}{e.data.own && (<> <span class="ml-2 align-middle rounded-md bg-amber-light px-2 py-0.5 text-xs font-semibold text-amber-dark">Begriff von Nach der Spritze</span></>)}</p>
              <p class="mt-2 text-sm text-ink-2">{e.data.short}</p>
            </a>
          ))}
        </div>
      </section>
    ))}

    <div class="mt-14 rounded-xl2 border border-line bg-white p-6">
      <p class="eyebrow">Wie das Glossar entsteht</p>
      <p class="mt-2 max-w-2xl text-ink-2">
        Aufgenommen werden Begriffe, die in den Studien zur Zeit nach GLP-1-Medikamenten vorkommen und die sonst nirgends
        verständlich erklärt sind. Jede Zahl verweist auf die Originalarbeit. Eigene Begriffe ({own.map((e) => e.data.term).join(', ')}) sind als solche
        markiert. Vertiefungen stehen im <a href="/wissen/" class="font-semibold text-moss underline underline-offset-4">Wissensbereich</a>, die Studien im <a href="/wissen/studien/" class="font-semibold text-moss underline underline-offset-4">Studien-Tracker</a>, aktuelle Entwicklungen im <a href="/marktradar/" class="font-semibold text-moss underline underline-offset-4">Marktradar</a>.
      </p>
      <p class="mt-3 text-sm font-medium text-ink">{site.doctorSentence}</p>
    </div>
  </section>
</Base>

---
/**
 * Persönliche Planseite und Druckvorlage: /ernaehrungsplan/plan/<id>/ für die 56 Grundpläne (ek01 bis ek56).
 * MailerLite verlinkt hierher (Feld `plan`, Vorlieben als ?v=lachs,quark aus dem Feld `vorlieben`).
 * Ohne ?v= zeigt die Seite den Grundplan; mit ?v= rechnet das Skript den Plan mit Vorlieben im Browser neu
 * (gleicher Generator wie im Build). Mit JavaScript wird der Wochenteil interaktiv (src/lib/plan-interaktiv/: Tage
 * tauschen und verschieben, Appetit-Regler, Einkaufsliste mit Häkchen, Rezepte am Gericht); Änderungen stehen im
 * Parameter ?s= und nur im Browser. Ganz oben (Leiste, bleibt beim Scrollen stehen): „Als PDF senden“ (Blatt mit
 * Formular an api/ernaehrungsplan.js, schickt Plan, Vorlieben und Zustand mit) und „PDF herunterladen“ (echtes PDF aus
 * dem aktuellen Zustand, im Browser erzeugt, src/lib/plan-pdf/; A4 oder Handy). ?pdf=1 (Link aus der Mail) zeigt oben
 * „Dein PDF“. Ohne JavaScript bleibt der statische Plan aus dem Build mit Links auf die fertigen PDFs.
 * Aus den Seiten ohne ?v= erzeugt `npm run pdf:ernaehrungsplan` die PDFs unter public/downloads/ernaehrungsplan/:
 * <id>.pdf (A4) und <id>-handy.pdf (?druck=handy setzt die Klasse ed-handy). Die Druckfassung ist eigenes Markup
 * (src/lib/ernaehrungsplan-druck.ts, Stile src/styles/ernaehrungsplan-druck.css), auf dem Bildschirm unsichtbar; im Druck
 * ersetzt sie die Webansicht (Strg+P druckt den aktuellen Plan). Ohne JavaScript (und als Rückfall-Links) führen die
 * PDF-Links zu den fertigen PDFs des Grundplans. Die letzte Seite der Druckfassung (.ed-schluss) ist auch die Quelle für
 * Hinweise, Ausschlusskriterien, Pflichtsatz und Quellen im Browser-PDF.
 * Alte IDs ep01 bis ep18 (sieben Tage, bis 05.10.2026) leiten auf den passenden neuen Plan weiter.
 * noindex und nicht in der Sitemap. Keine Affiliate-Links, kein Produkt-Teaser, keine Präparatenamen.
 */
import Base from '../../../layouts/Base.astro';
import Fn from '../../../components/Fn.astro';
import Footnotes from '../../../components/Footnotes.astro';
import { site } from '../../../data/site';
import { ALTE_PLAENE, VORLIEBEN } from '../../../data/ernaehrungsplan-id.mjs';
import {
  allePlaene,
  pruefePlaene,
  ernaehrungOptionen,
  appetitOptionen,
  gewichtLabel,
  vorliebeLabel,
  erlaubteVorlieben,
  G_PRO_KG,
  type Plan,
  type Gewicht,
} from '../../../data/ernaehrungsplan';
import { wochenHtml, rezepteHtml, grundlageHtml, blickHtml } from '../../../lib/ernaehrungsplan-ansicht';
import { druckHtml } from '../../../lib/ernaehrungsplan-druck';
import { getSources } from '../../../data/sources';
import '../../../styles/ernaehrungsplan-druck.css';
import '../../../styles/plan-interaktiv.css';

export function getStaticPaths() {
  const fehler = pruefePlaene();
  if (fehler.length) throw new Error(`Ernährungsplan: ${fehler.length} Fehler\n${fehler.slice(0, 30).join('\n')}`);
  const plaene = allePlaene();
  return [
    ...plaene.map((plan) => ({ params: { id: plan.id }, props: { plan, weiter: null } })),
    ...Object.entries(ALTE_PLAENE).map(([alt, neu]) => ({ params: { id: alt }, props: { plan: plaene.find((p) => p.id === neu)!, weiter: neu } })),
  ];
}

interface Props { plan: Plan; weiter: string | null }
const { plan, weiter } = Astro.props;

const fnIds = ['leidy2015', 'almandoz2024', 'dgeBallaststoffe', 'dgeEmpfehlungen', 'euClaims', 'bls'] as const;
const fn = (id: (typeof fnIds)[number]) => fnIds.indexOf(id) + 1;

const ernaehrung = ernaehrungOptionen.find((o) => o.value === plan.ernaehrung)!;
const appetit = appetitOptionen.find((o) => o.value === plan.appetit)!;
const klein = plan.appetit === 'klein';
const stand = new Date().toLocaleDateString('de-DE', { month: 'long', year: 'numeric' });
const path = `/ernaehrungsplan/plan/${weiter ?? plan.id}/`;
const pdf = `/downloads/ernaehrungsplan/${plan.id}.pdf`;
const pdfHandy = `/downloads/ernaehrungsplan/${plan.id}-handy.pdf`;
const quellen = getSources(fnIds);
const lf = plan.laktosefrei && plan.ernaehrung !== 'vegan';
const erlaubt = new Set(erlaubteVorlieben(plan.ernaehrung, plan.laktosefrei));
/** Vorlieben des Plans in fester Reihenfolge mit Anzeige-Text (für das Profil vor dem ersten Zeichnen, ohne Verschiebung) */
const vLabels = VORLIEBEN.filter((v) => erlaubt.has(v.key)).map((v) => [v.key, vorliebeLabel(v.key, plan.laktosefrei)]);
const gewichte = Object.keys(gewichtLabel) as Gewicht[];
const muster =
  plan.ernaehrung === 'mischkost'
    ? 'Fleisch gibt es an drei, Fisch an zwei Tagen pro Woche (mit passender Vorliebe an je einem Tag mehr), die übrigen Hauptmahlzeiten kommen ohne aus.'
    : plan.ernaehrung === 'pescetarisch'
      ? 'Fisch gibt es an vier Tagen pro Woche (mit passender Vorliebe an einem mehr), die übrigen Hauptmahlzeiten sind vegetarisch.'
      : '';
---
{weiter ? (
  <Base title="Dein Ernährungsplan hat eine neue Fassung" description="Der Ernährungsplan hat jetzt 14 Tage. Hier geht es zu deinem Plan." path={path} noindex>
    <div class="container-narrow py-20">
      <p class="eyebrow">Nach der Spritze · Ernährungsplan</p>
      <h1 class="h1 mt-3 !text-[2.2rem] sm:!text-[3rem]">Dein Plan hat eine neue Fassung.</h1>
      <p class="mt-5 text-lg text-ink-2">Der Ernährungsplan hat jetzt 14 Tage, Einkaufslisten für beide Wochen, Rezeptkarten und Vorlieben zum Anklicken. Dein Plan mit denselben Angaben steht hier:</p>
      <p class="mt-8 print:hidden"><a href={`/ernaehrungsplan/plan/${weiter}/`} class="btn-primary">Zum neuen Plan</a></p>
      <p class="mt-8 hidden text-lg text-ink print:block">Zum neuen Plan: <a class="ep-alt-url" href={`${site.url}/ernaehrungsplan/plan/${weiter}/`}></a></p>
    </div>
    <script is:inline define:vars={{ ziel: `/ernaehrungsplan/plan/${weiter}/` }}>if (!/[?&]druck\b/.test(location.search)) location.replace(ziel + location.search);</script>
  </Base>
) : (
  <Base title={`Dein Ernährungsplan: ${ernaehrung.label}, ${gewichtLabel[plan.gewicht]}`} description="14 Tage mit Mengen, Protein je Mahlzeit, Einkaufslisten, Austauschtabelle und Rezeptkarten für die Zeit nach der Abnehmspritze." path={path} noindex>
    <script is:inline>if (/[?&][vs]=[^&]/.test(location.search)) document.documentElement.classList.add('ep-v');if (/[?&]druck=handy\b/.test(location.search)) document.documentElement.classList.add('ed-handy');if (/[?&]pdf=1(&|$)/.test(location.search)) document.documentElement.classList.add('ep-pdf1');</script>
    <article class="ep-plan" data-ep-plan data-id={plan.id} data-fn-bls={fn('bls')}>
      <div class="ep-leiste no-print" data-ep-leiste>
        <div class="ep-leiste-in">
          <p class="ep-leiste-text">Dein Plan, wie er gerade ist</p>
          <button type="button" class="btn-primary ep-leiste-knopf" data-ep-senden aria-haspopup="dialog">Als PDF senden</button>
          <button type="button" class="btn-secondary ep-leiste-knopf" data-ep-laden>PDF herunterladen</button>
        </div>
      </div>
      <div class="ep-wrap">
        <div class="ep-dein-pdf no-print" data-ep-dein-pdf>
          <p class="ep-dein-pdf-h">Dein PDF</p>
          <p class="ep-klein">Mit allen Gerichten aus deinem Link. Es entsteht hier in deinem Browser, in ein paar Sekunden.</p>
          <div class="ep-dein-pdf-zeile">
            <button type="button" class="btn-primary" data-ep-laden>PDF herunterladen</button>
            <div class="pi-schalter" role="group" aria-label="Format des PDFs" data-ep-format data-an="0"><button type="button" data-format="a4" aria-pressed="true">A4</button><button type="button" data-format="handy" aria-pressed="false">Handy</button><i aria-hidden="true"></i></div>
          </div>
        </div>
        <p class="ep-marke">Nach der Spritze · Ernährungsplan · Stand {stand}</p>
        <h1 class="ep-h1">Dein Ernährungsplan für 14 Tage</h1>
        <p class="ep-lead">Mahlzeiten mit Mengen und Protein, zwei Einkaufslisten, eine Tabelle zum Tauschen und Rezeptkarten. Ausgewählt nach deinen Angaben.</p>

        <dl class="ep-profil">
          <div><dt>Ernährung</dt><dd>{ernaehrung.label}{plan.laktosefrei && plan.ernaehrung !== 'vegan' ? ', laktosefrei' : ''}</dd></div>
          <div><dt>Appetit</dt><dd>{appetit.label}</dd></div>
          <div><dt>Gewicht</dt><dd>{gewichtLabel[plan.gewicht]}</dd></div>
          <div><dt>Vorlieben</dt><dd data-ep-v-text>keine angegeben</dd></div>
          <div class="ep-profil-ziel"><dt>Protein pro Tag</dt><dd><span class="ep-zahl">{plan.ziel}</span> g</dd></div>
        </dl>
        <script is:inline define:vars={{ vLabels }}>var m = /[?&]v=([^&#]*)/.exec(location.search); var w = m ? decodeURIComponent(m[1]).toLowerCase().split(/[\s,;+]+/) : []; var t = vLabels.filter(function (x) { return w.indexOf(x[0]) >= 0; }).map(function (x) { return x[1]; }); if (t.length) document.querySelector('[data-ep-v-text]').textContent = t.join(', ');</script>

        <div class="ep-werkzeug no-print">
          <div class="ep-aktionen ep-ohne-js">
            <a class="btn-primary plausible-event-name=Ernaehrungsplan+PDF plausible-event-format=handy" href={pdfHandy}>PDF fürs Handy</a>
            <a class="btn-secondary plausible-event-name=Ernaehrungsplan+PDF plausible-event-format=a4" href={pdf}>PDF zum Drucken (A4)</a>
          </div>
          <div class="ep-format ep-mit-js">
            <div class="ep-format-zeile"><span class="ep-format-l" id="ep-format-l">Format des PDFs</span><div class="pi-schalter" role="group" aria-labelledby="ep-format-l" data-ep-format data-an="0"><button type="button" data-format="a4" aria-pressed="true">A4</button><button type="button" data-format="handy" aria-pressed="false">Handy</button><i aria-hidden="true"></i></div></div>
            <script is:inline>(function () { var h = matchMedia('(max-width: 699px), (pointer: coarse)').matches; document.querySelectorAll('[data-ep-format]').forEach(function (s) { s.dataset.an = h ? '1' : '0'; s.querySelectorAll('button').forEach(function (b, i) { b.setAttribute('aria-pressed', String((i === 1) === h)); }); }); })();</script>
            <p class="ep-klein ep-pdf-status" role="status" data-ep-pdf-status></p>
            <p class="ep-klein ep-pdf-rueckfall">„PDF herunterladen“ erstellt das PDF in deinem Browser, mit allen Änderungen; dabei wird nichts übertragen. „Als PDF senden“ schickt dir den Link auf diesen Plan und das PDF per Mail. Fertige PDFs des Grundplans ohne deine Änderungen: <a class="plausible-event-name=Ernaehrungsplan+PDF plausible-event-format=handy" href={pdfHandy}>fürs Handy</a> · <a class="plausible-event-name=Ernaehrungsplan+PDF plausible-event-format=a4" href={pdf}>A4</a></p>
          </div>
          <details class="ep-anpassen" data-ep-anpassen>
            <summary><span>Plan anpassen</span><span class="ep-klein">Ernährung, Gewicht, Laktose, Vorlieben</span></summary>
            <form class="ep-optionen" data-ep-varianten>
              <fieldset>
                <legend><span>Ernährung</span></legend>
                <div class="ep-wahl">
                  {ernaehrungOptionen.map((o) => (<label><input type="radio" name="e" value={o.value} checked={o.value === plan.ernaehrung} /><span>{o.label}</span></label>))}
                </div>
              </fieldset>
              <fieldset>
                <legend><span>Gewicht</span></legend>
                <div class="ep-wahl">
                  {gewichte.map((g) => (<label><input type="radio" name="g" value={g} checked={g === plan.gewicht} /><span>{gewichtLabel[g]}</span></label>))}
                </div>
              </fieldset>
              <fieldset>
                <legend><span>Laktose</span></legend>
                <div class="ep-wahl">
                  <label><input type="checkbox" name="lf" value="ja" checked={plan.laktosefrei} disabled={plan.ernaehrung === 'vegan'} /><span>laktosefrei</span></label>
                </div>
              </fieldset>
            </form>
            <fieldset class="ep-vorlieben" data-ep-vorlieben>
              <legend>Vorlieben <span class="ep-klein">Gerichte damit kommen öfter vor</span></legend>
              <div class="ep-vorlieben-raster">
                {VORLIEBEN.filter((v) => erlaubt.has(v.key)).map((v) => (
                  <label><input type="checkbox" value={v.key} /><span>{vorliebeLabel(v.key, plan.laktosefrei)}</span></label>
                ))}
              </div>
            </fieldset>
            <p class="ep-klein ep-anpassen-hinweis">Ernährung, Gewicht und Laktose öffnen den passenden Plan; deine Änderungen kommen mit, soweit sie passen. Den Appetit stellst du unten bei „Tag für Tag“ um. Vorlieben tauschen Gerichte direkt auf dieser Seite. Die Adresse merkt sich alles; speichere sie als Lesezeichen.</p>
          </details>
        </div>

        <div class="ep-dyn" data-ep-dyn-blick set:html={blickHtml(plan)} />

        <div class="ep-tagfuertag" id="tag-fuer-tag">
          <div class="ep-dyn" data-ep-dyn set:html={wochenHtml(plan)} />
          <div class="pi-mount" data-pi hidden></div>
        </div>
        <div data-ep-rezepte set:html={rezepteHtml(plan)} />

        <div class="ep-hinweise">
          <h2 class="ep-h2">So funktioniert der Plan</h2>
          <div class="prose-site">
            <ul>
              <li><strong>Protein zuerst.</strong> Übersichtsarbeiten empfehlen während Gewichtsabnahme und Gewichtserhalt 1,2 bis 1,6 g Protein pro kg Körpergewicht und Tag.<Fn n={fn('leidy2015')} id="leidy2015" /> Dein Plan rechnet mit dem unteren Wert: {String(G_PRO_KG).replace('.', ',')} g × {plan.referenzKg} kg (Mitte deiner Gewichtsstufe{plan.gewicht === 'ueber100' ? '; wer deutlich mehr wiegt, rechnet mit dem Proteinrechner nach' : ''}) = rund {plan.ziel} g am Tag. Iss bei jeder Mahlzeit zuerst die Proteinquelle, dann Gemüse, dann den Rest.</li>
              {klein && (<li><strong>Kleine Portionen sind Absicht.</strong> Frühstück, Mittag und Abend sind kleiner als üblich, dafür gibt es zwei bis vier proteinreiche Zwischenmahlzeiten. Expertenempfehlungen zur Ernährung unter Adipositas-Medikamenten raten zu kleineren, häufigeren Mahlzeiten, langsamem Essen und Aufhören beim ersten Sattsein.<Fn n={fn('almandoz2024')} id="almandoz2024" /> Schaffst du eine Mahlzeit nicht, iss zuerst den Proteinteil. Kommt der Appetit zurück, wechsle oben auf „Wieder normal“.</li>)}
              {!klein && (<li><strong>Satt ist genug.</strong> Die Mengen sind Richtwerte. Wenn du vorher satt bist, lass den Rest der Beilage liegen, nicht das Protein.</li>)}
              {muster && <li><strong>Abwechslung.</strong> {muster} Kein Gericht kommt an zwei Tagen hintereinander.</li>}
              <li><strong>Gemüse und Obst nach Hunger.</strong> Was unter „dazu“ steht, zählt nicht in die Proteinsumme und hat keine feste Menge. Eine Handvoll pro Mahlzeit ist ein guter Anfang.</li>
              <li><strong>Ballaststoffe langsam steigern.</strong> Die DGE empfiehlt mindestens 30 g Ballaststoffe am Tag.<Fn n={fn('dgeBallaststoffe')} id="dgeBallaststoffe" /> Hülsenfrüchte, Haferflocken und Vollkorn im Plan bringen dich dorthin. Wer vorher wenig gegessen hat, steigert über zwei Wochen und trinkt dazu genug.</li>
              <li><strong>Trinken.</strong> Expertenempfehlungen zur Ernährung unter Adipositas-Medikamenten nennen zwei bis drei Liter Flüssigkeit am Tag.<Fn n={fn('almandoz2024')} id="almandoz2024" /> Wasser, Tee und schwarzer Kaffee sind die Getränke, die die DGE als Standard empfiehlt.<Fn n={fn('dgeEmpfehlungen')} id="dgeEmpfehlungen" /></li>
              {plan.laktosefrei && plan.ernaehrung !== 'vegan' && (<li><strong>Laktosefrei.</strong> Milch, Joghurt und Quark gibt es im Supermarkt laktosefrei; Skyr, Hüttenkäse und Feta kommen im Plan nicht vor. Gereifter Hartkäse wie Gouda oder Bergkäse ist von Natur aus praktisch laktosefrei.<Fn n={fn('bls')} id="bls" /></li>)}
              <li><strong>Tauschen ist erlaubt.</strong> Tage dürfen die Reihenfolge wechseln. Proteinquellen tauschst du mit der Tabelle am Ende gegeneinander aus.</li>
            </ul>
            <p>Protein trägt zur Erhaltung von Muskelmasse bei.<Fn n={fn('euClaims')} id="euClaims" /> Der Plan gibt keine Kalorienmenge vor; er steuert Protein, Ballaststoffe und Portionsgröße.</p>
          </div>
        </div>

        <div data-ep-grundlage set:html={grundlageHtml(plan, { fnBls: fn('bls') })} />

        <div class="ep-tausch" id="austauschtabelle">
          <h2 class="ep-h2">Austauschtabelle</h2>
          <p class="ep-klein">Jede Zeile liefert etwa 20 g Protein. Tausche innerhalb einer Mahlzeit gleich viel gegen gleich viel.</p>
          <table>
            <thead><tr><th scope="col">Lebensmittel</th><th scope="col">für etwa 20 g Protein</th><th scope="col">Protein</th></tr></thead>
            <tbody>
              {plan.tausch.map((t) => (<tr><td>{t.name}</td><td class="ep-tausch-menge">{t.menge}</td><td class="ep-tausch-je">{t.je100}</td></tr>))}
            </tbody>
          </table>
        </div>

        <div class="ep-grenzen">
          <h2 class="ep-h2">Was dieser Plan ist und was nicht</h2>
          <p>Ein allgemeiner Beispielplan für gesunde Erwachsene, ausgewählt nach Ernährungsform, Appetit, Gewichtsbereich und Laktose. Er ist keine Ernährungstherapie und ersetzt keine ärztliche oder ernährungstherapeutische Beratung. Nicht geeignet ist er bei Nierenerkrankungen, in Schwangerschaft und Stillzeit, bei einer Essstörung (auch früher) und für unter 18-Jährige. Bei Diabetes, Medikamenten mit Ernährungsvorgaben, Allergien oder Unverträglichkeiten sprich vorher mit deiner Ärztin, deinem Arzt oder einer Ernährungsfachkraft.</p>
          <p class="ep-arzt">{site.doctorSentence}</p>
          <p class="ep-klein">Mehr zu Protein, Ballaststoffen und dem Alltag nach dem Absetzen: nachderspritze.de/wissen/ernaehrung-nach-abnehmspritze/ · Fragen: {site.owner.email}</p>
        </div>

        <Footnotes ids={fnIds} />

        <dialog class="pi-blatt ep-senden-blatt" data-ep-senden-blatt aria-labelledby="ep-senden-h">
          <div class="pi-blatt-in">
            <div class="pi-blatt-kopf">
              <p class="pi-blatt-wo">Plan {plan.id} · {ernaehrung.label}{lf ? ', laktosefrei' : ''} · {gewichtLabel[plan.gewicht]}</p>
              <button type="button" class="pi-zu" data-ep-zu>Schließen</button>
              <h2 class="pi-blatt-name" id="ep-senden-h">Als PDF senden</h2>
            </div>
            <form method="post" action="/api/ernaehrungsplan/" class="ep-senden-form">
              <input type="hidden" name="ernaehrung" value={plan.ernaehrung} />
              <input type="hidden" name="appetit" value={plan.appetit} />
              <input type="hidden" name="gewicht" value={plan.referenzKg} />
              {plan.laktosefrei && <input type="hidden" name="laktosefrei" value="ja" />}
              <input type="hidden" name="vorlieben" value="" />
              <input type="hidden" name="zustand" value="" />
              <p class="ep-senden-intro">Du bekommst eine Mail mit dem Link auf deinen Plan, so wie er jetzt ist, und dem PDF zum Herunterladen. Vorher bestätigst du deine Adresse per Link.</p>
              <label for="ep-senden-email" class="sr-only">E-Mail-Adresse</label>
              <input id="ep-senden-email" class="ep-senden-email" name="email" type="email" autocomplete="email" required placeholder="Deine E-Mail-Adresse" />
              <label class="ep-check">
                <input type="checkbox" name="eignung" value="ja" required />
                <span>Keiner dieser Punkte trifft auf mich zu: Nierenerkrankung, Schwangerschaft oder Stillzeit, Essstörung (auch früher), jünger als 18 Jahre. <span class="ep-check-hell">Trifft einer zu, ist ein allgemeiner Plan nicht das Richtige; sprich dann mit deiner Ärztin, deinem Arzt oder einer Ernährungsfachkraft.</span></span>
              </label>
              <label class="ep-check">
                <input type="checkbox" name="einwilligung" value="ja" required />
                <span>Schickt mir den Plan per Mail und meldet mich für den Newsletter von Nach der Spritze an ({site.newsletter.cadence}: neue Artikel und Studien zur Zeit nach der Abnehmspritze, gelegentlich Neuigkeiten zum Programm). Ich willige ausdrücklich ein, dass ihr dafür meine Plannummer und die Auswahl meiner Gerichte speichert; die Plannummer steht für meine Angaben zu Ernährungsform, Gewichtsbereich, Appetit und Laktose. Der Plan kommt, sobald ich die Anmeldung per Link bestätigt habe. Abmelden geht in jeder Mail. Details in der <a href="/datenschutz/#ernaehrungsplan">Datenschutzerklärung</a>.</span>
              </label>
              <label class="ep-check">
                <input type="checkbox" name="warteliste" value="ja" />
                <span>Auch auf die Warteliste für das 12-Wochen-Programm: Ihr schreibt mir zu Start, Preis und Ablauf. Freiwillig, abmelden geht in jeder Mail.</span>
              </label>
              <div class="hidden" aria-hidden="true">
                <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
              </div>
              <p class="ep-klein ep-zu-lang" data-ep-zu-lang hidden>Du hast sehr viel geändert. Der Link in der Mail zeigt deinen Plan mit deinen Vorlieben, aber nicht alle Änderungen. Lade das PDF deshalb am besten auch hier herunter: <button type="button" class="pi-text-knopf" data-ep-laden>PDF herunterladen</button></p>
              <button type="submit" class="btn-primary ep-senden-los">Plan senden</button>
              <p class="ep-klein ep-senden-mikro">Kostenlos. Keine Weitergabe deiner Adresse. Gespeichert werden Adresse, Plannummer, Vorlieben und die Auswahl deiner Gerichte, nicht dein genaues Gewicht.</p>
              <p class="ep-klein ep-senden-ohne">Lieber ohne Newsletter? Schreib mir eine Mail an <a data-ep-ohne href={`mailto:${site.owner.email}?subject=${encodeURIComponent('Ernährungsplan ohne Newsletter')}&body=${encodeURIComponent(`Hallo Dominik,\n\nich hätte gern meinen Ernährungsplan per Mail, aber ohne Newsletter.\n\nPlan: ${plan.id}\n`)}`}>{site.owner.email}</a>; Plannummer und Link auf deinen Plan stehen schon drin. Dominik</p>
            </form>
          </div>
        </dialog>
      </div>

      <div class="ed" data-ep-druck data-stand={stand}>
        <div data-ep-druck-dyn set:html={druckHtml(plan, { stand })} />
        <div class="ed-schluss">
          <div class="ed-kopf"><h2 class="ed-h">Hinweise</h2></div>
          <ul class="ed-hinweise">
            <li><strong>So entsteht dein Ziel.</strong> Übersichtsarbeiten empfehlen während Gewichtsabnahme und Gewichtserhalt 1,2 bis 1,6 g Protein pro kg Körpergewicht und Tag.<sup>{fn('leidy2015')}</sup> Dein Plan rechnet mit dem unteren Wert: {String(G_PRO_KG).replace('.', ',')} g × {plan.referenzKg} kg (Mitte deiner Gewichtsstufe{plan.gewicht === 'ueber100' ? '; wer deutlich mehr wiegt, rechnet mit dem Proteinrechner auf nachderspritze.de nach' : ''}) = rund {plan.ziel} g am Tag.</li>
            {klein && (<li><strong>Kleine Portionen sind Absicht.</strong> Expertenempfehlungen zur Ernährung unter Adipositas-Medikamenten raten zu kleineren, häufigeren Mahlzeiten, langsamem Essen und Aufhören beim ersten Sattsein.<sup>{fn('almandoz2024')}</sup> Kommt der Appetit zurück, wechsle auf deiner Planseite auf „Wieder normal“.</li>)}
            {!klein && (<li><strong>Satt ist genug.</strong> Die Mengen sind Richtwerte. Wenn du vorher satt bist, lass den Rest der Beilage liegen, nicht das Protein.</li>)}
            {muster && <li><strong>Abwechslung.</strong> {muster} Kein Gericht kommt an zwei Tagen hintereinander.</li>}
            <li><strong>Gemüse und Obst nach Hunger.</strong> Was unter „dazu“ steht, zählt nicht in die Proteinsumme und hat keine feste Menge. Eine Handvoll pro Mahlzeit ist ein guter Anfang.</li>
            <li><strong>Ballaststoffe langsam steigern.</strong> Die DGE empfiehlt mindestens 30 g Ballaststoffe am Tag.<sup>{fn('dgeBallaststoffe')}</sup> Hülsenfrüchte, Haferflocken und Vollkorn im Plan bringen dich dorthin. Wer vorher wenig gegessen hat, steigert über zwei Wochen und trinkt dazu genug.</li>
            <li><strong>Trinken.</strong> Expertenempfehlungen zur Ernährung unter Adipositas-Medikamenten nennen zwei bis drei Liter Flüssigkeit am Tag.<sup>{fn('almandoz2024')}</sup> Wasser, Tee und schwarzer Kaffee sind die Getränke, die die DGE als Standard empfiehlt.<sup>{fn('dgeEmpfehlungen')}</sup></li>
            {lf && (<li><strong>Laktosefrei.</strong> Milch, Joghurt und Quark gibt es im Supermarkt laktosefrei; Skyr, Hüttenkäse und Feta kommen im Plan nicht vor. Gereifter Hartkäse wie Gouda oder Bergkäse ist von Natur aus praktisch laktosefrei.<sup>{fn('bls')}</sup></li>)}
            <li><strong>So sind die Mengen gerechnet.</strong> Jedes Gericht hat ein Grundrezept für eine normale Portion; ein Faktor je Tag passt Frühstück, Mittag und Abend an, Zwischenmahlzeiten haben eine feste Portion. Protein je Zutat: gerundete Durchschnittswerte aus dem Bundeslebensmittelschlüssel,<sup>{fn('bls')}</sup> Proteinpulver und Räuchertofu nach typischen Herstellerangaben. Die Werte je Zutat stehen auf deiner Planseite.</li>
            <li><strong>Protein und Muskeln.</strong> Protein trägt zur Erhaltung von Muskelmasse bei.<sup>{fn('euClaims')}</sup> Der Plan gibt keine Kalorienmenge vor; er steuert Protein, Ballaststoffe und Portionsgröße.</li>
          </ul>
          <div class="ed-grenzen">
            <p><strong>Was dieser Plan ist und was nicht.</strong> Ein allgemeiner Beispielplan für gesunde Erwachsene, ausgewählt nach Ernährungsform, Appetit, Gewichtsbereich und Laktose. Er ist keine Ernährungstherapie und ersetzt keine ärztliche oder ernährungstherapeutische Beratung. Nicht geeignet ist er bei Nierenerkrankungen, in Schwangerschaft und Stillzeit, bei einer Essstörung (auch früher) und für unter 18-Jährige. Bei Diabetes, Medikamenten mit Ernährungsvorgaben, Allergien oder Unverträglichkeiten sprich vorher mit deiner Ärztin, deinem Arzt oder einer Ernährungsfachkraft.</p>
            <p class="ed-arzt">{site.doctorSentence}</p>
            <p>Nach der Spritze, ein Projekt von {site.owner.name}, {site.owner.city}. Mehr zu Protein, Ballaststoffen und dem Alltag nach dem Absetzen: nachderspritze.de/wissen/ernaehrung-nach-abnehmspritze/ · Fragen: {site.owner.email}</p>
          </div>
          <div class="ed-quellen">
            <p class="ed-label">Quellen</p>
            {/* Klassen wie die Quellenliste in Footnotes.astro: Die Textprüfung überspringt Literaturangaben daran */}
            <ol class="mt-3 space-y-2 ed-quellen-liste">
              {quellen.map((q, i) => (<li><span>{i + 1}</span><span>{q.full}{q.url && (<> <a class="ed-url" href={q.url}></a></>)}</span></li>))}
            </ol>
          </div>
        </div>
      </div>
    </article>
  </Base>
)}


---
/**
 * Newsletter im Kopf, ruhig als Textknopf mit ausklappbarem Feld: Anmeldung (eigenes Formular, POST an /api/anmeldung/,
 * quelle=header, Double-Opt-in über MailerLite, keine Skripte Dritter) und Kontaktangebot. Texte: keine Superlative,
 * keine Expertenversprechen, kein Arztbezug, keine medizinische Beratung; der Pflichtsatz steht dabei.
 * Wortlaut der Einwilligung wie in docs/NEWSLETTER.md. Unter 1024 px öffnet das Menü das Feld (Header.astro).
 */
import { site } from '../data/site';
const subject = encodeURIComponent('Nach der Spritze: meine Frage');
---
<details id="newsletter-panel" class="nlp">
  <summary class="nlp-sum plausible-event-name=Newsletter+Klick" aria-controls="newsletter-inhalt">Newsletter</summary>
  <div id="newsletter-inhalt" class="nlp-box">
    <p class="eyebrow">Newsletter</p>
    <p class="nlp-h">Die Zeit nach der Spritze, {site.newsletter.cadence} eingeordnet.</p>
    <p class="nlp-t">Neue Artikel, Studien und Entwicklungen, kurz und mit Quellen. Die erste Ausgabe kommt, sobald sie fertig ist.</p>
    <form method="post" action="/api/anmeldung/" class="nlp-form plausible-event-name=Newsletter+Eintragen plausible-event-position=header">
      <label for="nl-email" class="sr-only">E-Mail-Adresse</label>
      <input id="nl-email" name="email" type="email" required autocomplete="email" placeholder="Deine E-Mail-Adresse" />
      <div class="hidden" aria-hidden="true"><label for="nl-website">Website</label><input id="nl-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
      <input type="hidden" name="quelle" value="header" />
      <label class="nlp-check">
        <input type="checkbox" name="einwilligung" value="ja" required />
        <span>Ja, schickt mir {site.newsletter.cadence} den Newsletter von Nach der Spritze. Abmelden geht in jeder Mail. <a href="/datenschutz/">Datenschutz</a></span>
      </label>
      <button type="submit" class="btn-primary nlp-btn">Eintragen</button>
      <p class="nlp-micro">Du bekommst zuerst eine Bestätigungs-Mail. Erst nach dem Klick auf den Link bist du angemeldet.</p>
    </form>
    <div class="nlp-kontakt">
      <p class="nlp-k">Du strauchelst gerade nach dem Absetzen?</p>
      <p class="nlp-t">Schreib uns, was dir fehlt: <a href={`mailto:${site.owner.email}?subject=${subject}`} class="plausible-event-name=Kontakt+Klick plausible-event-kanal=newsletter">{site.owner.email}</a>. Wir antworten persönlich. Orientierung und Zuhören, keine medizinische Beratung.</p>
      <p class="nlp-micro">{site.doctorSentence}</p>
    </div>
  </div>
</details>

<style>
  .nlp-sum {
    list-style: none;
    display: none;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-ink-2);
    cursor: pointer;
    white-space: nowrap;
  }
  .nlp-sum::-webkit-details-marker {
    display: none;
  }
  .nlp-sum:hover, .nlp[open] .nlp-sum {
    color: var(--color-ink);
  }
  .nlp-box {
    position: absolute;
    left: var(--pad);
    right: var(--pad);
    top: calc(100% + 0.5rem);
    z-index: 50;
    max-height: calc(100svh - 6rem);
    overflow-y: auto;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl2);
    padding: 1.5rem;
  }
  .nlp-h {
    margin-top: 0.4rem;
    font-size: 1.25rem;
    line-height: 1.25;
    font-stretch: 112%;
    font-weight: 520;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .nlp-t {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-ink-2);
  }
  .nlp-t a, .nlp-check a {
    color: var(--color-moss);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .nlp-form {
    margin-top: 1rem;
    display: grid;
    gap: 0.75rem;
  }
  .nlp-form input[type="email"] {
    width: 100%;
    height: 3rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background: #fff;
    color: var(--color-ink);
    font: inherit;
    font-size: 1rem;
    padding: 0 1.25rem;
  }
  .nlp-form input[type="email"]::placeholder {
    color: var(--color-ink-3);
  }
  .nlp-check {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-ink-2);
  }
  .nlp-check input {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.1rem;
  }
  .nlp-btn {
    width: 100%;
  }
  .nlp-micro {
    font-size: 0.8125rem;
    color: var(--color-ink-3);
    margin-top: 0.25rem;
  }
  .nlp-kontakt {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }
  .nlp-k {
    font-size: 0.9375rem;
    font-weight: 560;
    color: var(--color-ink);
  }
  @media (min-width: 1024px) {
    .nlp {
      position: relative;
    }
    .nlp-sum {
      display: inline-flex;
    }
    .nlp-box {
      left: auto;
      right: 0;
      width: 26rem;
    }
  }
</style>

<script is:inline>
  (function () {
    var d = document.getElementById('newsletter-panel');
    if (!d) return;
    document.addEventListener('click', function (e) { if (d.open && !d.contains(e.target)) d.open = false; });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && d.open) d.open = false; });
  })();
</script>

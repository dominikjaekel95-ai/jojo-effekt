---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';
import { themen, gehoertZu } from '../../data/themen';

const artikel = (await getCollection('wissen', (a) => !a.data.draft)).sort((a, b) => a.data.order - b.data.order);
const glossarCount = (await getCollection('glossar', (g) => !g.data.draft)).length;
// Gliederung nach Themen (Hubs): jeder Artikel erscheint unter seiner Kategorie; die Themenseite listet zusätzlich `include`
const gruppen = themen.map((t) => ({ thema: t, artikel: artikel.filter((a) => a.data.category === t.category) }));
const ohneThema = artikel.filter((a) => !themen.some((t) => t.category === a.data.category));
if (ohneThema.length > 0) throw new Error(`Artikel ohne Thema in src/data/themen.json: ${ohneThema.map((a) => a.id).join(', ')}`);
// Präparate-Artikel als Linkzeile mit Anker; die Startseite verlinkt hierher, weil dort keine Markennamen stehen
const praeparateThema = themen.find((t) => t.slug === 'praeparate');
const praeparate = praeparateThema ? artikel.filter((a) => gehoertZu(praeparateThema, a.id, a.data.category)) : [];
const title = 'Wissen: Abnehmspritze absetzen, Jojo-Effekt, Muskeln erhalten';
const description =
  'Was nach der Abnehmspritze passiert und was nachweislich hilft: Jojo-Effekt, Absetzen, Muskelabbau, Protein, Kreatin und ein 12-Wochen-Plan. Jede Zahl mit Link zur Originalstudie.';
const jsonLd = [
  {
    '@type': 'CollectionPage',
    name: title,
    description,
    url: `${site.url}/wissen/`,
    isPartOf: { '@id': `${site.url}/#website` },
    hasPart: [
      ...themen.map((t) => ({ '@type': 'CollectionPage', name: t.title, url: `${site.url}/wissen/${t.slug}/` })),
      ...artikel.map((a) => ({ '@type': 'Article', headline: a.data.title, url: `${site.url}/wissen/${a.id}/` })),
    ],
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Wissen', item: `${site.url}/wissen/` },
    ],
  },
];
const chip = 'inline-block rounded-lg border border-line bg-white px-3 py-1.5 text-sm font-semibold text-ink no-underline hover:border-moss hover:text-moss';
---
<Base title={title} description={description} path="/wissen/" jsonLd={jsonLd}>
  <section class="container-wide py-14">
    <nav aria-label="Brotkrumen" class="text-sm text-ink-3"><a href="/" class="hover:text-moss">Start</a> › Wissen</nav>
    <p class="eyebrow mt-6">Wissen</p>
    <h1 class="h1 mt-3">Nach der Abnehmspritze: die Fakten, mit Quellen</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-2">
      Was in Studien passiert, wenn die Spritze wegfällt, und was nachweislich hilft. Jede Zahl mit Link zur
      Originalstudie, Quellen unter jedem Artikel, kein Verkaufston. Und immer: Ob und wie du dein Medikament absetzt,
      besprichst du mit deiner Ärztin oder deinem Arzt.
    </p>
    <figure class="mt-8">
      <a href="/wissen/abnehmspritze-absetzen/" class="block"><img src="/grafiken/zeitachse-nach-letzter-dosis.png" alt="Zeitachse über 20 Wochen nach der letzten Dosis einer Abnehmspritze: Der Wirkstoff ist nach etwa fünf bis sieben Wochen weitgehend abgebaut, der Appetit kehrt ab Woche 2 bis 5 zurück, die Gewichtszunahme ist ab Woche 8 messbar und steigt bis etwa Woche 20. Ein Kontrolltermin 8 bis 12 Wochen nach der letzten Dosis ist markiert." width="1200" height="675" loading="eager" class="w-full rounded-xl2 border border-line bg-white" /></a>
      <figcaption class="mt-2 text-sm text-ink-3">Die ersten 20 Wochen nach der letzten Dosis; Woche für Woche erklärt unter <a href="/wissen/abnehmspritze-absetzen/" class="font-semibold text-moss underline underline-offset-4">Abnehmspritze absetzen</a>. Alle Grafiken mit Quellen und Download: <a href="/grafiken/" class="font-semibold text-moss underline underline-offset-4">Grafiken</a>.</figcaption>
    </figure>
    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Themen">
      {themen.map((t) => (<li><a href={`/wissen/${t.slug}/`} class={chip}>{t.name}</a></li>))}
    </ul>
    <a href="/wissen/studien/" class="card mt-10 block border-amber/50 bg-amber-light/40 no-underline hover:border-amber">
      <p class="eyebrow text-amber-dark">Studien-Tracker</p>
      <h2 class="mt-2 text-2xl leading-snug text-ink">Alle Studien zum Absetzen der Abnehmspritze in einer Tabelle</h2>
      <p class="mt-2 text-ink-2">Zulassungsstudien, Absetz-Phasen, Meta-Analysen und Mechanismen mit je einer Kernzahl und Link zum Original. Monatlich aktualisiert.</p>
      <p class="mt-4 text-sm font-semibold text-amber-dark">Zur Tabelle →</p>
    </a>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <a href="/glossar/" class="card group block no-underline hover:border-moss">
        <p class="eyebrow">Glossar</p>
        <h2 class="mt-2 text-xl leading-snug text-ink group-hover:text-moss">Begriffe zur Zeit nach der Abnehmspritze</h2>
        <p class="mt-2 text-sm text-ink-2">Haltephase, Absetzkurve, fettfreie Masse, Halbwertszeit: {glossarCount} Definitionen in je einem Satz, mit Quelle und Link zum passenden Artikel.</p>
        <p class="mt-4 text-sm font-semibold text-moss">Zum Glossar →</p>
      </a>
      <a href="/marktradar/" class="card group block no-underline hover:border-moss">
        <p class="eyebrow">Marktradar</p>
        <h2 class="mt-2 text-xl leading-snug text-ink group-hover:text-moss">Was sich bei Spritze und Tablette gerade ändert</h2>
        <p class="mt-2 text-sm text-ink-2">Zulassungen, Marktstarts, Preise als Größenordnung, Kassenregeln und Lieferbarkeit, mit Datum und Quelle. Lieferbarkeit wird automatisch abgerufen.</p>
        <p class="mt-4 text-sm font-semibold text-moss">Zum Marktradar →</p>
      </a>
    </div>

    {gruppen.map(({ thema, artikel: liste }) => (
      <section id={thema.slug === 'praeparate' ? 'praeparate' : `thema-${thema.slug}`} class="mt-12 scroll-mt-24" aria-labelledby={`h-${thema.slug}`}>
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="eyebrow">{thema.name}</p>
            <h2 id={`h-${thema.slug}`} class="mt-1 text-2xl leading-snug text-ink"><a href={`/wissen/${thema.slug}/`} class="no-underline hover:text-moss">{thema.title}</a></h2>
          </div>
          <a href={`/wissen/${thema.slug}/`} class="text-sm font-semibold text-moss underline underline-offset-4">Themenseite mit Einordnung →</a>
        </div>
        {thema.slug === 'praeparate' && praeparate.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2" aria-label="Absetzen nach Präparat">
            {praeparate.map((a) => (<li><a href={`/wissen/${a.id}/`} class={chip}>{a.data.title.split(':')[0]}</a></li>))}
          </ul>
        )}
        <div class="mt-4 grid gap-6 md:grid-cols-2">
          {liste.map((a) => (
            <a href={`/wissen/${a.id}/`} class="card group block no-underline hover:border-moss">
              <p class="text-sm font-medium text-ink-3">{a.data.category}</p>
              <h3 class="mt-2 text-2xl leading-snug text-ink group-hover:text-moss">{a.data.title}</h3>
              <p class="mt-2 text-ink-2">{a.data.description}</p>
              <p class="mt-4 text-sm font-semibold text-moss">Lesen →</p>
            </a>
          ))}
        </div>
      </section>
    ))}

    <div class="mt-14 rounded-xl2 border border-line bg-white p-6">
      <p class="eyebrow">Warum es diese Seite gibt</p>
      <p class="mt-2 max-w-2xl text-ink-2">
        Wir entwickeln ein 12-Wochen-Set für die Zeit nach der Abnehmspritze. Beim Recherchieren haben wir gemerkt: Die
        wichtigsten Informationen zum Absetzen sind über Studien, Nachrichtenmeldungen und Anbieter-Blogs verstreut, und
        oft widersprechen sie sich. Dieser Bereich fasst zusammen, was belegt ist. Das Set ist ein Lebensmittel mit Programm,
        kein Medikament, und es verhindert den Jojo-Effekt nicht.
      </p>
      <div class="mt-4"><Cta position="wissen-hub" label="Zum 12-Wochen-Set" secondary /></div>
    </div>
  </section>
</Base>
